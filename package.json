{
	"name": "kodilo",
	"type": "module",
	"version": "0.0.1",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"astro": "astro",
		"check": "astro check",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "playwright test --project=desktop --project=mobile --project=dark",
		"test:changed": "node scripts/test-changed.mjs",
		"test:install": "playwright install --with-deps chromium",
		"brand": "node scripts/build-brand.mjs && node scripts/build-icons.mjs",
		"prebuild": "node scripts/build-oui.mjs",
		"predev": "node scripts/build-oui.mjs",
		"budget": "node scripts/check-budget.mjs",
		"test:a11y": "playwright test --project=a11y --project=a11y-dark --workers=2",
		"readme": "node scripts/build-readme.mjs"
	},
	"dependencies": {
		"@astrojs/sitemap": "^3.7.4",
		"@faker-js/faker": "^10.6.0",
		"@peculiar/x509": "^2.1.0",
		"@prettier/plugin-php": "^0.25.0",
		"@scure/bip39": "^2.4.0",
		"ajv": "^8.20.0",
		"astro": "^7.3.4",
		"bcryptjs": "^3.0.3",
		"exifr": "^7.1.3",
		"fflate": "^0.8.3",
		"figlet": "^1.11.4",
		"graphql": "^17.0.2",
		"html-to-image": "^1.11.13",
		"jose": "^6.2.12",
		"jsonpath-plus": "^11.0.0",
		"jsqr": "^1.4.0",
		"libphonenumber-js": "^1.13.14",
		"lucide-static": "^1.47.0",
		"mermaid": "^12.0.0",
		"otpauth": "^9.5.2",
		"papaparse": "^5.7.0",
		"pdf-lib": "^1.17.1",
		"pdfjs-dist": "^6.3.289",
		"protobufjs": "^8.8.0",
		"qrcode": "^1.5.4",
		"reflect-metadata": "^0.2.2",
		"smol-toml": "^1.9.0",
		"svgo": "^4.1.0",
		"terser": "^5.51.2",
		"turndown": "^7.2.4",
		"yaml": "^2.9.1"
	},
	"allowScripts": {
		"esbuild": true
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@axe-core/playwright": "^4.13.0",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.63.0",
		"@types/papaparse": "^5.5.2",
		"@types/qrcode": "^1.5.6",
		"@types/turndown": "^5.0.6",
		"eslint": "^10.11.0",
		"eslint-plugin-astro": "^3.2.1",
		"globals": "^17.12.0",
		"oui-data": "^2.1.28",
		"prettier": "^3.9.9",
		"prettier-plugin-astro": "^1.0.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.1"
	},
	"overrides": {
		"lodash-es": "^4.18.1"
	}
}
