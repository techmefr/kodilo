---
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import ShareButton from './ShareButton.astro';
import { icon } from '../scripts/icons';
import { bugReportUrl, toolCrumbs, toolJsonLd } from '../scripts/seo';

interface Props {
	slug: string;
	title: string;
	description: string;
}

const { slug, title, description } = Astro.props;
const crumbs = toolCrumbs(slug, title);
const jsonLd = toolJsonLd(Astro.site, slug, title, description);
const reportUrl = bugReportUrl(Astro.site, slug, title);
---

<Base title={`${title} — kodilo`} description={description} jsonLd={jsonLd}>
	<div class="shell">
		<Header activeSlug={slug} />
		<main class="tool" id="main" tabindex="-1">
			<Breadcrumbs crumbs={crumbs} />
			<header class="tool-head">
				<div class="tool-title">
					<h1>{title}</h1>
					<button type="button" class="btn pin-btn" id="pin-tool" data-slug={slug} aria-pressed="false" aria-keyshortcuts="f" title="Pin this tool (f)">
						<span class="pin-icon" set:html={icon('star')} />
						<span class="pin-label">Pin</span>
					</button>
				</div>
				<p>{description}</p>
				<ShareButton />
			</header>
			<slot />
			<p class="tool-report">
				<a href={reportUrl} target="_blank" rel="noopener">
					Report a problem with this tool
				</a>
			</p>
		</main>
	</div>
</Base>

<style>
	.shell {
		display: flex;
		min-height: 100vh;
	}
	@media (max-width: 760px) {
		.shell {
			display: block;
		}
	}
	.tool {
		flex: 1;
		min-width: 0;
		max-width: 960px;
		margin: 0 auto;
		padding: 32px 24px 48px;
		display: flex;
		flex-direction: column;
		gap: 20px;
	}
	.tool-title {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
	}
	.tool-head h1 {
		margin: 0;
		font-size: 26px;
		font-weight: 800;
		letter-spacing: -0.02em;
	}
	.tool-head p {
		margin: 4px 0 0;
		color: var(--ink-soft);
		font-size: 14px;
	}
	.tool-report {
		margin: 12px 0 0;
		font-size: 13px;
	}
	.tool-report a {
		color: var(--ink-soft);
	}
	.tool-report a:hover,
	.tool-report a:focus-visible {
		color: var(--accent-strong);
	}
	.pin-btn {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		flex: none;
	}
	.pin-icon {
		display: flex;
	}
	.pin-icon :global(svg) {
		width: 15px;
		height: 15px;
	}
	.pin-btn[aria-pressed='true'] {
		border-color: var(--accent-strong);
		background: var(--accent);
	}
	.pin-btn[aria-pressed='true'] :global(svg) {
		fill: currentColor;
		color: var(--accent-strong);
	}
</style>
