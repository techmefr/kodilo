---
import { builtCategories as categories } from '../data/tools';
import { icon } from '../scripts/icons';

interface Props {
	activeSlug?: string;
}

const { activeSlug } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const index = categories.flatMap((c) => c.tools.map((t) => ({ n: t.name, d: t.description, c: c.name, u: `${base}tools/${t.slug}/` })));
const total = index.length;
---

<div class="mobile-bar">
	<a class="brand" href={base}>kodilo</a>
	<button type="button" class="icon-btn" id="mobile-search" aria-label="Search tools"><span set:html={icon('search')} /></button>
	<button type="button" class="icon-btn" id="nav-open" aria-label="Open menu" aria-expanded="false"><span set:html={icon('menu')} /></button>
</div>

<aside class="site-header" id="site-nav" transition:name="site-nav">
	<div class="brand-row">
		<a class="brand" href={base}>kodilo</a>
		<button type="button" class="icon-btn theme-toggle" id="theme-toggle" aria-label="Toggle theme">
			<span class="icon-sun" set:html={icon('sun')} />
			<span class="icon-moon" set:html={icon('moon')} />
		</button>
	</div>
	<button type="button" class="search-btn" id="search-open" aria-label="Search tools">
		<span set:html={icon('search')} />
		<span class="search-label">Search {total} tools</span>
		<kbd id="search-kbd">⌘K</kbd>
	</button>
	<nav class="cats" aria-label="Tool categories">
		{
			categories.map((c, i) => (
				<button type="button" class="cat-btn" aria-expanded="false" aria-controls={`mega-${i}`} data-active={c.tools.some((t) => t.slug === activeSlug) ? 'true' : undefined}>
					<span class="cat-btn-icon" set:html={icon(c.icon)} />
					<span class="cat-btn-text">
						<b>{c.name}</b>
						<small>{c.blurb}</small>
					</span>
					<span class="cat-count">{c.tools.length}</span>
				</button>
			))
		}
	</nav>
	{
		categories.map((c, i) => (
			<div class="mega" id={`mega-${i}`} hidden>
				<div class="mega-intro">
					<span class="mega-icon" set:html={icon(c.icon)} />
					<div>
						<b>{c.name}</b>
						<p>
							{c.blurb} · {c.tools.length} tool{c.tools.length === 1 ? '' : 's'}
						</p>
					</div>
				</div>
				<ul class="mega-grid">
					{c.tools.map((t) => (
						<li>
							<a href={`${base}tools/${t.slug}/`} aria-current={t.slug === activeSlug ? 'page' : undefined}>
								<i class="t-icon" set:html={icon(t.icon ?? "wrench")} />
								<div class="t-text">
									<b>{t.name}</b>
									<span>{t.description}</span>
								</div>
							</a>
						</li>
					))}
				</ul>
			</div>
		))
	}
</aside>
<div class="mega-scrim" id="mega-scrim" hidden></div>

<dialog class="palette" id="palette" aria-label="Search tools">
	<div class="palette-box">
		<div class="palette-input">
			<span set:html={icon('search')} />
			<input id="palette-q" type="search" placeholder="Search tools, e.g. jwt, base64, cron…" autocomplete="off" spellcheck="false" aria-controls="palette-list" />
			<kbd>Esc</kbd>
		</div>
		<ul class="palette-list" id="palette-list" role="listbox" data-index={JSON.stringify(index)}></ul>
		<div class="palette-foot"><span><kbd>↑</kbd><kbd>↓</kbd> to move</span><span><kbd>↵</kbd> to open</span></div>
	</div>
</dialog>

<script>
	import { navigate } from 'astro:transitions/client';

	type Entry = { n: string; d: string; c: string; u: string };

	const open = () => {
		const dialog = document.getElementById('palette') as HTMLDialogElement | null;
		if (!dialog || dialog.open) return;
		closeMega();
		closeDrawer();
		dialog.showModal();
		const q = document.getElementById('palette-q') as HTMLInputElement;
		q.value = '';
		q.dispatchEvent(new Event('input'));
		q.focus();
	};

	function closeMega() {
		document.querySelectorAll<HTMLElement>('.mega').forEach((m) => (m.hidden = true));
		document.querySelectorAll('.cat-btn').forEach((b) => b.setAttribute('aria-expanded', 'false'));
		const scrim = document.getElementById('mega-scrim');
		if (scrim) scrim.hidden = true;
	}

	function closeDrawer() {
		document.getElementById('site-nav')?.classList.remove('open');
		document.getElementById('nav-open')?.setAttribute('aria-expanded', 'false');
	}

	document.addEventListener('keydown', (e) => {
		if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
			e.preventDefault();
			open();
		} else if (e.key === '/' && !(e.target as HTMLElement).closest('input, textarea, [contenteditable]')) {
			e.preventDefault();
			open();
		} else if (e.key === 'Escape') closeMega();
	});

	function score(entry: Entry, terms: string[]): number {
		const name = entry.n.toLowerCase();
		const hay = `${name} ${entry.d.toLowerCase()} ${entry.c.toLowerCase()}`;
		let s = 0;
		for (const t of terms) {
			if (name.startsWith(t)) s += 10;
			else if (name.split(/[\s/-]+/).some((w) => w.startsWith(t))) s += 6;
			else if (name.includes(t)) s += 4;
			else if (hay.includes(t)) s += 1;
			else {
				let k = 0;
				for (const ch of name) if (ch === t[k]) k++;
				if (k < t.length) return 0;
				s += 0.5;
			}
		}
		return s;
	}

	document.addEventListener('astro:page-load', () => {
		const buttons = [...document.querySelectorAll<HTMLButtonElement>('.cat-btn')];
		const scrim = document.getElementById('mega-scrim')!;
		const hover = () => matchMedia('(hover: hover) and (min-width: 761px)').matches;
		let hoverTimer: number | undefined;
		let moved = false;
		document.addEventListener('pointermove', () => (moved = true), { once: true });
		const show = (btn: HTMLButtonElement, toggle = true) => {
			const panel = document.getElementById(btn.getAttribute('aria-controls')!)!;
			const wasOpen = !panel.hidden;
			closeMega();
			if (wasOpen && toggle) return;
			panel.hidden = false;
			scrim.hidden = false;
			btn.setAttribute('aria-expanded', 'true');
		};
		buttons.forEach((btn) => {
			btn.addEventListener('click', () => show(btn));
			btn.addEventListener('mouseenter', () => {
				if (!moved || !hover()) return;
				clearTimeout(hoverTimer);
				hoverTimer = window.setTimeout(() => show(btn, false), 90);
			});
			btn.addEventListener('mouseleave', () => clearTimeout(hoverTimer));
		});
		document.getElementById('site-nav')!.addEventListener('mouseleave', () => {
			clearTimeout(hoverTimer);
			if (hover()) closeMega();
		});
		scrim.addEventListener('click', closeMega);
		document.querySelectorAll('.mega a').forEach((a) =>
			a.addEventListener('click', () => {
				closeMega();
				closeDrawer();
			})
		);

		const navBtn = document.getElementById('nav-open')!;
		navBtn.addEventListener('click', () => {
			const isOpen = document.getElementById('site-nav')!.classList.toggle('open');
			navBtn.setAttribute('aria-expanded', String(isOpen));
			if (!isOpen) closeMega();
		});
		document.getElementById('mobile-search')!.addEventListener('click', open);

		const isMac = /Mac|iPhone|iPad/.test(navigator.platform);
		document.getElementById('search-kbd')!.textContent = isMac ? '⌘K' : 'Ctrl K';
		document.getElementById('search-open')!.addEventListener('click', open);

		const dialog = document.getElementById('palette') as HTMLDialogElement;
		const q = document.getElementById('palette-q') as HTMLInputElement;
		const list = document.getElementById('palette-list')!;
		const entries: Entry[] = JSON.parse(list.dataset.index!);
		let results: Entry[] = [];
		let active = 0;

		const paint = () => {
			list.querySelectorAll('li').forEach((li, i) => {
				li.setAttribute('aria-selected', String(i === active));
				if (i === active) li.scrollIntoView({ block: 'nearest' });
			});
		};
		const go = (entry?: Entry) => {
			if (!entry) return;
			dialog.close();
			navigate(entry.u);
		};

		q.addEventListener('input', () => {
			const terms = q.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
			results = terms.length
				? entries
						.map((e) => [e, score(e, terms)] as const)
						.filter(([, s]) => s > 0)
						.sort((a, b) => b[1] - a[1] || a[0].n.localeCompare(b[0].n))
						.map(([e]) => e)
						.slice(0, 50)
				: entries;
			active = 0;
			if (!results.length) {
				const li = document.createElement('li');
				li.className = 'palette-empty';
				li.textContent = `No tool matches “${q.value.trim()}”.`;
				list.replaceChildren(li);
				return;
			}
			list.replaceChildren(
				...results.map((e, i) => {
					const li = document.createElement('li');
					li.setAttribute('role', 'option');
					li.innerHTML = '<div><b></b><span></span></div><em></em>';
					li.querySelector('b')!.textContent = e.n;
					li.querySelector('span')!.textContent = e.d;
					li.querySelector('em')!.textContent = e.c;
					li.addEventListener('click', () => go(e));
					li.addEventListener('mousemove', () => {
						if (active !== i) {
							active = i;
							paint();
						}
					});
					return li;
				})
			);
			paint();
		});
		q.addEventListener('keydown', (e) => {
			if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
				e.preventDefault();
				if (!results.length) return;
				active = (active + (e.key === 'ArrowDown' ? 1 : -1) + results.length) % results.length;
				paint();
			} else if (e.key === 'Enter') {
				e.preventDefault();
				go(results[active]);
			}
		});
		dialog.addEventListener('click', (e) => {
			if (e.target === dialog) dialog.close();
		});

		document.getElementById('theme-toggle')!.addEventListener('click', () => {
			const root = document.documentElement;
			const current = root.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
			const next = current === 'dark' ? 'light' : 'dark';
			root.dataset.theme = next;
			try {
				localStorage.setItem('kodilo-theme', next);
			} catch {}
		});
	});
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		width: 232px;
		flex-shrink: 0;
		height: 100vh;
		align-self: flex-start;
		box-sizing: border-box;
		display: flex;
		flex-direction: column;
		gap: 12px;
		padding: 16px 10px;
		background: var(--bg);
		border-right: 1px solid var(--border);
	}
	.brand-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0 6px;
	}
	.brand {
		font-size: 17px;
		font-weight: 800;
		letter-spacing: -0.02em;
		color: var(--accent-strong);
		text-decoration: none;
	}
	.icon-btn {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 30px;
		height: 30px;
		flex-shrink: 0;
		border: 1px solid var(--border);
		border-radius: 8px;
		background: var(--surface);
		color: var(--ink-soft);
		cursor: pointer;
		padding: 0;
	}
	.icon-btn:hover {
		background: var(--surface-2);
	}
	.icon-btn :global(svg) {
		width: 15px;
		height: 15px;
		display: block;
	}
	.icon-moon {
		display: none;
	}
	:root[data-theme='dark'] .theme-toggle .icon-sun {
		display: none;
	}
	:root[data-theme='dark'] .theme-toggle .icon-moon {
		display: flex;
	}
	@media (prefers-color-scheme: dark) {
		:root:not([data-theme='light']) .theme-toggle .icon-sun {
			display: none;
		}
		:root:not([data-theme='light']) .theme-toggle .icon-moon {
			display: flex;
		}
	}
	.search-btn {
		display: flex;
		align-items: center;
		gap: 8px;
		border: 1px solid var(--border);
		background: var(--surface);
		color: var(--ink-soft);
		font: inherit;
		font-size: 13px;
		padding: 7px 8px 7px 10px;
		border-radius: 9px;
		cursor: pointer;
	}
	.search-btn:hover {
		border-color: var(--accent-strong);
	}
	.search-label {
		flex: 1;
		text-align: left;
	}
	.search-btn :global(svg),
	.palette-input :global(svg) {
		width: 15px;
		height: 15px;
		display: block;
	}
	kbd {
		font-family: var(--mono);
		font-size: 11px;
		padding: 1px 6px;
		border: 1px solid var(--border);
		border-bottom-width: 2px;
		border-radius: 5px;
		background: var(--surface-2);
		color: var(--ink-soft);
	}
	.cats {
		display: flex;
		flex-direction: column;
		gap: 1px;
		overflow-y: auto;
		margin: 0 -4px;
		padding: 0 4px;
	}
	.cat-btn {
		display: flex;
		align-items: center;
		gap: 10px;
		width: 100%;
		border: 0;
		background: none;
		color: var(--ink);
		font: inherit;
		text-align: left;
		padding: 7px 8px;
		border-radius: 9px;
		cursor: pointer;
	}
	.cat-btn:hover,
	.cat-btn[aria-expanded='true'] {
		background: var(--surface-2);
	}
	.cat-btn[data-active='true'] {
		background: var(--accent);
	}
	.cat-btn-icon {
		display: flex;
		flex-shrink: 0;
		color: var(--accent-strong);
	}
	.cat-btn-icon :global(svg) {
		width: 16px;
		height: 16px;
	}
	.cat-btn-text {
		display: flex;
		flex-direction: column;
		min-width: 0;
		flex: 1;
	}
	.cat-btn-text b {
		font-size: 13px;
		font-weight: 700;
	}
	.cat-btn-text small {
		font-size: 11px;
		color: var(--ink-soft);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.cat-count {
		font-size: 11px;
		font-weight: 700;
		color: var(--ink-soft);
		font-variant-numeric: tabular-nums;
	}
	.mega {
		position: fixed;
		top: 0;
		left: 232px;
		bottom: 0;
		width: min(760px, calc(100vw - 232px));
		box-sizing: border-box;
		padding: 24px 24px 32px;
		overflow-y: auto;
		background: var(--surface);
		border-right: 1px solid var(--border);
		box-shadow: 24px 0 48px -12px rgba(0, 0, 0, 0.3);
	}
	.mega-intro {
		display: flex;
		align-items: center;
		gap: 12px;
		margin-bottom: 18px;
	}
	.mega-icon {
		display: flex;
		width: 38px;
		height: 38px;
		flex-shrink: 0;
		align-items: center;
		justify-content: center;
		border-radius: 10px;
		background: var(--accent);
		color: var(--accent-strong);
	}
	.mega-icon :global(svg) {
		width: 19px;
		height: 19px;
	}
	.mega-intro b {
		font-size: 19px;
		font-weight: 800;
	}
	.mega-intro p {
		margin: 2px 0 0;
		font-size: 13px;
		color: var(--ink-soft);
	}
	.mega-grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
		gap: 4px 10px;
	}
	.mega-grid a {
		display: flex;
		align-items: flex-start;
		gap: 10px;
		padding: 10px 12px;
		border-radius: 10px;
		text-decoration: none;
		color: var(--ink);
	}
	.mega-grid a:hover,
	.mega-grid a:focus-visible {
		background: var(--surface-2);
	}
	.mega-grid a[aria-current='page'] {
		background: var(--accent);
	}
	.mega-grid b {
		font-size: 14px;
		font-weight: 700;
	}
	.mega-grid span {
		font-size: 12.5px;
		line-height: 1.4;
		color: var(--ink-soft);
	}
	.mega-scrim {
		position: fixed;
		inset: 0 0 0 232px;
		z-index: 40;
		background: rgba(0, 0, 0, 0.3);
	}
	.mobile-bar {
		display: none;
	}
	@media (max-width: 760px) {
		.mobile-bar {
			display: flex;
			align-items: center;
			gap: 8px;
			position: sticky;
			top: 0;
			z-index: 60;
			height: 52px;
			padding: 0 16px;
			background: var(--bg);
			border-bottom: 1px solid var(--border);
		}
		.mobile-bar .brand {
			margin-right: auto;
		}
		.site-header {
			position: fixed;
			top: 52px;
			left: 0;
			right: 0;
			width: auto;
			height: calc(100vh - 52px);
			border-right: 0;
			visibility: hidden;
		}
		.site-header:global(.open) {
			visibility: visible;
		}
		.brand-row .brand {
			visibility: hidden;
		}
		.mega {
			top: 52px;
			left: 0;
			width: 100vw;
		}
		.mega-scrim {
			display: none;
		}
	}
	.palette {
		border: 0;
		padding: 0;
		background: transparent;
		width: min(640px, calc(100vw - 32px));
		max-height: none;
		margin: 12vh auto auto;
		color: var(--ink);
	}
	.palette::backdrop {
		background: rgba(0, 0, 0, 0.45);
		backdrop-filter: blur(2px);
	}
	.palette-box {
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: 16px;
		overflow: hidden;
		box-shadow: 0 30px 80px rgba(0, 0, 0, 0.35);
	}
	.palette-input {
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 12px 16px;
		border-bottom: 1px solid var(--border);
		color: var(--ink-soft);
	}
	.palette-input input {
		flex: 1;
		min-width: 0;
		border: 0;
		outline: 0;
		background: transparent;
		color: var(--ink);
		font: inherit;
		font-size: 16px;
	}
	.palette-list {
		list-style: none;
		margin: 0;
		padding: 6px;
		max-height: 52vh;
		overflow-y: auto;
	}
	.palette-list :global(li) {
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 9px 12px;
		border-radius: 10px;
		cursor: pointer;
	}
	.palette-list :global(li[aria-selected='true']) {
		background: var(--accent);
	}
	.palette-list :global(li div) {
		display: flex;
		flex-direction: column;
		gap: 1px;
		flex: 1;
		min-width: 0;
	}
	.palette-list :global(li b) {
		font-size: 14px;
	}
	.palette-list :global(li span) {
		font-size: 12.5px;
		color: var(--ink-soft);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.palette-list :global(li em) {
		font-style: normal;
		font-size: 11px;
		color: var(--ink-soft);
		white-space: nowrap;
	}
	.palette-list :global(.palette-empty) {
		color: var(--ink-soft);
		cursor: default;
	}
	.palette-foot {
		display: flex;
		gap: 16px;
		padding: 8px 16px;
		border-top: 1px solid var(--border);
		font-size: 12px;
		color: var(--ink-soft);
	}
	.palette-foot kbd {
		margin-right: 3px;
	}
	.t-icon {
		flex: none;
		display: grid;
		place-items: center;
		width: 30px;
		height: 30px;
		border-radius: 8px;
		background: color-mix(in srgb, var(--accent-strong) 12%, transparent);
		color: var(--accent-strong);
	}
	.t-icon :global(svg) {
		width: 16px;
		height: 16px;
	}
	.t-text {
		display: flex;
		flex-direction: column;
		gap: 2px;
		min-width: 0;
	}
</style>
