---
import Logo from './Logo.astro';
import { builtCategories as categories, categorySlug } from '../data/tools';
import { categoryId } from '../scripts/experience';
import { sitePath } from '../scripts/seo';
import { icon, iconUse } from '../scripts/icons';
import { suggestUrl } from '../scripts/suggest';

interface Props {
	activeSlug?: string;
}

const { activeSlug } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const total = categories.reduce((a, c) => a + c.tools.length, 0);
const shortcuts = [
	{ keys: ['/'], alt: ['⌘', 'K'], label: 'Search tools' },
	{ keys: ['g', 'h'], label: 'Go to the home page' },
	{ keys: ['g', 'f'], label: 'Go to your pinned tools' },
	{ keys: ['f'], label: 'Pin or unpin the current tool' },
	{ keys: ['⌘', 'Enter'], label: 'Run the main action of the tool' },
	{ keys: ['⌘', 'Shift', 'C'], label: 'Copy the first output' },
	{ keys: ['?'], label: 'Show this help' },
	{ keys: ['Esc'], label: 'Close a menu or dialog' },
];
---

<div class="mobile-bar">
	<a class="brand" href={base} aria-label="kodilo home">
		<Logo />
		kodilo
	</a>
	<button type="button" class="icon-btn" id="mobile-search" aria-label="Search tools">
		<span set:html={icon('search')} />
	</button>
	<button type="button" class="icon-btn" id="nav-open" aria-label="Open menu" aria-expanded="false">
		<span set:html={icon('menu')} />
	</button>
</div>

<aside class="site-header" id="site-nav" data-active-slug={activeSlug} transition:name="site-nav">
	<div class="brand-row">
		<a class="brand" href={base} aria-label="kodilo home">
			<Logo />
			kodilo
		</a>
		<div class="brand-actions">
			<button type="button" class="icon-btn" id="shortcuts-open" aria-label="Keyboard shortcuts" aria-haspopup="dialog">
				<span set:html={icon('keyboard')} />
			</button>
			<button type="button" class="icon-btn theme-toggle" id="theme-toggle" aria-label="Toggle theme">
				<span class="icon-sun" set:html={icon('sun')} />
				<span class="icon-moon" set:html={icon('moon')} />
			</button>
		</div>
	</div>
	<button type="button" class="search-btn" id="search-open" aria-label="Search tools">
		<span set:html={icon('search')} />
		<span class="search-label">Search {total} tools</span>
		<kbd id="search-kbd">⌘K</kbd>
	</button>
	<nav class="cats" aria-label="Tool categories">
		{categories.map((c, i) => (
			<a
				href={`${base}#${categoryId(c.name)}`}
				class="cat-btn"
				aria-expanded="false"
				aria-controls={`mega-${i}`}
				data-active={c.tools.some((t) => t.slug === activeSlug) ? 'true' : undefined}
			>
				<span class="cat-btn-icon" set:html={iconUse(c.icon)} />
				<span class="cat-btn-text">
					<b>{c.name}</b>
					<small>{c.blurb}</small>
				</span>
				<span class="cat-count">{c.tools.length}</span>
			</a>
		))}
	</nav>
	<a class="side-categories" href={sitePath('categories/')}>
		All categories
	</a>
	<a class="side-suggest" href={suggestUrl()} target="_blank" rel="noopener" aria-label="Suggest a tool (opens GitHub in a new tab)">
		Suggest a tool
	</a>
	{categories.map((c, i) => (
		<div class="mega" id={`mega-${i}`} data-category={c.name} role="region" aria-label={`${c.name} tools`} hidden>
			<div class="mega-intro">
				<span class="mega-icon" set:html={iconUse(c.icon)} />
				<div>
					<b>{c.name}</b>
					<p>
						{c.blurb} ·{' '}
						<a class="mega-all" href={sitePath(`categories/${categorySlug(c.name)}/`)}>
							All {c.tools.length} tool{c.tools.length === 1 ? '' : 's'}
						</a>
					</p>
				</div>
			</div>
			<ul class="mega-grid">
				<li class="mega-status">Loading tools…</li>
			</ul>
		</div>
	))}
</aside>
<div class="mega-scrim" id="mega-scrim" hidden></div>

<dialog class="palette" id="palette" aria-label="Search tools">
	<div class="palette-box">
		<div class="palette-input">
			<span set:html={icon('search')} />
			<input
				id="palette-q"
				type="search"
				role="combobox"
				aria-label="Search tools"
				aria-autocomplete="list"
				aria-expanded="true"
				aria-controls="palette-list"
				placeholder="Search tools, e.g. jwt, base64, cron…"
				autocomplete="off"
				spellcheck="false"
			/>
			<kbd>Esc</kbd>
		</div>
		<ul class="palette-list" id="palette-list" role="listbox" aria-label="Tools"></ul>
		<p class="palette-suggest" id="palette-suggest" hidden>
			<a id="palette-suggest-link" href={suggestUrl()} target="_blank" rel="noopener">
				Suggest this tool on GitHub
			</a>
		</p>
		<p class="visually-hidden" id="palette-status" role="status"></p>
		<div class="palette-foot">
			<span>
				<kbd>↑</kbd>
				<kbd>↓</kbd> to move
			</span>
			<span>
				<kbd>↵</kbd> to open
			</span>
			<span>
				<kbd>?</kbd> for shortcuts
			</span>
		</div>
	</div>
</dialog>

<dialog class="shortcuts" id="shortcuts" aria-labelledby="shortcuts-title">
	<div class="shortcuts-box">
		<div class="shortcuts-head">
			<h2 id="shortcuts-title">Keyboard shortcuts</h2>
			<button type="button" class="icon-btn" id="shortcuts-close" aria-label="Close">
				<span set:html={icon('x')} />
			</button>
		</div>
		<dl>
			{shortcuts.map((s) => (
				<div>
					<dt>
						{s.keys.map((k) => (
							<kbd data-key={k}>{k}</kbd>
						))}
						{s.alt && <span class="or">or</span>}
						{s.alt?.map((k) => (
							<kbd data-key={k}>{k}</kbd>
						))}
					</dt>
					<dd>{s.label}</dd>
				</div>
			))}
		</dl>
		<p class="shortcuts-note">Single-key shortcuts are off while you type in a field.</p>
	</div>
</dialog>

<script>
	import '../scripts/header';
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		width: 232px;
		flex-shrink: 0;
		height: 100vh;
		align-self: flex-start;
		box-sizing: border-box;
		display: flex;
		flex-direction: column;
		gap: 12px;
		padding: 16px 10px;
		background: var(--bg);
		border-right: 1px solid var(--border);
	}
	.brand-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0 6px;
	}
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		font-size: 17px;
		font-weight: 800;
		letter-spacing: -0.02em;
		color: var(--accent-strong);
		text-decoration: none;
	}
	.icon-btn {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 30px;
		height: 30px;
		flex-shrink: 0;
		border: 1px solid var(--border);
		border-radius: 8px;
		background: var(--surface);
		color: var(--ink-soft);
		cursor: pointer;
		padding: 0;
	}
	.icon-btn:hover {
		background: var(--surface-2);
	}
	.icon-btn :global(svg) {
		width: 15px;
		height: 15px;
		display: block;
	}
	.icon-moon {
		display: none;
	}
	:root[data-theme='dark'] .theme-toggle .icon-sun {
		display: none;
	}
	:root[data-theme='dark'] .theme-toggle .icon-moon {
		display: flex;
	}
	@media (prefers-color-scheme: dark) {
		:root:not([data-theme='light']) .theme-toggle .icon-sun {
			display: none;
		}
		:root:not([data-theme='light']) .theme-toggle .icon-moon {
			display: flex;
		}
	}
	.search-btn {
		display: flex;
		align-items: center;
		gap: 8px;
		border: 1px solid var(--border);
		background: var(--surface);
		color: var(--ink-soft);
		font: inherit;
		font-size: 13px;
		padding: 7px 8px 7px 10px;
		border-radius: 9px;
		cursor: pointer;
	}
	.search-btn:hover {
		border-color: var(--accent-strong);
	}
	.search-label {
		flex: 1;
		text-align: left;
	}
	.search-btn :global(svg),
	.palette-input :global(svg) {
		width: 15px;
		height: 15px;
		display: block;
	}
	kbd {
		font-family: var(--mono);
		font-size: 11px;
		padding: 1px 6px;
		border: 1px solid var(--border);
		border-bottom-width: 2px;
		border-radius: 5px;
		background: var(--surface-2);
		color: var(--ink-soft);
	}
	.cats {
		display: flex;
		flex-direction: column;
		gap: 1px;
		overflow-y: auto;
		margin: 0 -4px;
		padding: 0 4px;
	}
	.cat-btn {
		box-sizing: border-box;
		text-decoration: none;
		display: flex;
		align-items: center;
		gap: 10px;
		width: 100%;
		border: 0;
		background: none;
		color: var(--ink);
		font: inherit;
		text-align: left;
		padding: 7px 8px;
		border-radius: 9px;
		cursor: pointer;
	}
	.cat-btn:hover,
	.cat-btn[aria-expanded='true'] {
		background: var(--surface-2);
	}
	.cat-btn[data-active='true'] {
		background: var(--accent);
	}
	.cat-btn-icon {
		display: flex;
		flex-shrink: 0;
		color: var(--accent-strong);
	}
	.cat-btn-icon :global(svg) {
		width: 16px;
		height: 16px;
	}
	.cat-btn-text {
		display: flex;
		flex-direction: column;
		min-width: 0;
		flex: 1;
	}
	.cat-btn-text b {
		font-size: 13px;
		font-weight: 700;
	}
	.cat-btn-text small {
		font-size: 11px;
		color: var(--ink-soft);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.cat-count {
		font-size: 11px;
		font-weight: 700;
		color: var(--ink-soft);
		font-variant-numeric: tabular-nums;
	}
	.mega {
		position: fixed;
		top: 0;
		left: 232px;
		bottom: 0;
		width: min(760px, calc(100vw - 232px));
		box-sizing: border-box;
		padding: 24px 24px 32px;
		overflow-y: auto;
		background: var(--surface);
		border-right: 1px solid var(--border);
		box-shadow: 24px 0 48px -12px rgba(0, 0, 0, 0.3);
	}
	.mega-intro {
		display: flex;
		align-items: center;
		gap: 12px;
		margin-bottom: 18px;
	}
	.mega-icon {
		display: flex;
		width: 38px;
		height: 38px;
		flex-shrink: 0;
		align-items: center;
		justify-content: center;
		border-radius: 10px;
		background: var(--accent);
		color: var(--accent-strong);
	}
	.mega-icon :global(svg) {
		width: 19px;
		height: 19px;
	}
	.mega-intro b {
		font-size: 19px;
		font-weight: 800;
	}
	.mega-intro p {
		margin: 2px 0 0;
		font-size: 13px;
		color: var(--ink-soft);
	}
	.mega-all {
		color: var(--accent-strong);
	}
	.mega-grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
		gap: 4px 10px;
	}
	.mega-grid :global(a) {
		display: flex;
		align-items: flex-start;
		gap: 10px;
		padding: 10px 12px;
		border-radius: 10px;
		text-decoration: none;
		color: var(--ink);
	}
	.mega-grid :global(a:hover),
	.mega-grid :global(a:focus-visible) {
		background: var(--surface-2);
	}
	.mega-grid :global(a[aria-current='page']) {
		background: var(--accent);
	}
	.mega-grid :global(b) {
		font-size: 14px;
		font-weight: 700;
	}
	.mega-grid :global(span) {
		font-size: 12.5px;
		line-height: 1.4;
		color: var(--ink-soft);
	}
	.mega-scrim {
		position: fixed;
		inset: 0 0 0 232px;
		z-index: 40;
		background: rgba(0, 0, 0, 0.3);
	}
	.mobile-bar {
		display: none;
	}
	@media (max-width: 760px) {
		.mobile-bar {
			display: flex;
			align-items: center;
			gap: 8px;
			position: sticky;
			top: 0;
			z-index: 60;
			height: 52px;
			padding: 0 16px;
			background: var(--bg);
			border-bottom: 1px solid var(--border);
		}
		.mobile-bar .brand {
			margin-right: auto;
		}
		.site-header {
			position: fixed;
			top: 52px;
			left: 0;
			right: 0;
			width: auto;
			height: calc(100vh - 52px);
			border-right: 0;
			visibility: hidden;
		}
		.site-header:global(.open) {
			visibility: visible;
		}
		.brand-row .brand {
			visibility: hidden;
		}
		.mega {
			top: 52px;
			left: 0;
			width: 100vw;
		}
		.mega-scrim {
			display: none;
		}
	}
	.palette {
		border: 0;
		padding: 0;
		background: transparent;
		width: min(640px, calc(100vw - 32px));
		max-height: none;
		margin: 12vh auto auto;
		color: var(--ink);
	}
	.palette::backdrop {
		background: rgba(0, 0, 0, 0.45);
		backdrop-filter: blur(2px);
	}
	.palette-box {
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: 16px;
		overflow: hidden;
		box-shadow: 0 30px 80px rgba(0, 0, 0, 0.35);
	}
	.palette-input {
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 12px 16px;
		border-bottom: 1px solid var(--border);
		color: var(--ink-soft);
	}
	.palette-input input {
		flex: 1;
		min-width: 0;
		border: 0;
		outline: 0;
		background: transparent;
		color: var(--ink);
		font: inherit;
		font-size: 16px;
	}
	.palette-list {
		list-style: none;
		margin: 0;
		padding: 6px;
		max-height: 52vh;
		overflow-y: auto;
	}
	.palette-list :global(li) {
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 9px 12px;
		border-radius: 10px;
		cursor: pointer;
	}
	.palette-list :global(li[aria-selected='true']) {
		background: var(--accent);
	}
	.palette-list :global(li div) {
		display: flex;
		flex-direction: column;
		gap: 1px;
		flex: 1;
		min-width: 0;
	}
	.palette-list :global(li b) {
		font-size: 14px;
	}
	.palette-list :global(li span) {
		font-size: 12.5px;
		color: var(--ink-soft);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.palette-list :global(li em) {
		font-style: normal;
		font-size: 11px;
		color: var(--ink-soft);
		white-space: nowrap;
	}
	.palette-list :global(.palette-empty) {
		color: var(--ink-soft);
		cursor: default;
	}
	.palette-suggest {
		margin: 0;
		padding: 0 16px 12px;
	}
	.palette-suggest a,
	.side-suggest {
		color: var(--accent-strong);
		font-weight: 600;
		font-size: 13px;
	}
	.side-suggest {
		margin-top: auto;
		padding: 6px 8px;
		border-radius: 8px;
		text-decoration: none;
	}
	.side-suggest:hover,
	.side-suggest:focus-visible {
		background: var(--surface-2);
		text-decoration: underline;
	}
	.side-categories {
		padding: 6px 8px;
		font-size: 13px;
		color: var(--ink-soft);
	}
	.side-categories:hover,
	.side-categories:focus-visible {
		color: var(--accent-strong);
	}
	.palette-foot {
		display: flex;
		gap: 16px;
		padding: 8px 16px;
		border-top: 1px solid var(--border);
		font-size: 12px;
		color: var(--ink-soft);
	}
	.palette-foot kbd {
		margin-right: 3px;
	}
	.mega-grid :global(.t-icon) {
		flex: none;
		display: grid;
		place-items: center;
		width: 30px;
		height: 30px;
		border-radius: 8px;
		background: color-mix(in srgb, var(--accent-strong) 12%, transparent);
		color: var(--accent-strong);
	}
	.mega-grid :global(.t-icon svg) {
		width: 16px;
		height: 16px;
	}
	.mega-grid :global(.t-text) {
		display: flex;
		flex-direction: column;
		gap: 2px;
		min-width: 0;
	}
	.brand-actions {
		display: flex;
		gap: 6px;
	}
	.mega-status {
		color: var(--ink-soft);
		font-size: 13px;
		padding: 10px 12px;
	}
	.palette-list :global(li[role='presentation']) {
		cursor: default;
		padding: 10px 12px 4px;
		font-size: 11px;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--ink-soft);
	}
	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		margin: -1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}
	.shortcuts {
		border: 0;
		padding: 0;
		background: transparent;
		width: min(480px, calc(100vw - 32px));
		color: var(--ink);
	}
	.shortcuts::backdrop {
		background: rgba(0, 0, 0, 0.45);
	}
	.shortcuts-box {
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: 16px;
		padding: 18px 20px;
		box-shadow: 0 30px 80px rgba(0, 0, 0, 0.35);
	}
	.shortcuts-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 10px;
	}
	.shortcuts h2 {
		margin: 0;
		font-size: 18px;
	}
	.shortcuts dl {
		margin: 0;
		display: grid;
		gap: 8px;
	}
	.shortcuts dl div {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
	}
	.shortcuts dt {
		display: flex;
		align-items: center;
		gap: 4px;
		flex-wrap: wrap;
	}
	.shortcuts dd {
		margin: 0;
		font-size: 13.5px;
		color: var(--ink-soft);
		text-align: right;
	}
	.shortcuts .or {
		font-size: 12px;
		color: var(--ink-soft);
	}
	.shortcuts-note {
		margin: 14px 0 0;
		font-size: 12.5px;
		color: var(--ink-soft);
	}
</style>
