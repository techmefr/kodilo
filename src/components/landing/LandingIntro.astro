---
import Logo from '../Logo.astro';

interface Props {
	total: number;
}

const { total } = Astro.props;
const words = ['Format', 'Decode', 'Convert', 'Inspect'];
---

<div class="li" id="li" data-total={total} hidden aria-hidden="true">
	<div class="li-brand">
		<div class="li-mark">
			<Logo />
		</div>
		<span class="li-word">kodilo</span>
	</div>
	<p class="li-count">
		<b id="li-n">0</b> <span id="li-w">{words[0]}</span>
	</p>
</div>

<script>
	import { runIntro } from '../../scripts/landing-motion';

	runIntro();
</script>

<style is:global>
	.li {
		position: fixed;
		inset: 0;
		z-index: 200;
		display: grid;
		place-content: center;
		justify-items: center;
		gap: 22px;
		background: var(--bg);
	}
	.li[hidden] {
		display: none;
	}
	.li-brand {
		display: flex;
		align-items: center;
		gap: 16px;
	}
	.li-word {
		font-family: var(--display);
		font-size: 52px;
		font-weight: 700;
		letter-spacing: -0.04em;
		color: var(--ink);
	}
	.li-mark {
		width: 72px;
		height: 72px;
		color: var(--ink);
	}
	.li-mark :is(svg, img) {
		width: 100%;
		height: 100%;
	}
	.li-count {
		margin: 0;
		font-family: var(--display);
		font-size: 22px;
		color: var(--ink-soft);
		font-variant-numeric: tabular-nums;
	}
	.li-count b {
		color: var(--ink);
		font-size: 44px;
		font-weight: 700;
		letter-spacing: -0.03em;
	}
</style>
