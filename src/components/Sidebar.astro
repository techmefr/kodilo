---
import { builtCategories as categories } from '../data/tools';
import { icon } from '../scripts/icons';

interface Props {
	activeSlug?: string;
}

const { activeSlug } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const category = categories.find((c) => c.tools.some((t) => t.slug === activeSlug));
---

{
	category && (
		<nav class="sidebar" aria-label={`${category.name} tools`}>
			<div class="side-head">
				<span class="side-icon" set:html={icon(category.icon)} />
				<span>{category.name}</span>
			</div>
			{category.tools.map((tool) => (
				<a class="sidebar-tool" href={`${base}tools/${tool.slug}/`} aria-current={tool.slug === activeSlug ? 'page' : undefined}>
					{tool.name}
				</a>
			))}
		</nav>
	)
}

<style>
	.sidebar {
		width: 210px;
		flex-shrink: 0;
		border-right: 1px solid var(--border);
		padding: 20px 10px;
		position: sticky;
		top: 57px;
		align-self: flex-start;
		max-height: calc(100vh - 57px);
		overflow-y: auto;
		display: flex;
		flex-direction: column;
		gap: 1px;
	}
	.side-head {
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 0 8px 10px;
		font-size: 12px;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--ink-soft);
	}
	.side-icon {
		display: flex;
		color: var(--accent-strong);
	}
	.side-icon :global(svg) {
		width: 15px;
		height: 15px;
	}
	.sidebar-tool {
		color: var(--ink-soft);
		font-size: 13px;
		font-weight: 500;
		padding: 7px 8px;
		border-radius: 7px;
		text-decoration: none;
	}
	.sidebar-tool:hover {
		background: var(--surface-2);
		color: var(--ink);
	}
	.sidebar-tool[aria-current='page'] {
		background: var(--accent);
		color: var(--accent-strong);
		font-weight: 700;
	}
	@media (max-width: 760px) {
		.sidebar {
			display: none;
		}
	}
</style>
