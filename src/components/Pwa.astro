---
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<link rel="manifest" href={`${base}manifest.webmanifest`} />
<meta name="pwa-base" content={base} />

<script>
	import { registerServiceWorker } from '../scripts/pwa';

	if (import.meta.env.PROD) {
		const base = document.querySelector<HTMLMetaElement>('meta[name="pwa-base"]')?.content ?? '/';
		window.addEventListener('load', () => registerServiceWorker(`${base}sw.js`, base).catch(() => {}), { once: true });
	}
</script>

<style is:global>
	.pwa-toast {
		position: fixed;
		right: 16px;
		bottom: 16px;
		z-index: 1000;
		display: flex;
		align-items: center;
		gap: 10px;
		max-width: calc(100vw - 32px);
		padding: 10px 12px 10px 16px;
		border: 1px solid var(--border);
		border-radius: 10px;
		background: var(--surface);
		color: var(--ink);
		font-size: 14px;
		box-shadow: 0 6px 24px rgb(0 0 0 / 0.15);
	}
	.pwa-toast-close {
		min-width: 32px;
		min-height: 32px;
		border: 0;
		border-radius: 6px;
		background: transparent;
		color: var(--ink-soft);
		font-size: 20px;
		line-height: 1;
		cursor: pointer;
	}
	.pwa-toast-close:hover {
		background: var(--surface-2);
		color: var(--ink);
	}
	.pwa-toast button:focus-visible {
		outline: 2px solid var(--accent-strong);
		outline-offset: 2px;
	}
</style>
