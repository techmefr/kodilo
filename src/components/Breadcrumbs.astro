---
import { sitePath, type Crumb } from '../scripts/seo';

interface Props {
	crumbs: Crumb[];
}

const { crumbs } = Astro.props;
---

<nav class="crumbs" aria-label="Breadcrumb">
	<ol>
		{crumbs.map((c, i) => (
			<li>{i === crumbs.length - 1 ? <span aria-current="page">{c.name}</span> : <a href={sitePath(c.path)}>{c.name}</a>}</li>
		))}
	</ol>
</nav>

<style>
	.crumbs ol {
		display: flex;
		flex-wrap: wrap;
		gap: 4px;
		list-style: none;
		margin: 0;
		padding: 0;
		font-size: 13px;
		color: var(--ink-soft);
	}
	.crumbs li + li::before {
		content: '/';
		margin-right: 4px;
	}
	.crumbs a {
		color: var(--ink-soft);
	}
	.crumbs a:hover,
	.crumbs a:focus-visible {
		color: var(--accent-strong);
	}
</style>
