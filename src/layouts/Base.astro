---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Pwa from '../components/Pwa.astro';

interface Props {
	title?: string;
	description?: string;
	noindex?: boolean;
}

const {
	title = 'kodilo',
	description = 'Open-source tools for developers. No sign-up, no account, nothing leaves your browser.',
	noindex = false,
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const image = new URL(`${base}og-image.png`, Astro.site).href;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
		<link rel="icon" href={`${base}favicon.ico`} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
		<link rel="sitemap" href={`${base}sitemap-index.xml`} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#6d4fe0" />
		{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="kodilo" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={image} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&family=JetBrains+Mono:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
		<script is:inline>
			function applyStoredTheme(root) {
				try {
					const stored = localStorage.getItem('kodilo-theme');
					if (stored === 'dark' || stored === 'light') root.dataset.theme = stored;
				} catch {}
			}
			applyStoredTheme(document.documentElement);
			document.addEventListener('astro:before-swap', (event) => applyStoredTheme(event.newDocument.documentElement));
		</script>
		<Pwa />
		<ClientRouter />
	</head>
	<body>
		<a class="skip-link" href="#main">
			Skip to content
		</a>
		<slot />
	</body>
</html>
