---
import ToolShell from '../../components/ToolShell.astro';
---

<ToolShell slug="rsa-key-pair-generator" title="RSA Key Pair Generator" description="Generate an RSA key pair in PEM (PKCS#8 and SPKI) and JWK, for signing or encryption. Keys never leave your browser.">
	<div class="toolbar" id="rsa-tool">
		<div class="seg" id="rsa-bits">
			<button data-value="2048" aria-pressed="true">2048 bits</button>
			<button data-value="3072">3072 bits</button>
			<button data-value="4096">4096 bits</button>
		</div>
		<div class="seg" id="rsa-alg">
			<button data-value="RSASSA-PKCS1-v1_5" aria-pressed="true">RS256 · sign</button>
			<button data-value="RSA-PSS">PS256 · sign</button>
			<button data-value="RSA-OAEP">RSA-OAEP · encrypt</button>
		</div>
		<div class="seg" id="rsa-format">
			<button data-value="pem" aria-pressed="true">PEM</button>
			<button data-value="jwk">JWK</button>
		</div>
		<button class="btn primary" id="rsa-new">Generate</button>
	</div>
	<p class="rsa-status" id="rsa-status"></p>
	<div class="grid-2">
		<section class="panel">
			<div class="panel-head">
				<span>Public key</span>
				<button class="btn" id="rsa-copy-pub">Copy</button>
			</div>
			<pre class="out rsa-out" id="rsa-pub"></pre>
		</section>
		<section class="panel">
			<div class="panel-head">
				<span>Private key</span>
				<button class="btn" id="rsa-copy-priv">Copy</button>
			</div>
			<pre class="out rsa-out" id="rsa-priv"></pre>
		</section>
	</div>
	<p class="rsa-fp" id="rsa-fp"></p>
</ToolShell>

<script>
	import { encodeBytes } from '../../scripts/crypto';
	import { byId, copyButton, onPage, segmented } from '../../scripts/ui';

	const pem = (label: string, buf: ArrayBuffer) => `-----BEGIN ${label}-----\n${btoa(String.fromCharCode(...new Uint8Array(buf))).match(/.{1,64}/g)!.join('\n')}\n-----END ${label}-----`;

	onPage('rsa-tool', () => {
		let bits = 2048;
		let alg = 'RSASSA-PKCS1-v1_5';
		let format = 'pem';
		let pair: CryptoKeyPair | null = null;
		let run = 0;

		const show = async () => {
			if (!pair) return;
			if (format === 'pem') {
				byId('rsa-pub').textContent = pem('PUBLIC KEY', await crypto.subtle.exportKey('spki', pair.publicKey));
				byId('rsa-priv').textContent = pem('PRIVATE KEY', await crypto.subtle.exportKey('pkcs8', pair.privateKey));
			} else {
				const kid = byId('rsa-fp').dataset.kid;
				const pub = { ...(await crypto.subtle.exportKey('jwk', pair.publicKey)), kid };
				const priv = { ...(await crypto.subtle.exportKey('jwk', pair.privateKey)), kid };
				byId('rsa-pub').textContent = JSON.stringify(pub, null, 2);
				byId('rsa-priv').textContent = JSON.stringify(priv, null, 2);
			}
		};

		const generate = async () => {
			const id = ++run;
			byId('rsa-status').textContent = `Generating a ${bits}-bit key…`;
			const started = performance.now();
			const usages: KeyUsage[] = alg === 'RSA-OAEP' ? ['encrypt', 'decrypt'] : ['sign', 'verify'];
			const kp = (await crypto.subtle.generateKey({ name: alg, modulusLength: bits, publicExponent: new Uint8Array([1, 0, 1]), hash: 'SHA-256' }, true, usages)) as CryptoKeyPair;
			if (id !== run) return;
			pair = kp;
			const spki = await crypto.subtle.exportKey('spki', kp.publicKey);
			const fp = encodeBytes(new Uint8Array(await crypto.subtle.digest('SHA-256', spki)), 'hex');
			byId('rsa-fp').dataset.kid = fp.slice(0, 16);
			byId('rsa-fp').textContent = `SHA-256 fingerprint of the public key: ${fp.match(/../g)!.join(':')}`;
			byId('rsa-status').textContent = `${bits}-bit ${alg} key pair, generated in ${Math.round(performance.now() - started)} ms. Keep the private key secret.`;
			show();
		};

		segmented(byId('rsa-bits'), (v) => ((bits = Number(v)), generate()));
		segmented(byId('rsa-alg'), (v) => ((alg = v), generate()));
		segmented(byId('rsa-format'), (v) => ((format = v), show()));
		byId('rsa-new').addEventListener('click', generate);
		copyButton(byId('rsa-copy-pub'), () => byId('rsa-pub').textContent ?? '');
		copyButton(byId('rsa-copy-priv'), () => byId('rsa-priv').textContent ?? '');
		generate();
	});
</script>

<style>
	.rsa-status,
	.rsa-fp {
		margin: 0;
		font-size: 13px;
		color: var(--ink-soft);
	}
	.rsa-fp {
		font-family: var(--mono);
		overflow-wrap: anywhere;
	}
	.rsa-out {
		white-space: pre-wrap;
		overflow-wrap: anywhere;
		max-height: 420px;
		overflow: auto;
	}
</style>
