---
import ToolShell from '../../components/ToolShell.astro';
---

<ToolShell
	slug="ipv4-range-expander"
	title="IPv4 Range Expander"
	description="Expand a CIDR or a start–end range into addresses, and get the smallest set of CIDR blocks that covers it."
>
	<div class="fields" id="rx-tool">
		<div class="field wide" id="rx-field">
			<label for="rx-in">CIDR or range</label>
			<input id="rx-in" spellcheck="false" value="192.168.1.10 - 192.168.1.40" />
			<span class="field-note" id="rx-note"></span>
		</div>
	</div>
	<div class="stats" id="rx-stats"></div>
	<div class="grid-2">
		<section class="panel">
			<div class="panel-head">
				<span>CIDR blocks</span>
				<button class="btn" id="rx-copy-cidr">Copy</button>
			</div>
			<pre class="out" id="rx-cidr"></pre>
		</section>
		<section class="panel">
			<div class="panel-head">
				<span id="rx-list-title">Addresses</span>
				<button class="btn" id="rx-copy-list">Copy</button>
			</div>
			<pre class="out rx-list" id="rx-list"></pre>
		</section>
	</div>
</ToolShell>

<script>
	import { byId, copyButton, onPage } from '../../scripts/ui';

	const LIMIT = 65536;

	function toInt(ip: string): number | null {
		const parts = ip.trim().split('.');
		if (parts.length !== 4 || parts.some((p) => !/^\d{1,3}$/.test(p) || +p > 255)) return null;
		return parts.reduce((acc, p) => acc * 256 + +p, 0);
	}

	const toIp = (n: number) => [24, 16, 8, 0].map((s) => Math.floor(n / 2 ** s) % 256).join('.');

	function parse(text: string): [number, number] | null {
		const cidr = text.trim().match(/^([\d.]+)\/(\d{1,2})$/);
		if (cidr) {
			const base = toInt(cidr[1]);
			const bits = +cidr[2];
			if (base === null || bits > 32) return null;
			const size = 2 ** (32 - bits);
			const start = Math.floor(base / size) * size;
			return [start, start + size - 1];
		}
		const range = text.split(/\s*(?:-|–|to)\s*/);
		if (range.length !== 2) {
			const single = toInt(text);
			return single === null ? null : [single, single];
		}
		const a = toInt(range[0]);
		const b = range[1].includes('.') ? toInt(range[1]) : a === null || !/^\d{1,3}$/.test(range[1]) || +range[1] > 255 ? null : a - (a % 256) + +range[1];
		return a === null || b === null ? null : [Math.min(a, b), Math.max(a, b)];
	}

	function toCidrs(start: number, end: number): string[] {
		const out: string[] = [];
		while (start <= end) {
			let size = 1;
			while (start % (size * 2) === 0 && start + size * 2 - 1 <= end && size < 2 ** 32) size *= 2;
			out.push(`${toIp(start)}/${32 - Math.log2(size)}`);
			start += size;
		}
		return out;
	}

	onPage('rx-tool', () => {
		const input = byId<HTMLInputElement>('rx-in');

		const render = () => {
			const r = parse(input.value);
			byId('rx-field').classList.toggle('invalid', !r);
			byId('rx-note').textContent = r ? '' : 'Try 10.0.0.0/28, 192.168.1.10 - 192.168.1.40 or 10.0.0.5-20.';
			if (!r) return;
			const [start, end] = r;
			const count = end - start + 1;
			const cidrs = toCidrs(start, end);
			const stats: [string, string][] = [
				['Addresses', count.toLocaleString('en')],
				['First', toIp(start)],
				['Last', toIp(end)],
				['CIDR blocks', String(cidrs.length)],
			];
			byId('rx-stats').replaceChildren(
				...stats.map(([label, value]) => {
					const el = document.createElement('div');
					el.className = 'stat';
					el.innerHTML = '<b></b><span></span>';
					el.querySelector('b')!.textContent = value;
					el.querySelector('span')!.textContent = label;
					return el;
				})
			);
			byId('rx-cidr').textContent = cidrs.join('\n');
			const shown = Math.min(count, LIMIT);
			const lines: string[] = [];
			for (let i = 0; i < shown; i++) lines.push(toIp(start + i));
			byId('rx-list').textContent = lines.join('\n');
			byId('rx-list-title').textContent = shown < count ? `First ${LIMIT.toLocaleString('en')} addresses` : 'Addresses';
		};

		input.addEventListener('input', render);
		copyButton(byId('rx-copy-cidr'), () => byId('rx-cidr').textContent ?? '');
		copyButton(byId('rx-copy-list'), () => byId('rx-list').textContent ?? '');
		render();
	});
</script>

<style>
	.rx-list {
		max-height: 420px;
		overflow: auto;
	}
</style>
