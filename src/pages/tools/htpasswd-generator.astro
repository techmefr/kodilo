---
import ToolShell from '../../components/ToolShell.astro';
---

<ToolShell
	slug="htpasswd-generator"
	title="htpasswd Generator"
	description="Build .htpasswd lines for Nginx and Apache basic auth. bcrypt is the safe default; SHA-1 is only there for old setups."
>
	<section class="panel" id="hp-tool">
		<div class="panel-head">Users, one per line as user:password</div>
		<textarea id="hp-in" spellcheck="false" aria-label="Users">admin:s3cret-Pass
deploy:ci-token-42</textarea>
	</section>
	<div class="toolbar">
		<div class="seg" id="hp-algo" aria-label="Algorithm">
			<button data-value="bcrypt" aria-pressed="true">
				bcrypt
			</button>
			<button data-value="sha" aria-pressed="false">
				SHA-1
			</button>
		</div>
		<label class="check">
			Cost <input class="num" id="hp-cost" type="number" min="4" max="14" value="10" />
		</label>
	</div>
	<section class="panel">
		<div class="panel-head">
			<span>.htpasswd</span>
			<button class="btn" id="hp-copy">
				Copy
			</button>
		</div>
		<pre class="out" id="hp-out"></pre>
	</section>
	<section class="panel">
		<div class="panel-head">
			<span id="hp-conf-title">Nginx</span>
			<div class="seg" id="hp-server" aria-label="Server">
				<button data-value="nginx" aria-pressed="true">
					Nginx
				</button>
				<button data-value="apache" aria-pressed="false">
					Apache
				</button>
			</div>
		</div>
		<pre class="out" id="hp-conf"></pre>
	</section>
</ToolShell>

<script>
	import bcrypt from 'bcryptjs';
	import { encodeBytes } from '../../scripts/crypto';
	import { byId, copyButton, onPage, segmented } from '../../scripts/ui';

	const CONF = {
		nginx: `location / {\n    auth_basic "Restricted";\n    auth_basic_user_file /etc/nginx/.htpasswd;\n}`,
		apache: `<Directory "/var/www/html">\n    AuthType Basic\n    AuthName "Restricted"\n    AuthUserFile /etc/apache2/.htpasswd\n    Require valid-user\n</Directory>`,
	};

	onPage('hp-tool', () => {
		const input = byId<HTMLTextAreaElement>('hp-in');
		const cost = byId<HTMLInputElement>('hp-cost');
		const out = byId('hp-out');
		let algo = 'bcrypt';
		let run = 0;
		let timer: number | undefined;

		const line = async (user: string, pw: string) => {
			if (algo === 'sha') {
				const digest = new Uint8Array(await crypto.subtle.digest('SHA-1', new TextEncoder().encode(pw)));
				return `${user}:{SHA}${encodeBytes(digest, 'base64')}`;
			}
			const rounds = Math.min(14, Math.max(4, Number(cost.value) || 10));
			return `${user}:${(await bcrypt.hash(pw, rounds)).replace(/^\$2b\$/, '$2y$')}`;
		};

		const render = async () => {
			const current = ++run;
			cost.disabled = algo !== 'bcrypt';
			const rows = input.value
				.split('\n')
				.map((l) => l.trim())
				.filter(Boolean);
			const lines: string[] = [];
			for (const row of rows) {
				const i = row.indexOf(':');
				if (i < 1) {
					lines.push(`# skipped "${row}": use user:password`);
					continue;
				}
				lines.push(await line(row.slice(0, i), row.slice(i + 1)));
			}
			if (current === run) out.textContent = lines.join('\n');
		};
		const schedule = () => {
			clearTimeout(timer);
			timer = window.setTimeout(render, 250);
		};

		segmented(byId('hp-algo'), (v) => {
			algo = v;
			render();
		});
		segmented(byId('hp-server'), (v) => {
			byId('hp-conf').textContent = CONF[v as keyof typeof CONF];
			byId('hp-conf-title').textContent = v === 'nginx' ? 'Nginx' : 'Apache';
		});
		input.addEventListener('input', schedule);
		cost.addEventListener('input', schedule);
		copyButton(byId('hp-copy'), () => out.textContent ?? '');
		byId('hp-conf').textContent = CONF.nginx;
		render();
	});
</script>

<style>
	#hp-in {
		min-height: 100px;
	}
	#hp-out {
		word-break: break-all;
		white-space: pre-wrap;
	}
</style>
