---
import ToolShell from '../../components/ToolShell.astro';
import { auras } from '../../data/auras';
---

<ToolShell
	slug="aura-gradient-generator"
	title="Aura Gradient Generator"
	description="Layered ambient gradients with blend modes and optional film grain. Export CSS or a PNG."
>
	<div class="au-stage" id="au-tool" role="img" aria-label="Gradient preview"></div>
	<div class="chips" id="au-presets" data-auras={JSON.stringify(auras)}>
		{auras.map((a, i) => (
			<button data-i={i}>{a.name}</button>
		))}
	</div>
	<div class="toolbar">
		<label class="check">
			Base <input type="color" id="au-base" value="#0b0a1f" />
		</label>
		<label class="check">
			<input type="checkbox" id="au-grain" /> Grain
		</label>
		<button class="btn" id="au-add">
			+ Layer
		</button>
		<button class="btn" id="au-random">
			Randomize
		</button>
	</div>
	<section class="panel">
		<div class="panel-head">
			<span>Layers</span>
		</div>
		<ul class="au-layers" id="au-layers"></ul>
	</section>
	<section class="panel">
		<div class="panel-head">
			<span>CSS</span>
			<span class="au-actions">
				<button class="btn" id="au-png">
					PNG
				</button>
				<button class="btn" id="au-copy">
					Copy
				</button>
			</span>
		</div>
		<pre class="out au-css" id="au-css"></pre>
	</section>
</ToolShell>

<script>
	import { auraCss, auraDeclaration, blendModes, rgba, type Aura, type AuraLayer, type BlendMode } from '../../data/auras';
	import { byId, copyButton, onPage } from '../../scripts/ui';

	const hslToHex = (h: number, s: number, l: number) => {
		const a = (s * Math.min(l, 1 - l)) / 100;
		const f = (n: number) => {
			const k = (n + h / 30) % 12;
			return Math.round(255 * (l / 100 - a * Math.max(-1, Math.min(k - 3, 9 - k, 1))))
				.toString(16)
				.padStart(2, '0');
		};
		return `#${f(0)}${f(8)}${f(4)}`;
	};

	onPage('au-tool', () => {
		const presets = JSON.parse(byId('au-presets').dataset.auras ?? '[]') as Aura[];
		let layers: AuraLayer[] = structuredClone(presets[0].layers);
		const base = byId<HTMLInputElement>('au-base');
		const grain = byId<HTMLInputElement>('au-grain');
		const current = (): Aura => ({ name: 'Custom', base: base.value, layers });

		const paint = () => {
			const { background, blend } = auraCss(current(), grain.checked);
			const stage = byId('au-tool');
			stage.style.background = background;
			stage.style.backgroundBlendMode = blend;
			byId('au-css').textContent = auraDeclaration(current(), grain.checked);
		};

		const field = (label: string, min: number, max: number, key: 'x' | 'y' | 'size' | 'opacity', layer: AuraLayer) => {
			const wrap = document.createElement('label');
			wrap.className = 'au-field';
			const text = document.createElement('span');
			text.textContent = label;
			const input = document.createElement('input');
			input.type = 'range';
			input.min = String(min);
			input.max = String(max);
			input.value = String(layer[key]);
			input.addEventListener('input', () => {
				layer[key] = Number(input.value);
				paint();
			});
			wrap.append(text, input);
			return wrap;
		};

		const render = () => {
			byId('au-layers').replaceChildren(
				...layers.map((layer, i) => {
					const li = document.createElement('li');
					const color = document.createElement('input');
					color.type = 'color';
					color.value = layer.color;
					color.setAttribute('aria-label', `Layer ${i + 1} color`);
					color.addEventListener('input', () => {
						layer.color = color.value;
						paint();
					});
					const blend = document.createElement('select');
					blend.setAttribute('aria-label', `Layer ${i + 1} blend mode`);
					blend.append(...blendModes.map((b) => new Option(b, b, false, b === layer.blend)));
					blend.addEventListener('change', () => {
						layer.blend = blend.value as BlendMode;
						paint();
					});
					const remove = document.createElement('button');
					remove.className = 'btn';
					remove.textContent = 'Remove';
					remove.disabled = layers.length <= 1;
					remove.addEventListener('click', () => {
						layers.splice(i, 1);
						render();
					});
					li.append(
						color,
						field('X', -20, 120, 'x', layer),
						field('Y', -20, 120, 'y', layer),
						field('Size', 10, 120, 'size', layer),
						field('Opacity', 5, 100, 'opacity', layer),
						blend,
						remove,
					);
					return li;
				}),
			);
			paint();
		};

		const load = (aura: Aura) => {
			layers = structuredClone(aura.layers);
			base.value = aura.base;
			render();
		};

		document.querySelectorAll<HTMLButtonElement>('#au-presets button').forEach((b) => b.addEventListener('click', () => load(presets[Number(b.dataset.i)])));
		base.addEventListener('input', paint);
		grain.addEventListener('change', paint);
		byId('au-add').addEventListener('click', () => {
			layers.push({ color: '#38bdf8', x: 50, y: 50, size: 50, opacity: 80, blend: 'screen' });
			render();
		});
		byId('au-random').addEventListener('click', () => {
			const hue = Math.floor(Math.random() * 360);
			const rgb = parseInt(base.value.slice(1), 16);
			const dark = ((rgb >> 16) & 255) * 0.299 + ((rgb >> 8) & 255) * 0.587 + (rgb & 255) * 0.114 < 128;
			layers = [0, 1, 2].map((i) => ({
				color: hslToHex((hue + i * 70) % 360, 80, dark ? 55 : 75),
				x: Math.round(Math.random() * 100),
				y: Math.round(Math.random() * 100),
				size: 45 + Math.round(Math.random() * 25),
				opacity: 70 + Math.round(Math.random() * 25),
				blend: dark ? 'screen' : 'multiply',
			}));
			render();
		});
		copyButton(byId('au-copy'), () => byId('au-css').textContent ?? '');

		byId('au-png').addEventListener('click', () => {
			const w = 1600;
			const h = 900;
			const canvas = document.createElement('canvas');
			canvas.width = w;
			canvas.height = h;
			const ctx = canvas.getContext('2d')!;
			ctx.fillStyle = base.value;
			ctx.fillRect(0, 0, w, h);
			for (const l of layers) {
				const cx = (l.x / 100) * w;
				const cy = (l.y / 100) * h;
				const g = ctx.createRadialGradient(0, 0, 0, 0, 0, 1);
				g.addColorStop(0, rgba(l.color, l.opacity));
				g.addColorStop(1, rgba(l.color, 0));
				ctx.save();
				ctx.translate(cx, cy);
				ctx.scale((l.size / 100) * w, (l.size / 100) * h);
				ctx.globalCompositeOperation = l.blend === 'normal' ? 'source-over' : (l.blend as GlobalCompositeOperation);
				ctx.fillStyle = g;
				ctx.fillRect(-cx / ((l.size / 100) * w), -cy / ((l.size / 100) * h), 1 / (l.size / 100), 1 / (l.size / 100));
				ctx.restore();
			}
			if (grain.checked) {
				const noise = ctx.createImageData(w, h);
				for (let i = 0; i < noise.data.length; i += 4) {
					const v = Math.random() * 255;
					noise.data[i] = noise.data[i + 1] = noise.data[i + 2] = v;
					noise.data[i + 3] = 70;
				}
				const layer = document.createElement('canvas');
				layer.width = w;
				layer.height = h;
				layer.getContext('2d')!.putImageData(noise, 0, 0);
				ctx.globalCompositeOperation = 'overlay';
				ctx.drawImage(layer, 0, 0);
			}
			canvas.toBlob((blob) => {
				if (!blob) return;
				const link = document.createElement('a');
				link.href = URL.createObjectURL(blob);
				link.download = 'aura.png';
				link.click();
				URL.revokeObjectURL(link.href);
			});
		});

		render();
	});
</script>

<style>
	.au-stage {
		min-height: 280px;
		border-radius: 14px;
		border: 1px solid var(--border);
	}
	.au-layers {
		list-style: none;
		margin: 0;
		padding: 6px 14px;
	}
	.au-layers :global(li) {
		display: flex;
		flex-wrap: wrap;
		gap: 10px 16px;
		align-items: center;
		padding: 10px 0;
		border-bottom: 1px solid var(--border);
	}
	.au-layers :global(li:last-child) {
		border-bottom: 0;
	}
	.au-layers :global(input[type='color']),
	.toolbar :global(input[type='color']) {
		width: 44px;
		height: 30px;
		border: 1px solid var(--border);
		border-radius: 8px;
		background: transparent;
	}
	.au-layers :global(.au-field) {
		display: grid;
		gap: 2px;
		font-size: 12px;
		color: var(--ink-soft);
	}
	.au-layers :global(input[type='range']) {
		width: 110px;
		accent-color: var(--accent-strong);
	}
	.au-actions {
		display: flex;
		gap: 8px;
	}
	.au-css {
		min-height: auto !important;
		white-space: pre-wrap;
		word-break: break-all;
	}
</style>
