</style>
</head>
<body class="body-bg" style="margin:0;padding:0;background-color:#F2F2F2;">
<div style="display:none;max-height:0;overflow:hidden;opacity:0;mso-hide:all;">Your order has shipped&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;</div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" class="body-bg" style="background-color:#F2F2F2;">
  <tr><td align="center" style="padding:32px 16px;">
    <table role="presentation" class="wrapper" width="600" cellpadding="0" cellspacing="0" border="0" style="width:600px;max-width:600px;">

      <tr><td class="pad-x" style="padding:0 6px 24px;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
          <tr><td class="ink-soft" style="font-family:'JetBrains Mono','Courier New',Courier,monospace;font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:#707070;padding-bottom:10px;">Order #48213</td></tr>
          <tr><td class="ink" style="font-family:'Lato',Arial,Helvetica,sans-serif;font-size:21px;font-weight:bold;color:#2F2F2F;padding-bottom:12px;">Your order has shipped</td></tr>
          <tr><td class="ink-soft" style="font-family:'Lato',Arial,Helvetica,sans-serif;font-size:14px;line-height:22px;color:#505050;">
            Good news — your package is on its way. Track it any time from the link below.
          </td></tr>
        </table>
      </td></tr>

  <tr><td style="padding-bottom:30px;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
      <tr><td style="background-color:#2f6fed;border-radius:10px 10px 0 0;padding:14px 20px 34px;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
          <tr><td style="font-family:'JetBrains Mono','Courier New',Courier,monospace;font-size:11px;letter-spacing:.15em;text-transform:uppercase;color:#dbe6ff;padding-bottom:8px;">Shipment</td></tr>
          <tr><td class="subject" style="font-family:'Lato',Arial,Helvetica,sans-serif;font-size:19px;line-height:25px;font-weight:bold;color:#ffffff;">Wireless keyboard, walnut</td></tr>
        </table>
      </td></tr>
      <tr><td class="card-bg" style="background-color:#ffffff;padding:0 20px;">
        <div style="margin-top:-22px;">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#1F1F1F;border-radius:8px;">
            <tr>
              <td class="item-cell" width="50%" style="padding:14px 16px;vertical-align:top;">
                <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                  <tr><td style="font-family:'JetBrains Mono','Courier New',Courier,monospace;font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:#9a9a9a;padding-bottom:4px;">Carrier</td></tr>
                  <tr><td style="font-family:'JetBrains Mono','Courier New',Courier,monospace;font-size:12.5px;color:#ffffff;">Parcel Express</td></tr>
                </table>
              </td>
              <td class="item-cell" width="50%" style="padding:14px 16px;vertical-align:top;">
                <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                  <tr><td style="font-family:'JetBrains Mono','Courier New',Courier,monospace;font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:#9a9a9a;padding-bottom:4px;">Tracking number</td></tr>
                  <tr><td style="font-family:'JetBrains Mono','Courier New',Courier,monospace;font-size:12.5px;color:#ffffff;">PX-88213-FR</td></tr>
                </table>
              </td>
            </tr>
          </table>
        </div>
      </td></tr>
      <tr><td class="card-bg" style="background-color:#ffffff;padding:18px 26px 4px;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
          <tr><td style="font-family:'JetBrains Mono','Courier New',Courier,monospace;font-size:11.5px;color:#505050;">Estimated delivery: 2 business days</td></tr>
          <tr><td align="right" style="padding-top:6px;">
            <span style="font-family:'JetBrains Mono','Courier New',Courier,monospace;font-size:11px;font-weight:bold;text-transform:uppercase;padding:4px 10px;border-radius:4px;background-color:#e4f9ee;color:#0c7a45;display:inline-block;">In transit</span>
          </td></tr>
        </table>
      </td></tr>
      <tr><td class="card-bg" style="background-color:#ffffff;padding:6px 26px 28px;border-radius:0 0 10px 10px;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
          <tr><td align="center" style="padding-top:8px;">
            <a href="#" style="display:inline-block;background-color:#2f6fed;color:#ffffff;font-family:'Lato',Arial,Helvetica,sans-serif;font-size:13.5px;font-weight:bold;padding:11px 22px;border-radius:6px;text-decoration:none;">Track your package</a>
          </td></tr>
        </table>
      </td></tr>
    </table>
  </td></tr>

      <tr><td class="pad-x" style="padding:12px 6px 32px;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
          <tr><td class="ink" style="font-family:'Lato',Arial,Helvetica,sans-serif;font-size:14px;color:#2F2F2F;padding-bottom:18px;">Thanks for your order!</td></tr>
          <tr><td class="hairline ink-soft" style="border-top:1px solid #BDBDBD;padding-top:14px;font-family:'JetBrains Mono','Courier New',Courier,monospace;font-size:11px;color:#707070;">
            Automated shipping notification &middot; example-shop.test
          </td></tr>
        </table>
      </td></tr>

    </table>
  </td></tr>
</table>
</body>
</html>
`;

		(function () {
			'use strict';

			var CLIENTS = [
				{ id: 'outlook-desktop', name: 'Outlook Desktop', engine: 'Word rendering engine', group: 'outlook' },
				{ id: 'outlook-com', name: 'Outlook.com', engine: 'Modern webmail', group: 'outlook' },
				{ id: 'gmail', name: 'Gmail', engine: 'Webmail (Chromium-based)' },
				{ id: 'apple-mail', name: 'Apple Mail', engine: 'WebKit (macOS / iOS)' },
				{ id: 'thunderbird', name: 'Thunderbird', engine: 'Gecko (desktop)' },
			];

			var FEATURES = [
				{
					id: 'border-radius',
					label: 'border-radius',
					support: {
						'outlook-desktop': { status: 'no', note: 'Rendered as square corners.' },
						gmail: { status: 'yes', note: '' },
						'apple-mail': { status: 'yes', note: '' },
						'outlook-com': { status: 'yes', note: '' },
						thunderbird: { status: 'yes', note: '' },
					},
					strip: { re: /border-radius\s*:[^;"']+;?/gi },
				},
				{
					id: 'box-shadow',
					label: 'box-shadow',
					support: {
						'outlook-desktop': { status: 'no', note: 'Ignored entirely.' },
						gmail: { status: 'yes', note: '' },
						'apple-mail': { status: 'yes', note: '' },
						'outlook-com': { status: 'yes', note: '' },
						thunderbird: { status: 'yes', note: '' },
					},
					strip: { re: /box-shadow\s*:[^;"']+;?/gi },
				},
				{
					id: 'position',
					label: 'position (fixed/sticky/absolute)',
					support: {
						'outlook-desktop': { status: 'no', note: 'Word engine ignores non-static positioning.' },
						gmail: { status: 'partial', note: 'fixed/sticky stripped, static/relative fine.' },
						'apple-mail': { status: 'yes', note: '' },
						'outlook-com': { status: 'partial', note: 'fixed/sticky stripped.' },
						thunderbird: { status: 'yes', note: '' },
					},
					strip: { re: /position\s*:[^;"']+;?/gi, only: ['outlook-desktop'] },
				},
				{
					id: 'position-fixed',
					label: '',
					support: {},
					strip: { re: /position\s*:\s*(fixed|sticky)[^;"']*;?/gi, only: ['gmail', 'outlook-com'] },
					hidden: true,
				},
				{
					id: 'negative-margin',
					label: 'negative margins',
					support: {
						'outlook-desktop': {
							status: 'no',
							note: 'Common overlap trick (float a bar over a banner) collapses.',
						},
						gmail: { status: 'yes', note: '' },
						'apple-mail': { status: 'yes', note: '' },
						'outlook-com': { status: 'yes', note: '' },
						thunderbird: { status: 'yes', note: '' },
					},
					strip: { re: /margin(-top|-bottom|-left|-right)?\s*:\s*-[^;"']+;?/gi, only: ['outlook-desktop'] },
				},
				{
					id: 'flex-grid',
					label: 'flex / grid layout',
					support: {
						'outlook-desktop': { status: 'no', note: 'Table layout only.' },
						gmail: { status: 'yes', note: '' },
						'apple-mail': { status: 'yes', note: '' },
						'outlook-com': { status: 'yes', note: '' },
						thunderbird: { status: 'partial', note: 'Gecko supports it, but older ESR releases lag behind.' },
					},
					strip: { re: /display\s*:\s*(inline-flex|flex|grid|inline-grid)[^;"']*;?/gi, only: ['outlook-desktop'] },
				},
				{
					id: 'background-image',
					label: 'background-image',
					support: {
						'outlook-desktop': { status: 'no', note: 'Needs a VML fallback to show at all.' },
						gmail: { status: 'yes', note: '' },
						'apple-mail': { status: 'yes', note: '' },
						'outlook-com': { status: 'yes', note: '' },
						thunderbird: { status: 'yes', note: '' },
					},
					strip: { re: /background-image\s*:[^;"']+;?/gi, only: ['outlook-desktop'] },
				},
				{
					id: 'web-fonts',
					label: 'web fonts (Google Fonts link)',
					support: {
						'outlook-desktop': { status: 'no', note: 'Falls back to the next font in the stack.' },
						gmail: { status: 'no', note: 'External stylesheets are stripped from the head.' },
						'apple-mail': { status: 'yes', note: '' },
						'outlook-com': { status: 'no', note: 'External stylesheets are stripped from the head.' },
						thunderbird: { status: 'no', note: 'Remote content (incl. external stylesheets) is blocked by default.' },
					},
					strip: { link: true, only: ['outlook-desktop', 'gmail', 'outlook-com', 'thunderbird'] },
				},
				{
					id: 'media-queries',
					label: '@media queries',
					support: {
						'outlook-desktop': { status: 'no', note: 'No responsive behaviour at all; design for the fixed width.' },
						gmail: { status: 'yes', note: '' },
						'apple-mail': { status: 'yes', note: '' },
						'outlook-com': { status: 'yes', note: '' },
						thunderbird: { status: 'yes', note: '' },
					},
					strip: { mediaBlock: true, only: ['outlook-desktop'] },
				},
				{
					id: 'gradient',
					label: 'linear-gradient background',
					support: {
						'outlook-desktop': { status: 'no', note: 'Needs a VML fallback; falls back to a flat color.' },
						gmail: { status: 'yes', note: '' },
						'apple-mail': { status: 'yes', note: '' },
						'outlook-com': { status: 'partial', note: 'Inconsistent across the mobile app vs. web.' },
						thunderbird: { status: 'yes', note: '' },
					},
				},
				{
					id: 'hover',
					label: ':hover pseudo-class',
					support: {
						'outlook-desktop': { status: 'no', note: 'No pointer interaction model.' },
						gmail: { status: 'partial', note: 'Works on web, not in most mobile apps.' },
						'apple-mail': { status: 'yes', note: '' },
						'outlook-com': { status: 'partial', note: 'Web only.' },
						thunderbird: { status: 'yes', note: 'Desktop mouse pointer, so :hover works.' },
					},
				},
				{
					id: 'css-vars',
					label: 'CSS custom properties (var())',
					support: {
						'outlook-desktop': { status: 'no', note: 'Use literal values, not var().' },
						gmail: { status: 'partial', note: 'Inconsistent between app and web.' },
						'apple-mail': { status: 'yes', note: '' },
						'outlook-com': { status: 'no', note: '' },
						thunderbird: { status: 'partial', note: 'Supported by Gecko, but sanitizer strips some declarations.' },
					},
				},
				{
					id: 'font-face',
					label: '@font-face (embedded font)',
					support: {
						'outlook-desktop': { status: 'no', note: "Always falls back to the stack's next entry." },
						gmail: { status: 'no', note: '' },
						'apple-mail': { status: 'yes', note: '' },
						'outlook-com': { status: 'no', note: '' },
						thunderbird: { status: 'no', note: 'Blocked by the same remote-content policy as web fonts.' },
					},
				},
			];

			var els = {
				tabs: document.getElementById('tabs'),
				clientSubtabs: document.getElementById('clientSubtabs'),
				subtabDesktopLight: document.getElementById('subtab-desktop-light'),
				subtabDesktopDark: document.getElementById('subtab-desktop-dark'),
				subtabMobileLight: document.getElementById('subtab-mobile-light'),
				subtabMobileDark: document.getElementById('subtab-mobile-dark'),
				subtabConditions: document.getElementById('subtab-conditions'),
				sampleBtn: document.getElementById('sampleBtn'),
				applyBtn: document.getElementById('applyBtn'),
				source: document.getElementById('source'),
				viewPreview: document.getElementById('viewPreview'),
				viewConditions: document.getElementById('viewConditions'),
				viewHtml: document.getElementById('viewHtml'),
				preview: document.getElementById('preview'),
			};

			var HTML_TAB_ID = '__html__';
			var activeClientId = CLIENTS[0].id;
			var activeSubtab = 'desktop-light';
			var rawHtml = SAMPLE_HTML;

			function extractDarkMediaBlocks(css: string) {
				var result: { start: number; end: number; body: string }[] = [];
				var re = /@media\s*\(\s*prefers-color-scheme\s*:\s*dark\s*\)\s*\{/gi;
				var match;
				while ((match = re.exec(css))) {
					var start = match.index;
					var bodyStart = re.lastIndex;
					var depth = 1;
					var i = bodyStart;
					for (; i < css.length && depth > 0; i++) {
						if (css[i] === '{') depth++;
						else if (css[i] === '}') depth--;
					}
					result.push({ start: start, end: i, body: css.slice(bodyStart, i - 1) });
					re.lastIndex = i;
				}
				return result;
			}

			function applyColorScheme(html: string, theme: string) {
				return html.replace(/<style\b[^>]*>([\s\S]*?)<\/style>/gi, function (full, body) {
					var blocks = extractDarkMediaBlocks(body);
					if (!blocks.length) return full;
					var out = '';
					var last = 0;
					blocks.forEach(function (b) {
						out += body.slice(last, b.start);
						out += theme === 'dark' ? b.body : '';
						last = b.end;
					});
					out += body.slice(last);
					return full.replace(body, out);
				});
			}

			function stripMediaBlocks(html) {
				return html.replace(/<style\b[^>]*>([\s\S]*?)<\/style>/gi, function (full, body) {
					var cleaned = body.replace(/@media[^{]*\{([\s\S]*?\})\s*\}/gi, '');
					return full.replace(body, cleaned);
				});
			}
			function stripExternalFonts(html) {
				return html.replace(
					/<link[^>]+href=["'][^"']*fonts\.googleapis\.com[^"']*["'][^>]*>/gi,
					'<!-- web font link removed by this client -->'
				);
			}

			function transformForClient(html, clientId) {
				var out = html;
				FEATURES.forEach(function (f) {
					if (!f.strip) return;
					var only = f.strip.only;
					if (only && only.indexOf(clientId) === -1) return;
					if (f.strip.link) out = stripExternalFonts(out);
					else if (f.strip.mediaBlock) out = stripMediaBlocks(out);
					else if (f.strip.re) out = out.replace(f.strip.re, '');
				});
				return out;
			}

			function selectTab(id: string) {
				activeClientId = id;
				Array.prototype.forEach.call(els.tabs!.children, function (el: HTMLElement) {
					el.setAttribute('aria-selected', String(el.dataset.tabId === id));
				});
				var isHtml = id === HTML_TAB_ID;
				(els.clientSubtabs as HTMLElement).style.display = isHtml ? 'none' : '';
				if (isHtml) {
					(els.viewHtml as HTMLElement).style.display = '';
					(els.viewPreview as HTMLElement).style.display = 'none';
					(els.viewConditions as HTMLElement).style.display = 'none';
					(els.source as HTMLTextAreaElement).value = rawHtml;
				} else {
					setSubtab(activeSubtab);
				}
			}

			function setSubtab(name: string) {
				activeSubtab = name;
				els.subtabDesktopLight!.setAttribute('aria-selected', String(name === 'desktop-light'));
				els.subtabDesktopDark!.setAttribute('aria-selected', String(name === 'desktop-dark'));
				els.subtabMobileLight!.setAttribute('aria-selected', String(name === 'mobile-light'));
				els.subtabMobileDark!.setAttribute('aria-selected', String(name === 'mobile-dark'));
				els.subtabConditions!.setAttribute('aria-selected', String(name === 'conditions'));
				(els.viewHtml as HTMLElement).style.display = 'none';
				(els.viewPreview as HTMLElement).style.display = name === 'conditions' ? 'none' : '';
				(els.viewConditions as HTMLElement).style.display = name === 'conditions' ? '' : 'none';
				if (name !== 'conditions') {
					(els.preview as HTMLIFrameElement).className = name.indexOf('mobile') === 0 ? 'mobile' : 'desktop';
				}
				render();
			}

			function buildTabs() {
				els.tabs!.innerHTML = '';

				var htmlBtn = document.createElement('button');
				htmlBtn.className = 'tab';
				htmlBtn.setAttribute('role', 'tab');
				htmlBtn.dataset.tabId = HTML_TAB_ID;
				htmlBtn.textContent = 'HTML';
				htmlBtn.addEventListener('click', function () {
					selectTab(HTML_TAB_ID);
				});
				els.tabs!.appendChild(htmlBtn);

				CLIENTS.forEach(function (client, i) {
					var btn = document.createElement('button');
					var nextIsSameGroup = CLIENTS[i + 1] && client.group && CLIENTS[i + 1].group === client.group;
					btn.className = 'tab' + (client.group && !nextIsSameGroup ? ' group-end' : '');
					btn.setAttribute('role', 'tab');
					btn.dataset.tabId = client.id;
					btn.setAttribute('aria-selected', String(client.id === activeClientId));
					btn.textContent = client.name;
					btn.title = client.engine;
					btn.addEventListener('click', function () {
						selectTab(client.id);
					});
					els.tabs!.appendChild(btn);
				});
			}

			var ICONS: Record<string, string> = { yes: '✓', partial: '~', no: '✕' };

			function renderConditions() {
				var rows = FEATURES.filter(function (f) {
					return !f.hidden;
				});

				var html =
					'<table class="support"><caption>CSS feature support across mail clients</caption><thead><tr><th>CSS feature</th>';
				CLIENTS.forEach(function (c) {
					html += '<th class="center">' + c.name + '</th>';
				});
				html += '</tr></thead><tbody>';

				rows.forEach(function (f) {
					html += '<tr><td>' + f.label + '</td>';
					CLIENTS.forEach(function (c) {
						var entry = (f.support as any)[c.id] || { status: 'yes', note: '' };
						var title = entry.note
							? entry.note.replace(/"/g, '&quot;')
							: entry.status === 'yes'
								? 'Fully supported'
								: '';
						html +=
							'<td class="center" title="' +
							title +
							'"><span class="badge icon ' +
							entry.status +
							'">' +
							ICONS[entry.status] +
							'</span></td>';
					});
					html += '</tr>';
				});
				html += '</tbody></table>';
				html +=
					'<div class="legend">' +
					'<span><span class="badge icon yes">' +
					ICONS.yes +
					'</span> Supported</span>' +
					'<span><span class="badge icon partial">' +
					ICONS.partial +
					'</span> Partial</span>' +
					'<span><span class="badge icon no">' +
					ICONS.no +
					'</span> Not supported</span>' +
					'<span>Hover a cell for details</span></div>';
				els.viewConditions!.innerHTML = html;
			}

			function render() {
				if (activeSubtab === 'conditions') {
					renderConditions();
					return;
				}
				var theme = activeSubtab.indexOf('dark') !== -1 ? 'dark' : 'light';
				var transformed = transformForClient(rawHtml, activeClientId);
				transformed = applyColorScheme(transformed, theme);
				(els.preview as HTMLIFrameElement).style.colorScheme = theme;
				(els.preview as HTMLIFrameElement).srcdoc = transformed;
			}

			els.sampleBtn!.addEventListener('click', function () {
				rawHtml = SAMPLE_HTML;
				(els.source as HTMLTextAreaElement).value = rawHtml;
				render();
			});
			els.applyBtn!.addEventListener('click', function () {
				rawHtml = (els.source as HTMLTextAreaElement).value;
				render();
			});
			els.subtabDesktopLight!.addEventListener('click', function () {
				setSubtab('desktop-light');
			});
			els.subtabDesktopDark!.addEventListener('click', function () {
				setSubtab('desktop-dark');
			});
			els.subtabMobileLight!.addEventListener('click', function () {
				setSubtab('mobile-light');
			});
			els.subtabMobileDark!.addEventListener('click', function () {
				setSubtab('mobile-dark');
			});
			els.subtabConditions!.addEventListener('click', function () {
				setSubtab('conditions');
			});

			buildTabs();
			render();
		})();
	</script>
</Base>

