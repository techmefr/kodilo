---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
---

<Base
	title="Inbox Tester — kodilo"
	description="Preview an HTML email as Gmail, Outlook, Yahoo Mail and Apple Mail would show it, on desktop and mobile, in light and dark mode."
>
	<div class="shell">
		<Header activeSlug="inbox-tester" />
		<main class="main">
			<div class="app">
				<div class="topbar">
					<h1>Inbox Tester</h1>
					<div class="tabs" id="tabs" role="tablist"></div>
				</div>

				<div class="subtabs" id="clientSubtabs" role="tablist">
					<button class="subtab" role="tab" id="subtab-desktop-light" aria-selected="true">
						Preview Desktop <span class="subtab-theme">☀ Light</span>
					</button>
					<button class="subtab" role="tab" id="subtab-desktop-dark" aria-selected="false">
						Preview Desktop <span class="subtab-theme">☾ Dark</span>
					</button>
					<button class="subtab" role="tab" id="subtab-mobile-light" aria-selected="false">
						Preview Mobile <span class="subtab-theme">☀ Light</span>
					</button>
					<button class="subtab" role="tab" id="subtab-mobile-dark" aria-selected="false">
						Preview Mobile <span class="subtab-theme">☾ Dark</span>
					</button>
					<button class="subtab" role="tab" id="subtab-conditions" aria-selected="false">
						Conditions
					</button>
				</div>

				<div class="content">
					<div id="viewPreview">
						<p class="dark-note" id="darkNote" hidden></p>
						<div class="frame-stage">
							<iframe id="preview" class="desktop" title="Client preview" sandbox="allow-same-origin"></iframe>
						</div>
					</div>
					<div id="viewConditions" style="display:none;"></div>
					<div id="viewHtml" style="display:none;padding:12px;">
						<textarea id="source" spellcheck="false"></textarea>
						<div style="margin-top:8px;display:flex;gap:8px;">
							<button id="applyBtn" style="background:var(--accent-strong);color:var(--accent-ink);border-color:transparent;font-weight:600;">
								Apply
							</button>
							<button id="sampleBtn">Load sample</button>
						</div>
					</div>
				</div>

				<footer>
					Support data hand-curated from publicly documented client behaviour (see{' '}
					<a href="https://www.caniemail.com" target="_blank" rel="noopener">
						caniemail.com
					</a>
					) — a first pass, not a QA sign-off.
				</footer>
			</div>
		</main>
	</div>

