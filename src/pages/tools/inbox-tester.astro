		document.addEventListener('astro:page-load', function () {
			if (!document.getElementById('preview')) return;

			const CLIENTS = [
				{ id: 'outlook-desktop', name: 'Outlook Desktop', engine: 'Word rendering engine', group: 'outlook', dark: 'partial' },
