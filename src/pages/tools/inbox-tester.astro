				{ id: 'gmail', name: 'Gmail', engine: 'Webmail (Chromium-based)', dark: 'full' },
				{ id: 'yahoo', name: 'Yahoo Mail', engine: 'Webmail and mobile apps', dark: 'partial' },
				{ id: 'apple-mail', name: 'Apple Mail', engine: 'WebKit (macOS / iOS)', dark: 'media' },
				{ id: 'thunderbird', name: 'Thunderbird', engine: 'Gecko (desktop)', dark: 'media' },
			];
			const DARK_NOTES: Record<string, string> = {
				media: 'Dark mode: this client applies your @media (prefers-color-scheme: dark) styles and leaves the rest untouched.',
				partial: 'Dark mode: this client ignores prefers-color-scheme and inverts light backgrounds and dark text on its own.',
