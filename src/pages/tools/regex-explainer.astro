---
import ToolShell from '../../components/ToolShell.astro';

const examples = [
	{ label: 'email', pattern: '^[\\w.+-]+@[\\w-]+\\.[a-z]{2,}$', flags: 'i' },
	{ label: 'ISO date', pattern: '(?<year>\\d{4})-(?<month>0[1-9]|1[0-2])-(?<day>\\d{2})', flags: '' },
	{ label: 'hex color', pattern: '^#(?:[0-9a-f]{3}){1,2}$', flags: 'i' },
	{ label: 'password rule', pattern: '^(?=.*\\d)(?=.*[A-Z]).{8,}$', flags: '' },
	{ label: 'repeated word', pattern: '\\b(\\w+)\\s+\\1\\b', flags: 'gi' },
];
---

<ToolShell slug="regex-explainer" title="Regex Explainer" description="Break a regular expression into tokens and read what each one does in plain English.">
	<div class="fields" id="rx-tool">
		<div class="field wide" id="rx-field">
			<label for="rx-pattern">Regular expression</label>
			<input id="rx-pattern" spellcheck="false" autocomplete="off" value={examples[0].pattern} />
			<span class="field-note" id="rx-note"></span>
		</div>
		<div class="field">
			<label for="rx-flags">Flags</label>
			<input id="rx-flags" spellcheck="false" autocomplete="off" value={examples[0].flags} />
		</div>
	</div>
	<div class="chips" id="rx-examples">
		{examples.map((e) => (
			<button data-pattern={e.pattern} data-flags={e.flags}>
				{e.label}
			</button>
		))}
	</div>
	<section class="panel">
		<div class="panel-head">
			<span id="rx-count">Tokens</span>
			<button class="btn" id="rx-copy">
				Copy
			</button>
		</div>
		<ol class="rx-list" id="rx-list" tabindex="0" aria-label="Token explanations"></ol>
	</section>
	<ul class="rx-flags" id="rx-flag-list" aria-label="Flag explanations"></ul>
</ToolShell>

<script>
	import { byId, copyButton, onPage } from '../../scripts/ui';

	type Token = { text: string; desc: string; depth: number };

	const ESCAPES: Record<string, string> = {
		d: 'any digit (0-9)',
		D: 'any character that is not a digit',
		w: 'any word character (letter, digit or underscore)',
		W: 'any character that is not a word character',
		s: 'any whitespace character',
		S: 'any character that is not whitespace',
		b: 'a word boundary',
		B: 'a position that is not a word boundary',
		n: 'a newline',
		r: 'a carriage return',
		t: 'a tab',
		f: 'a form feed',
		v: 'a vertical tab',
		'0': 'a null character',
	};

	const FLAGS: Record<string, string> = {
		g: 'global: find every match, not just the first',
		i: 'ignore case: letters match in upper or lower case',
		m: 'multiline: ^ and $ match at the start and end of each line',
		s: 'dotAll: . also matches newlines',
		u: 'unicode: treat the pattern as a sequence of Unicode code points',
		v: 'unicode sets: extended Unicode mode with set operations in classes',
		y: 'sticky: match only at the current lastIndex position',
		d: 'indices: report the start and end index of each capture',
	};

	const quantifier = (q: string) => {
		const lazy = q.length > 1 && q.endsWith('?') && q !== '?';
		const core = lazy ? q.slice(0, -1) : q;
		let text: string;
		if (core === '*') text = 'zero or more times';
		else if (core === '+') text = 'one or more times';
		else if (core === '?') text = 'optionally (zero or one time)';
		else {
			const [min, max] = core.slice(1, -1).split(',');
			if (max === undefined) text = `exactly ${min} ${min === '1' ? 'time' : 'times'}`;
			else if (max === '') text = `at least ${min} times`;
			else text = `between ${min} and ${max} times`;
		}
		return `${text}${lazy ? ', as few as possible' : core === '?' || core.startsWith('{') ? '' : ', as many as possible'}`;
	};

	const escapeDesc = (c: string) => {
		if (ESCAPES[c]) return ESCAPES[c];
		if (/[1-9]/.test(c)) return `the same text as capture group ${c}`;
		return `the literal character "${c}"`;
	};

	const classDesc = (body: string) => {
		const negated = body.startsWith('^');
		const src = negated ? body.slice(1) : body;
		const parts: string[] = [];
		for (let i = 0; i < src.length; i++) {
			let c = src[i];
			if (c === '\\') {
				c = src[++i] ?? '';
				if (ESCAPES[c] && /[dDwWsS]/.test(c)) {
					parts.push(ESCAPES[c].replace(/^any /, ''));
					continue;
				}
				c = c === 'n' ? 'newline' : c === 't' ? 'tab' : c;
			}
			if (src[i + 1] === '-' && i + 2 < src.length) {
				let end = src[i + 2];
				let skip = 2;
				if (end === '\\') {
					end = src[i + 3];
					skip = 3;
				}
				parts.push(`${c} to ${end}`);
				i += skip;
			} else parts.push(`"${c}"`);
		}
		const list = parts.length > 1 ? `${parts.slice(0, -1).join(', ')} or ${parts[parts.length - 1]}` : (parts[0] ?? 'nothing');
		return `${negated ? 'any character except' : 'one character from'}: ${list}`;
	};

	const tokenize = (p: string): Token[] => {
		const out: Token[] = [];
		let depth = 0;
		let i = 0;
		while (i < p.length) {
			const c = p[i];
			let text = c;
			let desc: string;
			if (c === '\\') {
				const m = /^\\(u\{[0-9a-fA-F]+\}|u[0-9a-fA-F]{4}|x[0-9a-fA-F]{2}|c[A-Za-z]|[pP]\{[^}]+\}|k<[^>]+>|[1-9]\d*|.)/.exec(p.slice(i));
				text = m ? m[0] : '\\';
				const e = text.slice(1);
				if (/^[pP]\{/.test(e)) desc = `${e[0] === 'P' ? 'a character without' : 'a character with'} the Unicode property ${e.slice(2, -1)}`;
				else if (e.startsWith('k<')) desc = `the same text as the group named "${e.slice(2, -1)}"`;
				else if (/^u|^x/.test(e) && e.length > 1) desc = `the character with code ${e.replace(/[ux{}]/g, '').toUpperCase()}`;
				else if (/^c./.test(e)) desc = `the control character Ctrl+${e[1].toUpperCase()}`;
				else desc = escapeDesc(e);
			} else if (c === '[') {
				let j = i + 1;
				if (p[j] === '^') j++;
				if (p[j] === ']') j++;
				while (j < p.length && p[j] !== ']') j += p[j] === '\\' ? 2 : 1;
				text = p.slice(i, j + 1);
				desc = classDesc(p.slice(i + 1, j));
			} else if (c === '(') {
				const m = /^\((\?:|\?=|\?!|\?<=|\?<!|\?<([A-Za-z_$][\w$]*)>)?/.exec(p.slice(i))!;
				text = m[0];
				const kind = m[1];
				if (!kind) desc = 'start of a capture group';
				else if (kind === '?:') desc = 'start of a non-capturing group';
				else if (kind === '?=') desc = 'start of a lookahead: what follows must match';
				else if (kind === '?!') desc = 'start of a negative lookahead: what follows must not match';
				else if (kind === '?<=') desc = 'start of a lookbehind: what precedes must match';
				else if (kind === '?<!') desc = 'start of a negative lookbehind: what precedes must not match';
				else desc = `start of a capture group named "${m[2]}"`;
				out.push({ text, desc, depth });
				depth++;
				i += text.length;
				continue;
			} else if (c === ')') {
				depth = Math.max(0, depth - 1);
				desc = 'end of the group';
			} else if (c === '|') desc = 'or: the alternative on the right';
			else if (c === '^') desc = 'the start of the string (or line in multiline mode)';
			else if (c === '$') desc = 'the end of the string (or line in multiline mode)';
			else if (c === '.') desc = 'any character except a newline';
			else if (/[*+?{]/.test(c)) {
				const m = /^(\*|\+|\?|\{\d+(,\d*)?\})\??/.exec(p.slice(i));
				if (m) {
					text = m[0];
					desc = `repeat the previous item ${quantifier(text)}`;
				} else desc = `the literal character "${c}"`;
			} else desc = c === ' ' ? 'a space' : `the literal character "${c}"`;
			if (out.length && desc.startsWith('the literal character') && out[out.length - 1].desc.startsWith('the literal')) {
				const prev = out[out.length - 1];
				if (!/[*+?{]/.test(p[i + 1] ?? '')) {
					prev.text += text;
					prev.desc = `the literal text "${prev.text.replace(/\\/g, '')}"`;
					i += text.length;
					continue;
				}
			}
			out.push({ text, desc, depth });
			i += text.length;
		}
		return out;
	};

	onPage('rx-tool', () => {
		const pattern = byId<HTMLInputElement>('rx-pattern');
		const flags = byId<HTMLInputElement>('rx-flags');
		const list = byId('rx-list');
		let tokens: Token[] = [];

		const render = () => {
			try {
				new RegExp(pattern.value, flags.value);
				byId('rx-field').classList.remove('invalid');
				byId('rx-note').textContent = '';
			} catch (e) {
				byId('rx-field').classList.add('invalid');
				byId('rx-note').textContent = (e as Error).message;
			}
			tokens = tokenize(pattern.value);
			byId('rx-count').textContent = `${tokens.length} ${tokens.length === 1 ? 'token' : 'tokens'}`;
			list.replaceChildren(
				...tokens.map((t) => {
					const li = document.createElement('li');
					li.style.setProperty('--depth', String(t.depth));
					const code = document.createElement('code');
					code.textContent = t.text;
					const span = document.createElement('span');
					span.textContent = t.desc;
					li.append(code, span);
					return li;
				}),
			);
			byId('rx-flag-list').replaceChildren(
				...[...new Set(flags.value)].map((f) => {
					const li = document.createElement('li');
					const code = document.createElement('code');
					code.textContent = f;
					li.append(code, ` ${FLAGS[f] ?? 'unknown flag'}`);
					return li;
				}),
			);
		};

		byId('rx-examples')
			.querySelectorAll<HTMLButtonElement>('button')
			.forEach((b) =>
				b.addEventListener('click', () => {
					pattern.value = b.dataset.pattern ?? '';
					flags.value = b.dataset.flags ?? '';
					render();
				}),
			);
		pattern.addEventListener('input', render);
		flags.addEventListener('input', render);
		copyButton(byId('rx-copy'), () => tokens.map((t) => `${'  '.repeat(t.depth)}${t.text}  ${t.desc}`).join('\n'));
		render();
	});
</script>

<style>
	.rx-list {
		list-style: none;
		margin: 0;
		padding: 8px 0;
		max-height: 480px;
		overflow: auto;
	}
	.rx-list :global(li) {
		display: flex;
		gap: 12px;
		align-items: baseline;
		padding: 6px 14px 6px calc(14px + var(--depth, 0) * 18px);
		font-size: 14px;
		color: var(--ink);
		border-bottom: 1px solid var(--border);
	}
	.rx-list :global(li:last-child) {
		border-bottom: 0;
	}
	.rx-list :global(code),
	.rx-flags :global(code) {
		font-family: var(--mono);
		font-size: 13px;
		background: var(--surface-2);
		color: var(--ink);
		padding: 2px 6px;
		border-radius: 6px;
		word-break: break-all;
	}
	.rx-list :global(code) {
		flex: 0 0 auto;
		max-width: 45%;
	}
	.rx-list :global(span) {
		min-width: 0;
		overflow-wrap: anywhere;
	}
	.rx-flags {
		margin: 0;
		padding: 0;
		list-style: none;
		display: grid;
		gap: 6px;
		font-size: 14px;
		color: var(--ink-soft);
	}
	.chips :global(button) {
		font-size: 12px;
	}
</style>
