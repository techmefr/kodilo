---
import ToolShell from '../../components/ToolShell.astro';
---

<ToolShell
	slug="dns-record-builder"
	title="DNS Record Builder"
	description="Build zone file lines for A, AAAA, CNAME, MX, TXT, SPF, DMARC, CAA and SRV records, with validation."
>
	<div class="toolbar" id="dns-tool">
		<div class="seg" id="dns-type">
			<button data-value="A" aria-pressed="true">A</button>
			<button data-value="AAAA">AAAA</button>
			<button data-value="CNAME">CNAME</button>
			<button data-value="MX">MX</button>
			<button data-value="TXT">TXT</button>
			<button data-value="SPF">SPF</button>
			<button data-value="DMARC">DMARC</button>
			<button data-value="CAA">CAA</button>
			<button data-value="SRV">SRV</button>
		</div>
	</div>
	<div class="fields">
		<div class="field"><label for="dns-domain">Domain</label><input id="dns-domain" spellcheck="false" value="example.com" /></div>
		<div class="field"><label for="dns-name">Name</label><input id="dns-name" spellcheck="false" value="@" /><span class="field-note">@ for the domain itself</span></div>
		<div class="field"><label for="dns-ttl">TTL (seconds)</label><input id="dns-ttl" inputmode="numeric" value="3600" /></div>
		<div class="field" id="dns-value-field"><label for="dns-value" id="dns-value-label">Value</label><input id="dns-value" spellcheck="false" /><span class="field-note" id="dns-value-note"></span></div>
		<div class="field" id="dns-extra-field"><label for="dns-extra" id="dns-extra-label">Priority</label><input id="dns-extra" spellcheck="false" /></div>
	</div>
	<section class="panel">
		<div class="panel-head">
			<span>Zone file</span>
			<button class="btn" id="dns-copy">Copy</button>
		</div>
		<pre class="out dns-out" id="dns-out"></pre>
	</section>
</ToolShell>

<script>
	import { byId, copyButton, onPage, segmented } from '../../scripts/ui';

	const HOST = /^(?=.{1,253}\.?$)([a-z0-9_](?:[a-z0-9-_]{0,61}[a-z0-9])?\.)*[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\.?$/i;
	const IPV4 = /^((25[0-5]|2[0-4]\d|1?\d?\d)\.){3}(25[0-5]|2[0-4]\d|1?\d?\d)$/;
	const isIpv6 = (s: string) => {
		try {
			return s.includes(':') && new URL(`http://[${s}]`).hostname.length > 2;
		} catch {
			return false;
		}
	};

	type Spec = { label: string; sample: string; name?: string; extra?: [string, string]; note: string; check: (v: string) => boolean };
	const SPECS: Record<string, Spec> = {
		A: { label: 'IPv4 address', sample: '203.0.113.10', note: 'Points a name to an IPv4 address.', check: (v) => IPV4.test(v) },
		AAAA: { label: 'IPv6 address', sample: '2001:db8::10', note: 'Points a name to an IPv6 address.', check: isIpv6 },
		CNAME: { label: 'Target host', sample: 'app.hosting.net.', name: 'www', note: 'Cannot live at the apex (@) or next to other records.', check: (v) => HOST.test(v) },
		MX: { label: 'Mail server', sample: 'mx1.mail.example.com.', extra: ['Priority', '10'], note: 'Lower priority wins. Must point to a host, not an IP or CNAME.', check: (v) => HOST.test(v) && !IPV4.test(v) },
		TXT: { label: 'Text', sample: 'google-site-verification=abc123', note: 'Long values are split into 255-character strings automatically.', check: (v) => v.length > 0 },
		SPF: { label: 'Allowed senders', sample: 'include:_spf.google.com ip4:203.0.113.10', extra: ['Policy', '~all'], note: 'Only one SPF record per name. Max 10 DNS lookups.', check: (v) => !/v=spf1/i.test(v) },
		DMARC: { label: 'Report address', sample: 'dmarc@example.com', name: '_dmarc', extra: ['Policy', 'quarantine'], note: 'Policy: none, quarantine or reject.', check: (v) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v) },
		CAA: { label: 'Certificate authority', sample: 'letsencrypt.org', extra: ['Tag', 'issue'], note: 'Tag: issue, issuewild or iodef.', check: (v) => v.length > 0 },
		SRV: { label: 'Target host', sample: 'sip.example.com.', name: '_sip._tcp', extra: ['Priority weight port', '10 5 5060'], note: 'Name is _service._proto.', check: (v) => HOST.test(v) },
	};

	const quote = (text: string) => (text.match(/.{1,255}/g) ?? ['']).map((c) => `"${c.replace(/"/g, '\\"')}"`).join(' ');

	onPage('dns-tool', () => {
		const domain = byId<HTMLInputElement>('dns-domain');
		const name = byId<HTMLInputElement>('dns-name');
		const ttl = byId<HTMLInputElement>('dns-ttl');
		const value = byId<HTMLInputElement>('dns-value');
		const extra = byId<HTMLInputElement>('dns-extra');
		let type = 'A';

		const load = () => {
			const spec = SPECS[type];
			value.value = spec.sample;
			name.value = spec.name ?? '@';
			byId('dns-value-label').textContent = spec.label;
			byId('dns-extra-field').hidden = !spec.extra;
			if (spec.extra) {
				byId('dns-extra-label').textContent = spec.extra[0];
				extra.value = spec.extra[1];
			}
			render();
		};

		const render = () => {
			const spec = SPECS[type];
			const v = value.value.trim();
			const ok = spec.check(v);
			byId('dns-value-field').classList.toggle('invalid', !ok);
			byId('dns-value-note').textContent = ok ? spec.note : `Invalid ${spec.label.toLowerCase()}. ${spec.note}`;
			const n = name.value.trim() || '@';
			const fqdn = n === '@' ? `${domain.value.trim()}.` : `${n}.${domain.value.trim()}.`;
			const t = /^\d+$/.test(ttl.value.trim()) ? ttl.value.trim() : '3600';
			const x = extra.value.trim();
			const rdata: Record<string, () => [string, string]> = {
				A: () => ['A', v],
				AAAA: () => ['AAAA', v],
				CNAME: () => ['CNAME', v],
				MX: () => ['MX', `${x || '10'} ${v}`],
				TXT: () => ['TXT', quote(v)],
				SPF: () => ['TXT', quote(`v=spf1 ${v} ${x || '~all'}`.replace(/\s+/g, ' '))],
				DMARC: () => ['TXT', quote(`v=DMARC1; p=${x || 'none'}; rua=mailto:${v}; adkim=r; aspf=r`)],
				CAA: () => ['CAA', `0 ${x || 'issue'} "${v}"`],
				SRV: () => ['SRV', `${x || '10 5 5060'} ${v}`],
			};
			const [rtype, data] = rdata[type]();
			byId('dns-out').textContent = `${fqdn.padEnd(28)} ${t.padEnd(6)} IN  ${rtype.padEnd(6)} ${data}`;
		};

		segmented(byId('dns-type'), (value) => {
			type = value;
			load();
		});
		[domain, name, ttl, value, extra].forEach((el) => el.addEventListener('input', render));
		copyButton(byId('dns-copy'), () => byId('dns-out').textContent ?? '');
		load();
	});
</script>

<style>
	.dns-out {
		min-height: auto !important;
		white-space: pre-wrap;
		overflow-wrap: anywhere;
	}
</style>
