---
import ToolShell from '../../components/ToolShell.astro';

const sliders = [
	['x', 'Offset X', -100, 100, 0],
	['y', 'Offset Y', -100, 100, 12],
	['blur', 'Blur', 0, 150, 32],
	['spread', 'Spread', -60, 60, -8],
	['opacity', 'Opacity', 0, 100, 24],
];
---

<ToolShell
	slug="box-shadow-generator"
	title="Box Shadow Generator"
	description="Stack shadow layers, tune them visually, copy the CSS."
>
	<div class="bs-stage" id="bs-tool">
		<div class="bs-box" id="bs-box"></div>
	</div>
	<div class="toolbar">
		<div class="chips" id="bs-layers"></div>
		<button class="btn" id="bs-add">+ Layer</button>
		<button class="btn" id="bs-remove">Remove layer</button>
	</div>
	<section class="panel bs-controls">
		{
			sliders.map(([id, label, min, max, value]) => (
				<label class="bs-slider">
					<span>{label}</span>
					<input type="range" id={`bs-${id}`} min={min} max={max} value={value} />
					<b id={`bs-${id}-value`} />
				</label>
			))
		}
		<label class="bs-slider">
			<span>Color</span>
			<input type="color" id="bs-color" value="#1c1832" />
			<label class="check"><input type="checkbox" id="bs-inset" /> Inset</label>
		</label>
	</section>
	<div class="chips" id="bs-presets">
		<button data-preset="soft">Soft</button>
		<button data-preset="float">Floating</button>
		<button data-preset="crisp">Crisp</button>
		<button data-preset="inner">Inner</button>
		<button data-preset="glow">Glow</button>
	</div>
	<section class="panel">
		<div class="panel-head">
			<span>CSS</span>
			<button class="btn" id="bs-copy">Copy</button>
		</div>
		<pre class="out bs-css" id="bs-css"></pre>
	</section>
</ToolShell>

<script>
	import { byId, copyButton, onPage } from '../../scripts/ui';

	type Layer = { x: number; y: number; blur: number; spread: number; opacity: number; color: string; inset: boolean };
	const KEYS = ['x', 'y', 'blur', 'spread', 'opacity'] as const;

	const PRESETS: Record<string, Layer[]> = {
		soft: [{ x: 0, y: 12, blur: 32, spread: -8, opacity: 24, color: '#1c1832', inset: false }],
		float: [
			{ x: 0, y: 1, blur: 2, spread: 0, opacity: 10, color: '#000000', inset: false },
			{ x: 0, y: 24, blur: 48, spread: -12, opacity: 30, color: '#1c1832', inset: false },
		],
		crisp: [{ x: 6, y: 6, blur: 0, spread: 0, opacity: 100, color: '#201c2e', inset: false }],
		inner: [{ x: 0, y: 2, blur: 6, spread: 0, opacity: 25, color: '#000000', inset: true }],
		glow: [{ x: 0, y: 0, blur: 40, spread: 4, opacity: 70, color: '#bd93f9', inset: false }],
	};

	const rgba = (hex: string, opacity: number) => {
		const n = parseInt(hex.slice(1), 16);
		return `rgb(${n >> 16} ${(n >> 8) & 255} ${n & 255} / ${opacity}%)`;
	};

	onPage('bs-tool', () => {
		let layers: Layer[] = structuredClone(PRESETS.soft);
		let active = 0;
		const color = byId<HTMLInputElement>('bs-color');
		const inset = byId<HTMLInputElement>('bs-inset');

		const css = () =>
			layers
				.map((l) => `${l.inset ? 'inset ' : ''}${l.x}px ${l.y}px ${l.blur}px ${l.spread}px ${rgba(l.color, l.opacity)}`)
				.join(',\n    ');

		const sync = () => {
			const layer = layers[active];
			KEYS.forEach((key) => {
				byId<HTMLInputElement>(`bs-${key}`).value = String(layer[key]);
				byId(`bs-${key}-value`).textContent = key === 'opacity' ? `${layer[key]}%` : `${layer[key]}px`;
			});
			color.value = layer.color;
			inset.checked = layer.inset;
			byId('bs-layers').replaceChildren(
				...layers.map((_, i) => {
					const button = document.createElement('button');
					button.textContent = `Layer ${i + 1}`;
					button.setAttribute('aria-pressed', String(i === active));
					button.addEventListener('click', () => {
						active = i;
						sync();
					});
					return button;
				})
			);
			byId('bs-remove').hidden = layers.length < 2;
			const value = css();
			byId('bs-box').style.boxShadow = value;
			byId('bs-css').textContent = `box-shadow: ${value};`;
		};

		KEYS.forEach((key) =>
			byId<HTMLInputElement>(`bs-${key}`).addEventListener('input', (e) => {
				layers[active][key] = Number((e.target as HTMLInputElement).value);
				sync();
			})
		);
		color.addEventListener('input', () => {
			layers[active].color = color.value;
			sync();
		});
		inset.addEventListener('change', () => {
			layers[active].inset = inset.checked;
			sync();
		});
		byId('bs-add').addEventListener('click', () => {
			layers.push({ ...layers[active] });
			active = layers.length - 1;
			sync();
		});
		byId('bs-remove').addEventListener('click', () => {
			layers.splice(active, 1);
			active = Math.max(0, active - 1);
			sync();
		});
		document.querySelectorAll<HTMLButtonElement>('#bs-presets button').forEach((button) =>
			button.addEventListener('click', () => {
				layers = structuredClone(PRESETS[button.dataset.preset!]);
				active = 0;
				sync();
			})
		);
		copyButton(byId('bs-copy'), () => byId('bs-css').textContent ?? '');
		sync();
	});
</script>

<style>
	.bs-stage {
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: 260px;
		border-radius: 14px;
		background: var(--surface-2);
		border: 1px solid var(--border);
	}
	.bs-box {
		width: 180px;
		height: 120px;
		border-radius: 16px;
		background: var(--surface);
	}
	.bs-controls {
		display: flex;
		flex-direction: column;
		gap: 4px;
		padding: 10px 14px;
	}
	.bs-slider {
		display: grid;
		grid-template-columns: 90px 1fr 60px;
		align-items: center;
		gap: 12px;
		font-size: 13px;
		color: var(--ink-soft);
		font-weight: 600;
	}
	.bs-slider input[type='range'] {
		accent-color: var(--accent-strong);
	}
	.bs-slider b {
		color: var(--ink);
		font-variant-numeric: tabular-nums;
		text-align: right;
	}
	.bs-slider input[type='color'] {
		width: 100%;
		height: 30px;
		border: 1px solid var(--border);
		border-radius: 8px;
		background: transparent;
	}
	.bs-css {
		min-height: auto !important;
	}
</style>
