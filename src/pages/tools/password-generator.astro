---
import ToolShell from '../../components/ToolShell.astro';
---

<ToolShell
	slug="password-generator"
	title="Password Generator"
	description="Cryptographically random passwords with a live strength estimate."
>
	<section class="panel pw-hero" id="pw-tool">
		<output class="pw-value" id="pw-out"></output>
		<div class="pw-actions">
			<button class="btn" id="pw-regen">Regenerate</button>
			<button class="btn primary" id="pw-copy">Copy</button>
		</div>
		<div class="pw-meter" aria-hidden="true"><span id="pw-bar"></span></div>
		<p class="pw-strength" id="pw-strength"></p>
	</section>
	<div class="toolbar">
		<label class="check pw-length"
			>Length <input type="range" id="pw-length" min="6" max="64" value="20" /> <b id="pw-length-value">20</b></label
		>
	</div>
	<div class="toolbar">
		<label class="check"><input type="checkbox" id="pw-upper" checked /> A–Z</label>
		<label class="check"><input type="checkbox" id="pw-lower" checked /> a–z</label>
		<label class="check"><input type="checkbox" id="pw-digits" checked /> 0–9</label>
		<label class="check"><input type="checkbox" id="pw-symbols" checked /> !@#$</label>
		<label class="check"><input type="checkbox" id="pw-ambiguous" /> Avoid look-alikes (O0 Il1)</label>
	</div>
</ToolShell>

<script>
	import { randomIndex } from '../../scripts/crypto';
	import { byId, copyButton, onPage } from '../../scripts/ui';

	const SETS: Record<string, string> = {
		upper: 'ABCDEFGHIJKLMNOPQRSTUVWXYZ',
		lower: 'abcdefghijklmnopqrstuvwxyz',
		digits: '0123456789',
		symbols: '!@#$%^&*()-_=+[]{};:,.?/~',
	};
	const AMBIGUOUS = /[O0oIl1|]/g;

	const LEVELS: [number, string, string][] = [
		[0, 'Very weak', 'var(--warn)'],
		[40, 'Weak', 'var(--warn)'],
		[60, 'Fair', 'var(--partial)'],
		[80, 'Strong', 'var(--ok)'],
		[110, 'Very strong', 'var(--ok)'],
	];

	onPage('pw-tool', () => {
		const out = byId('pw-out');
		const length = byId<HTMLInputElement>('pw-length');
		const ambiguous = byId<HTMLInputElement>('pw-ambiguous');
		const boxes = Object.keys(SETS).map((name) => [name, byId<HTMLInputElement>(`pw-${name}`)] as const);

		const render = () => {
			byId('pw-length-value').textContent = length.value;
			let pools = boxes.filter(([, box]) => box.checked).map(([name]) => SETS[name]);
			if (ambiguous.checked) pools = pools.map((p) => p.replace(AMBIGUOUS, ''));
			if (!pools.length) {
				out.textContent = 'Pick at least one character set';
				return;
			}
			const all = pools.join('');
			const n = Number(length.value);
			const chars = pools.map((p) => p[randomIndex(p.length)]);
			while (chars.length < n) chars.push(all[randomIndex(all.length)]);
			for (let i = chars.length - 1; i > 0; i--) {
				const j = randomIndex(i + 1);
				[chars[i], chars[j]] = [chars[j], chars[i]];
			}
			out.textContent = chars.slice(0, n).join('');
			const bits = Math.round(n * Math.log2(all.length));
			const [, label, color] = LEVELS.filter(([min]) => bits >= min).pop()!;
			const bar = byId('pw-bar');
			bar.style.width = `${Math.min(100, (bits / 128) * 100)}%`;
			bar.style.background = color;
			byId('pw-strength').textContent = `${label} · ${bits} bits of entropy`;
		};

		[length, ambiguous, ...boxes.map(([, box]) => box)].forEach((el) => el.addEventListener('input', render));
		byId('pw-regen').addEventListener('click', render);
		copyButton(byId('pw-copy'), () => out.textContent ?? '');
		render();
	});
</script>

<style>
	.pw-hero {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 14px;
		align-items: center;
		padding: 22px;
	}
	.pw-value {
		font-family: var(--mono);
		font-size: 22px;
		word-break: break-all;
	}
	.pw-actions {
		display: flex;
		gap: 8px;
	}
	.pw-meter {
		grid-column: 1 / -1;
		height: 6px;
		border-radius: 999px;
		background: var(--surface-2);
		overflow: hidden;
	}
	.pw-meter span {
		display: block;
		height: 100%;
		transition: width 0.2s ease;
	}
	.pw-strength {
		grid-column: 1 / -1;
		margin: -6px 0 0;
		font-size: 13px;
		color: var(--ink-soft);
	}
	.pw-length input {
		width: 220px;
		accent-color: var(--accent-strong);
	}
	.pw-length b {
		font-variant-numeric: tabular-nums;
		color: var(--ink);
		min-width: 2ch;
	}
	@media (max-width: 560px) {
		.pw-hero {
			grid-template-columns: 1fr;
		}
	}
</style>
