---
import ToolShell from '../../components/ToolShell.astro';

const msgpackSample =
	'87 a2 69 64 cd 10 92 a4 6e 61 6d 65 a6 6b 6f 64 69 6c 6f a4 74 61 67 73 92 a3 64 65 76 a5 74 6f 6f 6c 73 a6 61 63 74 69 76 65 c3 a5 73 63 6f 72 65 cb 40 23 00 00 00 00 00 00 a5 6f 77 6e 65 72 c0 a5 64 65 6c 74 61 f9';
const protoSample = '08 96 01 12 06 6b 6f 64 69 6c 6f 1a 07 08 07 12 03 64 65 76 22 04 01 02 ac 02 28 05 35 00 00 c0 3f';
const schemaSample = `syntax = "proto3";

message Tag {
  int32 level = 1;
  string label = 2;
}

message User {
  uint32 id = 1;
  string name = 2;
  Tag tag = 3;
  repeated int32 scores = 4;
  sint32 delta = 5;
  float ratio = 6;
}`;
const jsonSample = '{"id": 4242, "name": "kodilo", "tags": ["dev", "tools"], "active": true}';
---

<ToolShell
	slug="protobuf-msgpack-decoder"
	title="Protobuf & MessagePack Decoder"
	description="Decode hex or base64 bytes as MessagePack or raw protobuf wire format, with or without a .proto schema, and encode JSON to MessagePack."
>
	<div class="pm" id="pm-tool" data-msgpack={msgpackSample} data-proto={protoSample}>
		<div class="toolbar">
			<div class="seg" id="pm-format" role="group" aria-label="Format">
				<button data-value="msgpack" aria-pressed="true">
					MessagePack
				</button>
				<button data-value="protobuf">Protobuf</button>
			</div>
			<div class="seg" id="pm-enc" role="group" aria-label="Input encoding">
				<button data-value="auto" aria-pressed="true">
					Auto
				</button>
				<button data-value="hex">Hex</button>
				<button data-value="base64">Base64</button>
			</div>
		</div>
		<section class="panel" data-no-share>
			<div class="panel-head">
				<span>Bytes</span>
				<span class="pm-meta" id="pm-meta"></span>
			</div>
			<textarea id="pm-in" spellcheck="false" aria-label="Encoded bytes">{msgpackSample}</textarea>
		</section>
		<div class="error" id="pm-error" hidden></div>
		<section class="panel" id="pm-schema-box" hidden>
			<div class="panel-head">
				<span>Optional .proto schema</span>
				<span class="pm-meta" id="pm-schema-state"></span>
			</div>
			<textarea id="pm-schema" spellcheck="false" aria-label="Proto schema">{schemaSample}</textarea>
			<div class="fields pm-type">
				<div class="field">
					<label for="pm-type">Message type</label>
					<input id="pm-type" spellcheck="false" autocomplete="off" value="User" />
				</div>
			</div>
		</section>
		<section class="panel">
			<div class="panel-head">
				<span id="pm-out-title">Decoded</span>
				<button class="btn" id="pm-copy">
					Copy
				</button>
			</div>
			<pre class="out" id="pm-out" tabindex="0" aria-live="polite"></pre>
		</section>
		<section class="panel" id="pm-named-box" hidden>
			<div class="panel-head">
				<span>Decoded with schema</span>
				<button class="btn" id="pm-copy-named">
					Copy
				</button>
			</div>
			<pre class="out" id="pm-named" tabindex="0"></pre>
		</section>
		<h2 class="pm-h">Encode JSON to MessagePack</h2>
		<section class="panel">
			<div class="panel-head">JSON</div>
			<textarea id="pm-json" spellcheck="false" aria-label="JSON to encode">{jsonSample}</textarea>
		</section>
		<div class="error" id="pm-json-error" hidden></div>
		<section class="panel">
			<div class="panel-head">
				<span id="pm-hex-title">MessagePack hex</span>
				<span class="pm-actions">
					<button class="btn" id="pm-copy-hex">
						Copy hex
					</button>
					<button class="btn" id="pm-copy-b64">
						Copy base64
					</button>
					<button class="btn" id="pm-decode-this">
						Decode
					</button>
				</span>
			</div>
			<pre class="out" id="pm-hex" tabindex="0"></pre>
		</section>
	</div>
</ToolShell>

<script>
	import { byId, copyButton, onPage, segmented } from '../../scripts/ui';

	const hexOf = (b: Uint8Array) => [...b].map((x) => x.toString(16).padStart(2, '0')).join(' ');
	const b64Of = (b: Uint8Array) => btoa(String.fromCharCode(...b));

	const toBytes = (src: string, enc: string) => {
		const s = src.trim();
		const compact = s.replace(/0x/gi, '').replace(/[\s,:]/g, '');
		const isHex = /^[0-9a-f]*$/i.test(compact) && compact.length % 2 === 0;
		if (enc === 'hex' || (enc === 'auto' && isHex)) {
			if (!isHex) throw new Error('Not valid hex: use pairs of 0-9 and a-f.');
			return Uint8Array.from(compact.match(/../g) ?? [], (h) => parseInt(h, 16));
		}
		try {
			const bin = atob(s.replace(/\s/g, '').replace(/-/g, '+').replace(/_/g, '/'));
			return Uint8Array.from(bin, (c) => c.charCodeAt(0));
		} catch {
			throw new Error('Input is neither hex nor base64.');
		}
	};

	const utf8 = new TextDecoder('utf-8', { fatal: true });

	const decodeMsgpack = (buf: Uint8Array) => {
		const view = new DataView(buf.buffer, buf.byteOffset, buf.byteLength);
		let pos = 0;
		const need = (n: number) => {
			if (pos + n > buf.length) throw new Error(`Unexpected end of data at byte ${pos}`);
		};
		const u = (n: 1 | 2 | 4) => {
			need(n);
			const v = n === 1 ? view.getUint8(pos) : n === 2 ? view.getUint16(pos) : view.getUint32(pos);
			pos += n;
			return v;
		};
		const bytesOf = (n: number) => {
			need(n);
			const out = buf.subarray(pos, pos + n);
			pos += n;
			return out;
		};
		const big = (v: bigint) => (v <= BigInt(Number.MAX_SAFE_INTEGER) && v >= BigInt(Number.MIN_SAFE_INTEGER) ? Number(v) : v.toString());
		const str = (n: number) => {
			const b = bytesOf(n);
			try {
				return utf8.decode(b);
			} catch {
				return `<invalid utf-8 ${hexOf(b)}>`;
			}
		};
		const ext = (n: number) => {
			need(1);
			const type = view.getInt8(pos++);
			const data = bytesOf(n);
			if (type === -1) {
				const d = new DataView(data.buffer, data.byteOffset, data.byteLength);
				let sec: number;
				let nsec = 0;
				if (n === 4) sec = d.getUint32(0);
				else if (n === 8) {
					const hi = d.getUint32(0);
					nsec = hi >>> 2;
					sec = (hi & 3) * 2 ** 32 + d.getUint32(4);
				} else if (n === 12) {
					nsec = d.getUint32(0);
					sec = Number(d.getBigInt64(4));
				} else return { ext: type, data: hexOf(data) };
				return { timestamp: new Date(sec * 1000 + nsec / 1e6).toISOString() };
			}
			return { ext: type, data: hexOf(data) };
		};
		const arr = (n: number): unknown[] => Array.from({ length: n }, () => read());
		const map = (n: number) => {
			const out: Record<string, unknown> = {};
			for (let i = 0; i < n; i++) {
				const k = read();
				out[typeof k === 'string' ? k : JSON.stringify(k)] = read();
			}
			return out;
		};
		const read = (): unknown => {
			const t = u(1);
			if (t <= 0x7f) return t;
			if (t <= 0x8f) return map(t & 0x0f);
			if (t <= 0x9f) return arr(t & 0x0f);
			if (t <= 0xbf) return str(t & 0x1f);
			if (t >= 0xe0) return t - 256;
			switch (t) {
				case 0xc0:
					return null;
				case 0xc2:
					return false;
				case 0xc3:
					return true;
				case 0xc4:
					return `<bin ${hexOf(bytesOf(u(1)))}>`;
				case 0xc5:
					return `<bin ${hexOf(bytesOf(u(2)))}>`;
				case 0xc6:
					return `<bin ${hexOf(bytesOf(u(4)))}>`;
				case 0xc7:
					return ext(u(1));
				case 0xc8:
					return ext(u(2));
				case 0xc9:
					return ext(u(4));
				case 0xca: {
					need(4);
					const v = view.getFloat32(pos);
					pos += 4;
					return v;
				}
				case 0xcb: {
					need(8);
					const v = view.getFloat64(pos);
					pos += 8;
					return v;
				}
				case 0xcc:
					return u(1);
				case 0xcd:
					return u(2);
				case 0xce:
					return u(4);
				case 0xcf: {
					need(8);
					const v = view.getBigUint64(pos);
					pos += 8;
					return big(v);
				}
				case 0xd0: {
					need(1);
					return view.getInt8(pos++);
				}
				case 0xd1: {
					need(2);
					const v = view.getInt16(pos);
					pos += 2;
					return v;
				}
				case 0xd2: {
					need(4);
					const v = view.getInt32(pos);
					pos += 4;
					return v;
				}
				case 0xd3: {
					need(8);
					const v = view.getBigInt64(pos);
					pos += 8;
					return big(v);
				}
				case 0xd4:
					return ext(1);
				case 0xd5:
					return ext(2);
				case 0xd6:
					return ext(4);
				case 0xd7:
					return ext(8);
				case 0xd8:
					return ext(16);
				case 0xd9:
					return str(u(1));
				case 0xda:
					return str(u(2));
				case 0xdb:
					return str(u(4));
				case 0xdc:
					return arr(u(2));
				case 0xdd:
					return arr(u(4));
				case 0xde:
					return map(u(2));
				case 0xdf:
					return map(u(4));
			}
			throw new Error(`Byte 0x${t.toString(16)} at ${pos - 1} is never used in MessagePack`);
		};
		const values: unknown[] = [];
		while (pos < buf.length) values.push(read());
		return values;
	};

	const encodeMsgpack = (value: unknown) => {
		const out: number[] = [];
		const be = (v: number, n: number) => {
			for (let i = n - 1; i >= 0; i--) out.push(Math.floor(v / 2 ** (8 * i)) & 0xff);
		};
		const tag = (t: number, v: number, n: number) => {
			out.push(t);
			be(v, n);
		};
		const write = (v: unknown) => {
			if (v === null || v === undefined) out.push(0xc0);
			else if (typeof v === 'boolean') out.push(v ? 0xc3 : 0xc2);
			else if (typeof v === 'number') {
				if (Number.isInteger(v) && Math.abs(v) <= Number.MAX_SAFE_INTEGER) {
					if (v >= 0) {
						if (v < 128) out.push(v);
						else if (v < 256) out.push(0xcc, v);
						else if (v < 65536) tag(0xcd, v, 2);
						else if (v < 2 ** 32) tag(0xce, v, 4);
						else tag(0xcf, v, 8);
					} else if (v >= -32) out.push(v & 0xff);
					else if (v >= -128) out.push(0xd0, v & 0xff);
					else if (v >= -32768) tag(0xd1, v & 0xffff, 2);
					else if (v >= -(2 ** 31)) tag(0xd2, v >>> 0, 4);
					else {
						const b = new DataView(new ArrayBuffer(8));
						b.setBigInt64(0, BigInt(v));
						out.push(0xd3, ...new Uint8Array(b.buffer));
					}
				} else {
					const b = new DataView(new ArrayBuffer(8));
					b.setFloat64(0, v);
					out.push(0xcb, ...new Uint8Array(b.buffer));
				}
			} else if (typeof v === 'string') {
				const s = new TextEncoder().encode(v);
				if (s.length < 32) out.push(0xa0 | s.length);
				else if (s.length < 256) out.push(0xd9, s.length);
				else if (s.length < 65536) tag(0xda, s.length, 2);
				else tag(0xdb, s.length, 4);
				out.push(...s);
			} else if (Array.isArray(v)) {
				if (v.length < 16) out.push(0x90 | v.length);
				else if (v.length < 65536) tag(0xdc, v.length, 2);
				else tag(0xdd, v.length, 4);
				v.forEach(write);
			} else {
				const entries = Object.entries(v as Record<string, unknown>);
				if (entries.length < 16) out.push(0x80 | entries.length);
				else if (entries.length < 65536) tag(0xde, entries.length, 2);
				else tag(0xdf, entries.length, 4);
				entries.forEach(([k, x]) => {
					write(k);
					write(x);
				});
			}
		};
		write(value);
		return Uint8Array.from(out);
	};

	type PbField = { field: number; wire: number; offset: number; text: string; children?: PbField[] };
	const WIRE = ['varint', 'i64', 'len', 'group start', 'group end', 'i32'];

	const decodeProto = (buf: Uint8Array, depth = 0): PbField[] => {
		let pos = 0;
		const varint = () => {
			let v = 0n;
			let shift = 0n;
			for (;;) {
				if (pos >= buf.length) throw new Error(`Truncated varint at byte ${pos}`);
				const b = buf[pos++];
				v |= BigInt(b & 0x7f) << shift;
				if (!(b & 0x80)) return v;
				shift += 7n;
				if (shift > 63n) throw new Error(`Varint too long at byte ${pos}`);
			}
		};
		const fields: PbField[] = [];
		while (pos < buf.length) {
			const offset = pos;
			const key = varint();
			const field = Number(key >> 3n);
			const wire = Number(key & 7n);
			if (field < 1 || field > 536870911) throw new Error(`Invalid field number ${field} at byte ${offset}`);
			if (wire === 0) {
				const v = varint();
				const signed = BigInt.asIntN(64, v);
				const zig = (v >> 1n) ^ -(v & 1n);
				const hints = [signed !== v ? `int64 ${signed}` : '', zig !== v ? `sint ${zig}` : '', v <= 1n ? `bool ${v === 1n}` : ''].filter(Boolean);
				fields.push({ field, wire, offset, text: `${v}${hints.length ? `  (${hints.join(', ')})` : ''}` });
			} else if (wire === 1) {
				if (pos + 8 > buf.length) throw new Error(`Truncated i64 at byte ${pos}`);
				const d = new DataView(buf.buffer, buf.byteOffset + pos, 8);
				fields.push({ field, wire, offset, text: `${d.getBigUint64(0, true)}  (double ${d.getFloat64(0, true)}, sfixed64 ${d.getBigInt64(0, true)})` });
				pos += 8;
			} else if (wire === 5) {
				if (pos + 4 > buf.length) throw new Error(`Truncated i32 at byte ${pos}`);
				const d = new DataView(buf.buffer, buf.byteOffset + pos, 4);
				fields.push({
					field,
					wire,
					offset,
					text: `${d.getUint32(0, true)}  (float ${+d.getFloat32(0, true).toPrecision(7)}, sfixed32 ${d.getInt32(0, true)})`,
				});
				pos += 4;
			} else if (wire === 2) {
				const len = Number(varint());
				if (pos + len > buf.length) throw new Error(`Length ${len} at byte ${offset} runs past the end`);
				const sub = buf.subarray(pos, pos + len);
				pos += len;
				fields.push(guessLen(field, offset, sub, depth));
			} else if (wire === 3 || wire === 4) {
				fields.push({ field, wire, offset, text: WIRE[wire] });
			} else throw new Error(`Invalid wire type ${wire} at byte ${offset}`);
		}
		return fields;
	};

	const tryProto = (sub: Uint8Array, depth: number) => {
		try {
			return decodeProto(sub, depth);
		} catch {
			return null;
		}
	};

	const tryUtf8 = (sub: Uint8Array) => {
		try {
			return utf8.decode(sub);
		} catch {
			return null;
		}
	};

	const guessLen = (field: number, offset: number, sub: Uint8Array, depth: number): PbField => {
		if (!sub.length) return { field, wire: 2, offset, text: 'empty' };
		const text = tryUtf8(sub);
		const printable = text !== null && !/[\u0000-\u0008\u000e-\u001f\u007f]/.test(text);
		const children = depth < 16 ? tryProto(sub, depth + 1) : null;
		if (children?.length && !(printable && children.some((c) => c.wire === 3 || c.wire === 4)))
			return { field, wire: 2, offset, text: `message · ${sub.length} bytes`, children };
		if (printable) return { field, wire: 2, offset, text: `string ${JSON.stringify(text)}` };
		const packed: bigint[] = [];
		let p = 0;
		let ok = true;
		while (p < sub.length && ok) {
			let v = 0n;
			let shift = 0n;
			for (;;) {
				if (p >= sub.length || shift > 63n) {
					ok = false;
					break;
				}
				const b = sub[p++];
				v |= BigInt(b & 0x7f) << shift;
				if (!(b & 0x80)) break;
				shift += 7n;
			}
			if (ok) packed.push(v);
		}
		if (ok && packed.length) return { field, wire: 2, offset, text: `packed varints [${packed.join(', ')}]  (bytes ${hexOf(sub)})` };
		return { field, wire: 2, offset, text: `bytes ${hexOf(sub)}` };
	};

	const printProto = (fields: PbField[], indent = ''): string =>
		fields
			.map((f) => {
				const line = `${indent}${f.field} [${WIRE[f.wire]}] ${f.text}`;
				return f.children ? `${line}\n${printProto(f.children, `${indent}  `)}` : line;
			})
			.join('\n');

	const json = (v: unknown) => JSON.stringify(v, null, 2);

	onPage('pm-tool', () => {
		const root = byId('pm-tool');
		const input = byId<HTMLTextAreaElement>('pm-in');
		const schema = byId<HTMLTextAreaElement>('pm-schema');
		const typeName = byId<HTMLInputElement>('pm-type');
		const jsonIn = byId<HTMLTextAreaElement>('pm-json');
		let format = 'msgpack';
		let enc = 'auto';
		let encoded = new Uint8Array();
		let schemaRun = 0;

		const decodeNamed = async (bytes: Uint8Array) => {
			const run = ++schemaRun;
			const box = byId('pm-named-box');
			if (format !== 'protobuf' || !schema.value.trim()) {
				box.hidden = true;
				byId('pm-schema-state').textContent = '';
				return;
			}
			byId('pm-schema-state').textContent = 'Loading parser';
			try {
				const pb = await import('protobufjs');
				if (run !== schemaRun) return;
				const parsed = pb.parse(schema.value, { keepCase: true });
				const type = parsed.root.lookupType(typeName.value.trim() || 'Message');
				const msg = type.decode(bytes);
				byId('pm-named').textContent = json(type.toObject(msg, { longs: String, bytes: String, defaults: false, enums: String }));
				byId('pm-schema-state').textContent = `Using ${type.fullName.replace(/^\./, '')}`;
				box.hidden = false;
			} catch (e) {
				if (run !== schemaRun) return;
				byId('pm-schema-state').textContent = (e as Error).message;
				box.hidden = true;
			}
		};

		const decode = () => {
			byId('pm-schema-box').hidden = format !== 'protobuf';
			byId('pm-out-title').textContent = format === 'msgpack' ? 'Decoded MessagePack' : 'Wire format · field [wire type] value';
			try {
				const bytes = toBytes(input.value, enc);
				byId('pm-meta').textContent = `${bytes.length} bytes`;
				if (format === 'msgpack') {
					const values = decodeMsgpack(bytes);
					byId('pm-out').textContent = values.length === 1 ? json(values[0]) : values.map(json).join('\n');
				} else byId('pm-out').textContent = printProto(decodeProto(bytes));
				byId('pm-error').hidden = true;
				decodeNamed(bytes);
			} catch (e) {
				byId('pm-out').textContent = '';
				byId('pm-error').hidden = false;
				byId('pm-error').textContent = (e as Error).message;
				byId('pm-named-box').hidden = true;
			}
		};

		const encodeJson = () => {
			try {
				encoded = encodeMsgpack(JSON.parse(jsonIn.value));
				byId('pm-hex').textContent = hexOf(encoded);
				byId('pm-hex-title').textContent = `MessagePack hex · ${encoded.length} bytes`;
				byId('pm-json-error').hidden = true;
			} catch (e) {
				encoded = new Uint8Array();
				byId('pm-hex').textContent = '';
				byId('pm-json-error').hidden = false;
				byId('pm-json-error').textContent = (e as Error).message;
			}
		};

		segmented(byId('pm-format'), (v) => {
			const current = input.value.trim();
			if (current === root.dataset.msgpack && v === 'protobuf') input.value = root.dataset.proto ?? '';
			if (current === root.dataset.proto && v === 'msgpack') input.value = root.dataset.msgpack ?? '';
			format = v;
			decode();
		});
		segmented(byId('pm-enc'), (v) => {
			enc = v;
			decode();
		});
		input.addEventListener('input', decode);
		schema.addEventListener('input', decode);
		typeName.addEventListener('input', decode);
		jsonIn.addEventListener('input', encodeJson);
		copyButton(byId('pm-copy'), () => byId('pm-out').textContent ?? '');
		copyButton(byId('pm-copy-named'), () => byId('pm-named').textContent ?? '');
		copyButton(byId('pm-copy-hex'), () => hexOf(encoded));
		copyButton(byId('pm-copy-b64'), () => b64Of(encoded));
		byId('pm-decode-this').addEventListener('click', () => {
			input.value = hexOf(encoded);
			byId('pm-format').querySelector<HTMLButtonElement>('[data-value="msgpack"]')!.click();
			input.focus();
		});
		decode();
		encodeJson();
	});
</script>

<style>
	.pm {
		display: grid;
		gap: 14px;
		min-width: 0;
	}
	.pm .toolbar {
		flex-wrap: wrap;
	}
	#pm-in,
	#pm-json {
		min-height: 90px;
		font-family: var(--mono);
	}
	#pm-schema {
		min-height: 200px;
		font-family: var(--mono);
	}
	.pm-type {
		padding: 0 14px 14px;
	}
	.pm-meta {
		font-size: 12px;
		color: var(--ink-soft);
		text-transform: none;
		letter-spacing: 0;
		overflow-wrap: anywhere;
		min-width: 0;
	}
	.pm-actions {
