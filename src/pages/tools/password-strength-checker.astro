---
import ToolShell from '../../components/ToolShell.astro';
---

<ToolShell
	slug="password-strength-checker"
	title="Password Strength Checker"
	description="See how long a password would survive a real attack: entropy, guesses, crack time per attack scenario and the weak patterns it contains. Checked in your browser, never stored or sent."
>
	<div class="pw" id="pw-tool">
		<div class="field">
			<label for="pw-in">Password</label>
			<div class="pw-row">
				<input id="pw-in" type="text" value="P@ssw0rd2024!" autocomplete="off" autocapitalize="off" spellcheck="false" />
				<button class="btn" id="pw-toggle" type="button">
					Hide
				</button>
			</div>
		</div>
		<p class="pw-note">Everything is computed on this page. The password is never stored, logged or sent anywhere.</p>
		<section class="panel pw-score" aria-live="polite">
			<div class="pw-meter" aria-hidden="true">
				<span></span>
				<span></span>
				<span></span>
				<span></span>
				<span></span>
			</div>
			<p class="pw-verdict" id="pw-verdict"></p>
			<p class="pw-summary" id="pw-summary"></p>
		</section>
		<div class="stats" id="pw-stats"></div>
		<div class="grid-2">
			<section class="panel">
				<div class="panel-head">Time to crack</div>
				<dl class="pw-dl" id="pw-times"></dl>
			</section>
			<section class="panel">
				<div class="panel-head">Patterns found</div>
				<ul class="pw-list" id="pw-patterns"></ul>
			</section>
		</div>
		<section class="panel">
			<div class="panel-head">How to improve it</div>
			<ul class="pw-list" id="pw-feedback"></ul>
		</section>
	</div>
</ToolShell>

<script>
	import { byId, onPage } from '../../scripts/ui';

	const COMMON =
		`123456 password 12345678 qwerty 123456789 12345 1234 111111 1234567 dragon 123123 baseball abc123 football monkey letmein 696969 shadow master 666666 qwertyuiop 123321 mustang 1234567890 michael 654321 superman 1qaz2wsx 7777777 121212 000000 qazwsx 123qwe killer trustno1 jordan jennifer zxcvbnm asdfgh hunter buster soccer harley batman andrew tigger sunshine iloveyou 2000 charlie robert thomas hockey ranger daniel starwars klaster 112233 george computer michelle jessica pepper 1111 zxcvbn 555555 11111111 131313 freedom 777777 pass maggie 159753 aaaaaa ginger princess joshua cheese amanda summer love ashley nicole chelsea biteme matthew access yankees 987654321 dallas austin thunder taylor matrix admin welcome login passw0rd hello secret winter spring autumn flower orange banana apple test guest root default changeme qwerty123 password1 p@ssw0rd azerty solo`.split(
			' ',
		);
	const WORDS =
		`the and love you baby girl boy angel honey sweet happy lucky money power magic dragon tiger lion eagle wolf bear cat dog fish bird horse star moon sun sky blue red green black white gold silver diamond king queen prince princess lady man woman family friend summer winter spring autumn monday friday january june july december london paris berlin rome tokyo york home house heart soul life world music rock metal game player soccer football hockey tennis golf ninja pirate rocket space coffee pizza cookie chocolate secret shadow dream night light fire water earth storm thunder rain snow ice spider batman superman master hunter killer admin user login welcome hello forever always never super mega ultra crazy cool hot sexy pretty beautiful little big best first last company office server system network computer internet google apple microsoft windows linux mail email phone mobile`.split(
			' ',
		);
	const KEYBOARDS = ['qwertyuiop', 'asdfghjkl', 'zxcvbnm', 'azertyuiop', 'qsdfghjklm', 'wxcvbn', '1234567890', '1qaz2wsx3edc', 'qazwsxedc'];
	const LEET: Record<string, string> = { '4': 'a', '@': 'a', '3': 'e', '1': 'i', '!': 'i', '0': 'o', $: 's', '5': 's', '7': 't', '+': 't' };

	type Match = { i: number; j: number; kind: string; label: string; guesses: number };

	const log2 = Math.log2;

	const pool = (s: string) => {
		let n = 0;
		if (/[a-z]/.test(s)) n += 26;
		if (/[A-Z]/.test(s)) n += 26;
		if (/[0-9]/.test(s)) n += 10;
		if (/[^a-zA-Z0-9]/.test(s)) n += 33;
		if (/[^\x00-\x7f]/.test(s)) n += 100;
		return n || 1;
	};

	const find = (pw: string): Match[] => {
		const out: Match[] = [];
		const lower = pw.toLowerCase();
		const unleet = lower.replace(/./g, (c) => LEET[c] ?? c);
		const variants = (word: string, i: number) => {
			const orig = pw.slice(i, i + word.length);
			const upper = (orig.match(/[A-Z]/g) ?? []).length;
			const caps = upper === 0 ? 1 : /^[A-Z][^A-Z]*$/.test(orig) || upper === orig.length ? 2 : 2 ** Math.min(upper, 6);
			const leet = orig.toLowerCase() !== word ? 2 ** Math.min([...orig.toLowerCase()].filter((c, k) => c !== word[k]).length, 4) : 1;
			return caps * leet;
		};
		for (let i = 0; i < pw.length; i++) {
			for (let j = pw.length; j >= i + 3; j--) {
				const chunk = unleet.slice(i, j);
				const common = COMMON.indexOf(chunk);
				if (common >= 0)
					out.push({ i, j, kind: 'common', label: `"${pw.slice(i, j)}" is one of the most used passwords`, guesses: (common + 1) * variants(chunk, i) });
				const word = WORDS.indexOf(chunk);
				if (word >= 0 && chunk.length >= 3)
					out.push({
						i,
						j,
						kind: 'word',
						label: `"${pw.slice(i, j)}" is a dictionary word${lower.slice(i, j) !== chunk ? ' with l33t substitutions' : ''}`,
						guesses: (word + 50) * variants(chunk, i),
					});
				const rev = [...chunk].reverse().join('');
				if (chunk.length >= 4 && (COMMON.includes(rev) || WORDS.includes(rev)))
					out.push({ i, j, kind: 'reversed', label: `"${pw.slice(i, j)}" is a reversed word`, guesses: 2 * 500 });
			}
		}
		for (const m of pw.matchAll(/(.+?)\1+/g)) {
			if (m[0].length < 3) continue;
			out.push({
				i: m.index,
				j: m.index + m[0].length,
				kind: 'repeat',
				label: `"${m[0]}" repeats "${m[1]}"`,
				guesses: Math.max(2 ** (m[1].length * log2(pool(m[1]))), 10) * (m[0].length / m[1].length),
			});
		}
		let start = 0;
		for (let k = 1; k <= pw.length; k++) {
			const d = k < pw.length ? pw.charCodeAt(k) - pw.charCodeAt(k - 1) : NaN;
			const prev = k >= 2 ? pw.charCodeAt(k - 1) - pw.charCodeAt(k - 2) : NaN;
			if (k === pw.length || !(Math.abs(d) === 1 && (k - start < 2 || d === prev))) {
				if (k - start >= 3) out.push({ i: start, j: k, kind: 'sequence', label: `"${pw.slice(start, k)}" is a sequence`, guesses: 26 * (k - start) * 2 });
				start = k - 1 >= start && k < pw.length && Math.abs(d) === 1 ? k - 1 : k;
			}
		}
		for (const row of KEYBOARDS) {
			for (let i = 0; i < lower.length; i++) {
				for (let j = lower.length; j >= i + 4; j--) {
					const chunk = lower.slice(i, j);
					if (row.includes(chunk) || [...row].reverse().join('').includes(chunk)) {
						out.push({ i, j, kind: 'keyboard', label: `"${pw.slice(i, j)}" is a keyboard pattern`, guesses: 50 * (j - i) });
						i = j - 1;
						break;
					}
				}
			}
		}
		for (const m of pw.matchAll(/(19|20)\d{2}/g)) out.push({ i: m.index, j: m.index + 4, kind: 'year', label: `"${m[0]}" looks like a year`, guesses: 120 });
		for (const m of pw.matchAll(/\d{1,2}[-/.]?\d{1,2}[-/.]?(?:19|20)?\d{2}/g))
			if (m[0].length >= 6) out.push({ i: m.index, j: m.index + m[0].length, kind: 'date', label: `"${m[0]}" looks like a date`, guesses: 365 * 100 });
		return out;
	};

	const estimate = (pw: string) => {
		const matches = find(pw);
		const bf = log2(pool(pw));
		const best: { bits: number; path: Match[] }[] = [{ bits: 0, path: [] }];
		for (let k = 1; k <= pw.length; k++) {
			let cand = { bits: best[k - 1].bits + bf, path: best[k - 1].path };
			matches
				.filter((m) => m.j === k)
				.forEach((m) => {
					const bits = best[m.i].bits + log2(m.guesses);
					if (bits < cand.bits) cand = { bits, path: [...best[m.i].path, m] };
				});
			best[k] = cand;
		}
		const final = best[pw.length];
		const bits = final.path.length ? final.bits + log2(final.path.length + 1) : final.bits;
		return { bits: pw ? bits : 0, naive: pw.length * bf, path: final.path, all: matches };
	};

	const duration = (seconds: number) => {
		if (seconds < 1) return 'instantly';
		const units: [string, number][] = [
			['century', 3153600000],
			['year', 31536000],
			['month', 2592000],
			['day', 86400],
			['hour', 3600],
			['minute', 60],
			['second', 1],
		];
		if (seconds >= 3153600000 * 1000) return 'longer than the age of civilization';
		const [name, size] = units.find(([, s]) => seconds >= s)!;
		const n = Math.round(seconds / size);
		return `${n} ${n === 1 ? name : name === 'century' ? 'centuries' : `${name}s`}`;
	};

	const VERDICTS = ['Very weak', 'Weak', 'Fair', 'Strong', 'Very strong'];
	const SCENARIOS: [string, string, number][] = [
		['Online, throttled', '100 guesses per hour against a login form with rate limiting', 100 / 3600],
		['Online, unthrottled', '10 guesses per second against an unprotected login', 10],
		['Offline, slow hash', '10 thousand guesses per second against bcrypt, scrypt or Argon2', 1e4],
		['Offline, fast hash', '10 billion guesses per second against MD5 or SHA-1 on GPUs', 1e10],
	];

	const el = (tag: string, cls = '', text?: string) => {
		const e = document.createElement(tag);
		if (cls) e.className = cls;
		if (text !== undefined) e.textContent = text;
		return e;
	};

	onPage('pw-tool', () => {
		const input = byId<HTMLInputElement>('pw-in');
		const toggle = byId<HTMLButtonElement>('pw-toggle');

		const render = () => {
			const pw = input.value;
			const { bits, naive, path, all } = estimate(pw);
			const guesses = 2 ** bits;
			const log10 = Math.log10(Math.max(guesses, 1));
			const score = !pw ? 0 : log10 < 3 ? 0 : log10 < 6 ? 1 : log10 < 8 ? 2 : log10 < 10 ? 3 : 4;
			const tool = byId('pw-tool');
			tool.dataset.score = pw ? String(score) : '';
			byId('pw-verdict').textContent = pw ? VERDICTS[score] : 'Type a password';
			byId('pw-summary').textContent = pw
				? `About ${bits.toFixed(0)} bits of real entropy, roughly 10^${log10.toFixed(1)} guesses. A fast offline attack would take ${duration(guesses / 2 / 1e10)}.`
				: 'Nothing is stored or sent.';
			const stats: [string, string][] = [
				[String([...pw].length), 'characters'],
				[`${bits.toFixed(0)} bits`, 'estimated entropy'],
				[`${naive.toFixed(0)} bits`, 'if fully random'],
				[String(pool(pw) === 1 && !pw ? 0 : pool(pw)), 'character pool'],
			];
			byId('pw-stats').replaceChildren(
				...stats.map(([v, l]) => {
					const s = el('div', 'stat');
					s.append(el('b', '', v), el('span', '', l));
					return s;
				}),
			);
			byId('pw-times').replaceChildren(
				...SCENARIOS.flatMap(([name, hint, rate]) => {
					const dt = el('dt');
					dt.append(el('span', '', name), el('b', '', pw ? duration(guesses / 2 / rate) : '-'));
					return [dt, el('dd', '', hint)];
				}),
			);
			const used = new Set(path);
			const seen = new Set<string>();
			const shown = [...path, ...all.filter((m) => !used.has(m))].filter((m) => {
				if (seen.has(m.label)) return false;
				seen.add(m.label);
				return true;
			});
			byId('pw-patterns').replaceChildren(
				...(shown.length
					? shown.slice(0, 8).map((m) => el('li', used.has(m) ? 'hit' : '', m.label))
					: [el('li', 'ok', pw ? 'No common pattern found.' : 'Nothing to analyze yet.')]),
			);
			const tips: string[] = [];
			const kinds = new Set(path.map((m) => m.kind));
			if (kinds.has('common')) tips.push('This password is on public breach lists. Attackers try those first, so replace it.');
			if (kinds.has('word') || kinds.has('reversed'))
				tips.push('Dictionary words and l33t swaps like @ for a are guessed early. Use several unrelated words instead.');
			if (kinds.has('year') || kinds.has('date')) tips.push('Years and dates are easy to guess, especially birthdays and the current year.');
			if (kinds.has('sequence') || kinds.has('keyboard')) tips.push('Avoid sequences like abc or 123 and keyboard walks like qwerty.');
			if (kinds.has('repeat')) tips.push('Repeated characters or chunks add very little strength.');
			if ([...pw].length < 12) tips.push('Make it longer. Length beats complexity: aim for 14 characters or more.');
			if (score < 3) tips.push('A passphrase of four or five random words, or a password manager, gives much more strength.');
			if (score >= 3 && !tips.length) tips.push('Looks good. Keep it unique to this account and store it in a password manager.');
			if (pw) tips.push('Turn on two-factor authentication wherever you can.');
			byId('pw-feedback').replaceChildren(...tips.map((t) => el('li', '', t)));
		};

		toggle.addEventListener('click', () => {
			const shown = input.type === 'text';
			input.type = shown ? 'password' : 'text';
			toggle.textContent = shown ? 'Show' : 'Hide';
		});
		input.addEventListener('input', render);
		render();
	});
</script>

<style>
	.pw {
		display: flex;
		flex-direction: column;
		gap: 16px;
	}
	.pw-row {
		display: flex;
		gap: 8px;
		align-items: center;
	}
	.pw-row input {
		flex: 1;
		min-width: 0;
		border: 0;
		background: transparent;
		color: var(--ink);
		font-family: var(--mono);
		font-size: 20px;
		outline: none;
	}
	.pw-note {
		margin: 0;
		font-size: 13px;
		color: var(--ink-soft);
	}
	.pw-score {
		padding: 14px;
		display: flex;
		flex-direction: column;
		gap: 8px;
	}
	.pw-meter {
		display: grid;
		grid-template-columns: repeat(5, 1fr);
		gap: 4px;
	}
	.pw-meter span {
		height: 6px;
		border-radius: 3px;
		background: var(--surface-2);
	}
	.pw[data-score='0'] .pw-meter span:nth-child(-n + 1),
	.pw[data-score='1'] .pw-meter span:nth-child(-n + 2) {
		background: var(--bad);
	}
	.pw[data-score='2'] .pw-meter span:nth-child(-n + 3) {
		background: var(--warn);
	}
	.pw[data-score='3'] .pw-meter span:nth-child(-n + 4),
	.pw[data-score='4'] .pw-meter span {
		background: var(--ok);
	}
	.pw-verdict {
		margin: 0;
		font-size: 22px;
		font-weight: 800;
	}
	.pw-summary {
		margin: 0;
		font-size: 14px;
		color: var(--ink-soft);
	}
	.pw-dl {
		margin: 0;
		padding: 10px 14px 14px;
	}
	.pw-dl :global(dt) {
		display: flex;
		justify-content: space-between;
		gap: 10px;
		font-size: 14px;
		font-weight: 600;
		margin-top: 8px;
	}
	.pw-dl :global(dt b) {
		font-variant-numeric: tabular-nums;
		text-align: right;
	}
	.pw-dl :global(dd) {
		margin: 2px 0 0;
		font-size: 12px;
		color: var(--ink-soft);
	}
	.pw-list {
		margin: 0;
		padding: 10px 14px 14px 32px;
		display: flex;
		flex-direction: column;
		gap: 6px;
		font-size: 14px;
		overflow-wrap: anywhere;
	}
	.pw-list :global(li.hit) {
		font-weight: 600;
	}
</style>
