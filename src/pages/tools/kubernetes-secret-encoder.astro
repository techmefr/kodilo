---
import ToolShell from '../../components/ToolShell.astro';

const decodeSample = `apiVersion: v1
kind: Secret
metadata:
  name: db-credentials
  namespace: production
type: Opaque
data:
  username: YWRtaW4=
  password: czNjcjN0LXDDpHNz
`;
---

<ToolShell
	slug="kubernetes-secret-encoder"
	title="Kubernetes Secret Encoder"
	description="Turn key/value pairs or a .env file into a Secret manifest with UTF-8 safe base64, or paste a Secret to read its values back."
>
	<div class="toolbar" id="ks-tool">
		<div class="seg" id="ks-mode" aria-label="Mode">
			<button data-value="encode" aria-pressed="true">
				Encode
			</button>
			<button data-value="decode" aria-pressed="false">
				Decode
			</button>
		</div>
	</div>
	<div id="ks-encode" class="ks-stack">
		<div class="toolbar">
			<div class="seg" id="ks-type" aria-label="Secret type">
				<button data-value="Opaque" aria-pressed="true">
					Opaque
				</button>
				<button data-value="kubernetes.io/tls" aria-pressed="false">
					TLS
				</button>
				<button data-value="kubernetes.io/dockerconfigjson" aria-pressed="false">
					Docker registry
				</button>
			</div>
			<label class="check">
				<input type="checkbox" id="ks-string" /> Use stringData
			</label>
		</div>
		<div class="fields">
			<div class="field">
				<label for="ks-name">Name</label>
				<input id="ks-name" spellcheck="false" value="db-credentials" />
			</div>
			<div class="field">
				<label for="ks-ns">Namespace</label>
				<input id="ks-ns" spellcheck="false" value="production" />
			</div>
		</div>
		<div id="ks-kv" class="ks-stack">
			<ul class="ks-rows" id="ks-rows" aria-label="Key value pairs"></ul>
			<div class="toolbar">
				<button class="btn" id="ks-add">
					Add key
				</button>
			</div>
			<section class="panel">
				<div class="panel-head">
					<span>Paste .env</span>
					<button class="btn" id="ks-import">
						Import
					</button>
				</div>
				<textarea id="ks-env" class="ks-env" spellcheck="false" aria-label=".env content" placeholder="KEY=value"></textarea>
			</section>
		</div>
		<div id="ks-tls" class="fields" hidden>
			<div class="field wide">
				<label for="ks-crt">tls.crt</label>
				<textarea id="ks-crt" class="ks-env" spellcheck="false">-----BEGIN CERTIFICATE-----
MIIB...
-----END CERTIFICATE-----</textarea>
			</div>
			<div class="field wide">
				<label for="ks-key">tls.key</label>
				<textarea id="ks-key" class="ks-env" spellcheck="false">-----BEGIN PRIVATE KEY-----
MIIE...
-----END PRIVATE KEY-----</textarea>
			</div>
		</div>
		<div id="ks-docker" class="fields" hidden>
			<div class="field">
				<label for="ks-reg">Registry</label>
				<input id="ks-reg" spellcheck="false" value="ghcr.io" />
			</div>
			<div class="field">
				<label for="ks-user">Username</label>
				<input id="ks-user" spellcheck="false" value="deploy-bot" />
			</div>
			<div class="field">
				<label for="ks-pass">Password or token</label>
				<input id="ks-pass" spellcheck="false" value="ghp_example" />
			</div>
			<div class="field">
				<label for="ks-email">Email</label>
				<input id="ks-email" spellcheck="false" placeholder="optional" />
			</div>
		</div>
		<section class="panel">
			<div class="panel-head">
				<span>secret.yaml</span>
				<button class="btn" id="ks-copy">
					Copy
				</button>
			</div>
			<pre class="out" id="ks-out" tabindex="0" aria-label="Secret YAML"></pre>
		</section>
	</div>
	<div id="ks-decode" class="grid-2" hidden>
		<section class="panel">
			<div class="panel-head">
				<span>Secret YAML</span>
			</div>
			<textarea id="ks-dec-in" spellcheck="false" aria-label="Secret YAML to decode">{decodeSample}</textarea>
		</section>
		<section class="panel">
			<div class="panel-head">
				<span>Decoded</span>
				<button class="btn" id="ks-dec-copy">
					Copy
				</button>
			</div>
			<pre class="out" id="ks-dec-out" tabindex="0" aria-label="Decoded values"></pre>
		</section>
	</div>
</ToolShell>

<script>
	import { parseAllDocuments } from 'yaml';
	import { byId, copyButton, onPage, segmented } from '../../scripts/ui';

	const b64 = (s: string) => {
		let bin = '';
		new TextEncoder().encode(s).forEach((b) => (bin += String.fromCharCode(b)));
		return btoa(bin);
	};
	const unb64 = (s: string) => {
		const bin = atob(s.replace(/\s/g, ''));
		return new TextDecoder('utf-8', { fatal: true }).decode(Uint8Array.from(bin, (c) => c.charCodeAt(0)));
	};
	const yq = (s: string) => (s === '' || (/^[\w./-]+$/.test(s) && !/^(true|false|yes|no|null|on|off|~|[\d.]+)$/i.test(s)) ? s || "''" : JSON.stringify(s));

	onPage('ks-tool', () => {
		const val = (id: string) => byId<HTMLInputElement>(id).value.trim();
		const rows = byId('ks-rows');
		let type = 'Opaque';
		let n = 0;

		const addRow = (k = '', v = '') => {
			const id = ++n;
			const li = document.createElement('li');
			li.className = 'ks-row';
			const key = document.createElement('input');
			key.className = 'ks-k';
			key.value = k;
			key.spellcheck = false;
			key.setAttribute('aria-label', `Key ${id}`);
			key.placeholder = 'KEY';
			const value = document.createElement('input');
			value.className = 'ks-v';
			value.value = v;
			value.spellcheck = false;
			value.setAttribute('aria-label', `Value ${id}`);
			value.placeholder = 'value';
			const del = document.createElement('button');
			del.className = 'btn';
			del.textContent = 'Remove';
			del.setAttribute('aria-label', `Remove key ${id}`);
			del.addEventListener('click', () => {
				li.remove();
				render();
			});
			key.addEventListener('input', render);
			value.addEventListener('input', render);
			li.append(key, value, del);
			rows.append(li);
		};

		const pairs = (): [string, string][] => {
			if (type === 'kubernetes.io/tls')
				return [
					['tls.crt', byId<HTMLTextAreaElement>('ks-crt').value],
					['tls.key', byId<HTMLTextAreaElement>('ks-key').value],
				];
			if (type === 'kubernetes.io/dockerconfigjson') {
				const reg = val('ks-reg') || 'https://index.docker.io/v1/';
				const entry: Record<string, string> = { username: val('ks-user'), password: val('ks-pass'), auth: b64(`${val('ks-user')}:${val('ks-pass')}`) };
				if (val('ks-email')) entry.email = val('ks-email');
				return [['.dockerconfigjson', JSON.stringify({ auths: { [reg]: entry } })]];
			}
			return Array.from(rows.querySelectorAll('li'))
				.map((li) => [li.querySelector<HTMLInputElement>('.ks-k')!.value.trim(), li.querySelector<HTMLInputElement>('.ks-v')!.value] as [string, string])
				.filter(([k]) => k);
		};

		const render = () => {
			const asString = byId<HTMLInputElement>('ks-string').checked;
			const L = ['apiVersion: v1', 'kind: Secret', 'metadata:', `  name: ${yq(val('ks-name') || 'my-secret')}`];
			if (val('ks-ns')) L.push(`  namespace: ${yq(val('ks-ns'))}`);
			L.push(`type: ${type}`, asString ? 'stringData:' : 'data:');
			pairs().forEach(([k, v]) => {
				if (!asString) L.push(`  ${yq(k)}: ${b64(v)}`);
				else if (v.includes('\n'))
					L.push(
						`  ${yq(k)}: |`,
						...v
							.replace(/\n$/, '')
							.split('\n')
							.map((l) => `    ${l}`),
					);
				else L.push(`  ${yq(k)}: ${yq(v)}`);
			});
			byId('ks-out').textContent = L.join('\n') + '\n';
		};

		const decode = () => {
			const out: string[] = [];
			try {
				parseAllDocuments(byId<HTMLTextAreaElement>('ks-dec-in').value).forEach((d) => {
					if (d.errors.length) throw new Error(d.errors[0].message.split('\n')[0]);
					const js = d.toJS() as Record<string, Record<string, string>> | null;
					if (!js) return;
					out.push(`# ${js.metadata?.name ?? 'secret'}`);
					Object.entries(js.data ?? {}).forEach(([k, v]) => {
						let text: string;
						try {
							text = unb64(String(v));
						} catch {
							text = '(not valid base64 UTF-8)';
						}
						out.push(`${k}=${text}`);
					});
					Object.entries(js.stringData ?? {}).forEach(([k, v]) => out.push(`${k}=${v}`));
				});
			} catch (e) {
				out.push(`Error: ${(e as Error).message}`);
			}
			byId('ks-dec-out').textContent = out.join('\n');
		};

		segmented(byId('ks-mode'), (m) => {
			byId('ks-encode').hidden = m !== 'encode';
			byId('ks-decode').hidden = m !== 'decode';
		});
		segmented(byId('ks-type'), (t) => {
			type = t;
			byId('ks-kv').hidden = t !== 'Opaque';
			byId('ks-tls').hidden = t !== 'kubernetes.io/tls';
			byId('ks-docker').hidden = t !== 'kubernetes.io/dockerconfigjson';
			render();
		});
		byId('ks-add').addEventListener('click', () => {
			addRow();
			render();
			rows.querySelector<HTMLInputElement>('li:last-child .ks-k')?.focus();
		});
		byId('ks-import').addEventListener('click', () => {
			const env = byId<HTMLTextAreaElement>('ks-env');
			env.value.split('\n').forEach((line) => {
				const m = line.trim().match(/^(?:export\s+)?([\w.-]+)\s*=\s*(.*)$/);
				if (!m) return;
				addRow(m[1], m[2].replace(/^(['"])(.*)\1$/, '$2'));
			});
			rows.querySelectorAll('li').forEach((li) => {
				if (!li.querySelector<HTMLInputElement>('.ks-k')!.value.trim()) li.remove();
			});
			env.value = '';
			render();
		});
		document.querySelectorAll('#ks-encode .fields input, #ks-encode .fields textarea, #ks-string').forEach((el) => el.addEventListener('input', render));
		byId('ks-dec-in').addEventListener('input', decode);
		copyButton(byId('ks-copy'), () => byId('ks-out').textContent ?? '');
		copyButton(byId('ks-dec-copy'), () => byId('ks-dec-out').textContent ?? '');
		addRow('username', 'admin');
		addRow('password', 's3cr3t-päss');
		render();
		decode();
	});
</script>

<style>
	.ks-stack {
		display: flex;
		flex-direction: column;
		gap: 16px;
	}
	.ks-stack[hidden],
	#ks-decode[hidden] {
		display: none;
	}
	.ks-rows {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 8px;
	}
	.ks-row {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 2fr) auto;
		gap: 8px;
	}
	.ks-row input {
		min-width: 0;
		font-family: var(--mono);
		font-size: 14px;
		padding: 8px 10px;
		border: 1px solid var(--border);
		border-radius: 8px;
		background: var(--surface);
		color: var(--ink);
	}
	.ks-row input:focus-visible {
		outline: 2px solid var(--accent-strong);
		outline-offset: 1px;
	}
	.ks-env {
		min-height: 80px !important;
		font-family: var(--mono) !important;
		font-size: 13px !important;
	}
	#ks-dec-in {
		min-height: 260px;
	}
	#ks-out,
	#ks-dec-out {
		overflow: auto;
	}
</style>
