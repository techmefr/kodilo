---
import ToolShell from '../../components/ToolShell.astro';

const sample = `select u.id, u.name, count(o.id) as orders, sum(o.total) as revenue from users u left join orders o on o.user_id = u.id and o.status = 'paid' where u.created_at >= '2026-01-01' and (u.country = 'FR' or u.country = 'BE') group by u.id, u.name having count(o.id) > 2 order by revenue desc limit 20;
update products set price = price * 1.1, updated_at = now() where category_id in (select id from categories where name like '%book%');`;
---

<ToolShell
	slug="sql-prettify"
	title="SQL Prettify"
	description="Format SQL with one clause per line, indented joins and conditions, keyword case of your choice. Or minify it."
>
	<div class="toolbar" id="sq-tool">
		<div class="seg" id="sq-mode">
			<button data-value="format" aria-pressed="true">
				Format
			</button>
			<button data-value="minify">Minify</button>
		</div>
		<div class="seg" id="sq-case">
			<button data-value="upper" aria-pressed="true">
				UPPER
			</button>
			<button data-value="lower">lower</button>
			<button data-value="keep">Keep</button>
		</div>
		<div class="seg" id="sq-indent">
			<button data-value="2" aria-pressed="true">
				2 spaces
			</button>
			<button data-value="4">4 spaces</button>
		</div>
	</div>
	<div class="grid-2">
		<section class="panel">
			<div class="panel-head">SQL</div>
			<textarea id="sq-in" spellcheck="false" aria-label="SQL input">{sample}</textarea>
		</section>
		<section class="panel">
			<div class="panel-head">
				<span>Result</span>
				<button class="btn" id="sq-copy">
					Copy
				</button>
			</div>
			<pre class="out" id="sq-out"></pre>
		</section>
	</div>
</ToolShell>

<script>
	import { byId, copyButton, onPage, segmented } from '../../scripts/ui';

	const KEYWORDS = new Set(
		'select from where and or not in is null like ilike between exists as on join inner left right full outer cross natural using group by order having limit offset union all distinct insert into values update set delete create table alter add drop column index primary key foreign references default unique check constraint view with recursive case when then else end asc desc returning if replace truncate cascade over partition window rows range fetch first next only true false interval cast collate'.split(
			' ',
		),
	);
	const CLAUSES = [
		'with',
		'select',
		'from',
		'where',
		'group by',
		'having',
		'order by',
		'limit',
		'offset',
		'union all',
		'union',
		'insert into',
		'values',
		'update',
		'set',
		'delete from',
		'returning',
		'fetch',
	];
	const JOINS = /^(left outer join|right outer join|full outer join|left join|right join|full join|inner join|cross join|natural join|join)$/i;

	function lex(sql: string): string[] {
		const re = /\s+|--[^\n]*|\/\*[\s\S]*?\*\/|'(?:[^']|'')*'|"(?:[^"]|"")*"|`[^`]*`|\d+(?:\.\d+)?|[\w$]+|<=|>=|<>|!=|\|\||::|[(),;.*=<>+\-/%]/g;
		return sql.match(re) ?? [];
	}

	function format(sql: string, kcase: string, unit: string): string {
		const raw = lex(sql).filter((t) => !/^\s+$/.test(t));
		const tok: string[] = [];
		for (let i = 0; i < raw.length; i++) {
			const two = `${raw[i]} ${raw[i + 1] ?? ''}`.toLowerCase();
			const three = `${two} ${raw[i + 2] ?? ''}`.toLowerCase();
			if (JOINS.test(three)) {
				tok.push(three);
				i += 2;
			} else if (JOINS.test(two) || ['group by', 'order by', 'union all', 'insert into', 'delete from', 'partition by'].includes(two)) {
				tok.push(two);
				i++;
			} else tok.push(raw[i]);
		}
		const kw = (t: string) =>
			KEYWORDS.has(t.toLowerCase().split(' ')[0]) || JOINS.test(t) || t.includes(' ')
				? kcase === 'upper'
					? t.toUpperCase()
					: kcase === 'lower'
						? t.toLowerCase()
						: t
				: t;
		const lines: string[] = [];
		let line = '';
		let base = 0;
		const stack: number[] = [];
		const push = () => {
			if (line.trim()) lines.push(unit.repeat(base) + line.trim());
			line = '';
		};
		const add = (s: string) => {
			const call = s === '(' && /[\w$]$/.test(line) && !KEYWORDS.has((line.match(/[\w$]+$/)?.[0] ?? '').toLowerCase());
			line += line && !call && !/[(.]$/.test(line) && !/^[),.;]/.test(s) && s !== '::' && !line.endsWith('::') ? ` ${s}` : s;
		};
		let clause = '';
		for (let i = 0; i < tok.length; i++) {
			const t = tok[i];
			const low = t.toLowerCase();
			if (t.startsWith('--') || t.startsWith('/*')) {
				push();
				lines.push(unit.repeat(base) + t);
				continue;
			}
			if (t === '(') {
				if ((tok[i + 1] ?? '').toLowerCase() === 'select') {
					add('(');
					push();
					stack.push(base);
					base++;
					continue;
				}
				stack.push(-1);
				add('(');
				continue;
			}
			if (t === ')') {
				const b = stack.pop();
				if (b !== undefined && b >= 0) {
					push();
					base = b;
					line = ')';
					continue;
				}
				add(')');
				continue;
			}
			if (CLAUSES.includes(low)) {
				push();
				clause = low;
				lines.push(unit.repeat(base) + kw(t));
				base++;
				while (i + 1 < tok.length && ['distinct', 'all'].includes(tok[i + 1].toLowerCase()) && low === 'select') lines[lines.length - 1] += ` ${kw(tok[++i])}`;
				const nextClause = () => {
					base--;
				};
				nextClause();
				base++;
				continue;
			}
			if (JOINS.test(low)) {
				push();
				base = Math.max(0, base - 1);
				line = kw(t);
				base++;
				continue;
			}
			if (low === 'on' && stack.every((s) => s >= 0)) {
				add(kw(t));
				continue;
			}
			if (
				(low === 'and' || low === 'or') &&
				(clause === 'where' || clause === 'having' || /join/.test(lines[lines.length - 1] ?? '')) &&
				stack.every((s) => s >= 0)
			) {
				push();
				line = `${kw(t)}`;
				continue;
			}
			if (t === ',' && stack.every((s) => s >= 0) && ['select', 'group by', 'order by', 'set', 'returning'].includes(clause)) {
				add(',');
				push();
				continue;
			}
			if (t === ';') {
				add(';');
				push();
				lines.push('');
				base = 0;
				continue;
			}
			add(kw(t));
		}
		push();
		const fixed: string[] = [];
		for (let k = 0; k < lines.length; k++) {
			const l = lines[k];
			const m = l.match(
				/^(\s*)(SELECT|FROM|WHERE|GROUP BY|HAVING|ORDER BY|LIMIT|OFFSET|UPDATE|SET|VALUES|RETURNING|INSERT INTO|DELETE FROM|WITH)(?:\s(DISTINCT|ALL))?$/i,
			);
			if (m && k + 1 < lines.length && lines[k + 1].trim() && !/^\s*\)/.test(lines[k + 1])) {
				fixed.push(l);
				continue;
			}
			fixed.push(l);
		}
		return fixed
			.join('\n')
			.replace(/\n{3,}/g, '\n\n')
			.trim();
	}

	function reindent(text: string, unit: string): string {
		const out: string[] = [];
		const CL = /^(WITH|SELECT|FROM|WHERE|GROUP BY|HAVING|ORDER BY|LIMIT|OFFSET|UNION ALL|UNION|INSERT INTO|VALUES|UPDATE|SET|DELETE FROM|RETURNING|FETCH)\b/i;
		const JN = /^((LEFT|RIGHT|FULL|INNER|CROSS|NATURAL)\s+(OUTER\s+)?)?JOIN\b/i;
		const levels: number[] = [0];
		for (const raw of text.split('\n')) {
			const l = raw.trim();
			if (!l) {
				out.push('');
				levels.length = 1;
				levels[0] = 0;
				continue;
			}
			if (l.startsWith(')')) {
				levels.pop();
			}
			const top = levels[levels.length - 1];
			const isClause = CL.test(l) || JN.test(l);
			const indent = isClause ? top : top + 1;
			out.push(unit.repeat(indent) + l);
			if (l.endsWith('(')) levels.push(indent + 1);
		}
		return out.join('\n');
	}

	onPage('sq-tool', () => {
		const input = byId<HTMLTextAreaElement>('sq-in');
		let mode = 'format';
		let kcase = 'upper';
		let unit = '  ';

		const render = () => {
			if (mode === 'minify') {
				byId('sq-out').textContent = lex(input.value)
					.filter((t) => !t.startsWith('--') && !t.startsWith('/*'))
					.map((t) => (/^\s+$/.test(t) ? ' ' : t))
					.join('')
					.replace(/\s*([(),;=<>+\-*/])\s*/g, '$1')
					.replace(/\s+/g, ' ')
					.replace(/;(?=\S)/g, ';\n')
					.trim();
				return;
			}
			byId('sq-out').textContent = reindent(format(input.value, kcase, unit), unit);
		};

		segmented(byId('sq-mode'), (v) => ((mode = v), render()));
		segmented(byId('sq-case'), (v) => ((kcase = v), render()));
		segmented(byId('sq-indent'), (v) => ((unit = ' '.repeat(Number(v))), render()));
		input.addEventListener('input', render);
		copyButton(byId('sq-copy'), () => byId('sq-out').textContent ?? '');
		render();
	});
</script>
