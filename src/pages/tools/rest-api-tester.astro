---
import ToolShell from '../../components/ToolShell.astro';

const headers = `Accept: application/json`;
---

<ToolShell
	slug="rest-api-tester"
	title="REST API Tester"
	description="Send an HTTP request from your browser and inspect the status, timing, headers and body. The API must allow CORS."
>
	<div class="ra-bar" id="ra-tool">
		<select id="ra-method" aria-label="Method">
			<option>GET</option>
			<option>POST</option>
			<option>PUT</option>
			<option>PATCH</option>
			<option>DELETE</option>
			<option>HEAD</option>
			<option>OPTIONS</option>
		</select>
		<input id="ra-url" spellcheck="false" aria-label="URL" value="https://jsonplaceholder.typicode.com/todos/1" />
		<button class="btn primary" id="ra-send">
			Send
		</button>
	</div>
	<div class="grid-2">
		<section class="panel">
			<div class="panel-head">Headers, one per line</div>
			<textarea id="ra-headers" spellcheck="false" aria-label="Headers">{headers}</textarea>
		</section>
		<section class="panel">
			<div class="panel-head">Body</div>
			<textarea id="ra-body" spellcheck="false" aria-label="Body" placeholder="Sent with POST, PUT and PATCH"></textarea>
		</section>
	</div>
	<div class="stats">
		<div class="stat">
			<b id="ra-status">—</b>
			<span>Status</span>
		</div>
		<div class="stat">
			<b id="ra-time">—</b>
			<span>Time</span>
		</div>
		<div class="stat">
			<b id="ra-size">—</b>
			<span>Size</span>
		</div>
	</div>
	<p class="error" id="ra-error" hidden></p>
	<section class="panel">
		<div class="panel-head">
			<div class="seg" id="ra-view" aria-label="Response view">
				<button data-value="body" aria-pressed="true">
					Body
				</button>
				<button data-value="headers" aria-pressed="false">
					Headers
				</button>
			</div>
			<button class="btn" id="ra-copy">
				Copy
			</button>
		</div>
		<pre class="out" id="ra-out"></pre>
	</section>
</ToolShell>

<script>
	import { byId, copyButton, onPage, segmented } from '../../scripts/ui';

	onPage('ra-tool', () => {
		const method = byId<HTMLSelectElement>('ra-method');
		const url = byId<HTMLInputElement>('ra-url');
		const out = byId('ra-out');
		const error = byId('ra-error');
		let view = 'body';
		let body = '';
		let head = '';

		const paint = () => (out.textContent = view === 'body' ? body : head);

		const send = async () => {
			error.hidden = true;
			byId('ra-status').textContent = '…';
			const headers = new Headers();
			for (const line of byId<HTMLTextAreaElement>('ra-headers').value.split('\n')) {
				const i = line.indexOf(':');
				if (i > 0) headers.set(line.slice(0, i).trim(), line.slice(i + 1).trim());
			}
			const hasBody = ['POST', 'PUT', 'PATCH', 'DELETE'].includes(method.value);
			const payload = byId<HTMLTextAreaElement>('ra-body').value;
			if (hasBody && payload && !headers.has('content-type')) {
				try {
					JSON.parse(payload);
					headers.set('Content-Type', 'application/json');
				} catch {}
			}
			const start = performance.now();
			try {
				const res = await fetch(url.value.trim(), { method: method.value, headers, body: hasBody && payload ? payload : undefined });
				const text = await res.text();
				byId('ra-time').textContent = `${Math.round(performance.now() - start)} ms`;
				const status = byId('ra-status');
				status.textContent = `${res.status} ${res.statusText}`.trim();
				status.dataset.kind = String(Math.floor(res.status / 100));
				const bytes = new TextEncoder().encode(text).length;
				byId('ra-size').textContent = bytes < 1024 ? `${bytes} B` : `${(bytes / 1024).toFixed(1)} KB`;
				try {
					body = JSON.stringify(JSON.parse(text), null, 2);
				} catch {
					body = text;
				}
				head = [...res.headers].map(([k, v]) => `${k}: ${v}`).join('\n');
			} catch {
				byId('ra-status').textContent = 'Failed';
				byId('ra-time').textContent = '—';
				byId('ra-size').textContent = '—';
				body = head = '';
				error.hidden = false;
				error.textContent =
					'The request did not go through. Check the URL, or the API may block browser calls (CORS). Only headers the server exposes are visible.';
			}
			paint();
		};

		segmented(byId('ra-view'), (v) => {
			view = v;
			paint();
		});
		byId('ra-send').addEventListener('click', send);
		url.addEventListener('keydown', (e) => {
			if (e.key === 'Enter') send();
		});
		copyButton(byId('ra-copy'), () => out.textContent ?? '');
		send();
	});
</script>

<style>
	.ra-bar {
		display: flex;
		gap: 8px;
		flex-wrap: wrap;
	}
	.ra-bar select,
	.ra-bar input {
		border: 1px solid var(--border);
		background: var(--surface);
		color: var(--ink);
		border-radius: 10px;
		padding: 9px 12px;
		font: inherit;
		font-family: var(--mono);
		font-size: 14px;
	}
	.ra-bar input {
		flex: 1;
		min-width: 0;
	}
	.ra-bar input:focus-visible,
	.ra-bar select:focus-visible {
		outline: 2px solid var(--accent-strong);
	}
	#ra-headers,
	#ra-body {
		min-height: 110px;
	}
	#ra-status[data-kind='2'] {
		color: var(--ok);
	}
	#ra-status[data-kind='4'],
	#ra-status[data-kind='5'] {
		color: var(--bad);
	}
	#ra-out {
		max-height: 480px;
		overflow: auto;
	}
</style>
