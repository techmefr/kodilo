---
import ToolShell from '../../components/ToolShell.astro';
---

<ToolShell
	slug="find-replace"
	title="Find and Replace"
	description="Find and replace text with plain strings or regular expressions. Replace all with $1 groups, match count and live preview."
>
	<div class="toolbar" id="fr-tool">
		<label class="check">
			Find <input class="num fr-field" id="fr-find" value="(\w+)@example\.com" spellcheck="false" />
		</label>
		<label class="check">
			Replace with <input class="num fr-field" id="fr-replace" value="$1@kodilo.dev" spellcheck="false" />
		</label>
	</div>
	<div class="toolbar">
		<label class="check">
			<input type="checkbox" id="fr-regex" checked /> Regular expression
		</label>
		<label class="check">
			<input type="checkbox" id="fr-case" /> Match case
		</label>
		<label class="check">
			<input type="checkbox" id="fr-word" /> Whole word
		</label>
	</div>
	<div class="error" id="fr-error" hidden></div>
	<div class="stats">
		<div class="stat">
			<b id="fr-count">0</b>
			<span>Matches</span>
		</div>
	</div>
	<div class="grid-2">
		<section class="panel">
			<div class="panel-head">Text</div>
			<textarea id="fr-in" spellcheck="false" aria-label="Text">Contact: ana@example.com, bob@example.com
Billing: ANA@EXAMPLE.COM
Not matched: carol@example.org</textarea>
		</section>
		<section class="panel">
			<div class="panel-head">
				<span>Result</span>
				<button class="btn" id="fr-copy">
					Copy
				</button>
			</div>
			<pre class="out" id="fr-out" tabindex="0"></pre>
		</section>
	</div>
</ToolShell>

<script>
	import { findReplace } from '../../scripts/find-replace';
	import { byId, copyButton, onPage } from '../../scripts/ui';

	onPage('fr-tool', () => {
		const input = byId<HTMLTextAreaElement>('fr-in');
		const find = byId<HTMLInputElement>('fr-find');
		const replace = byId<HTMLInputElement>('fr-replace');
		const regex = byId<HTMLInputElement>('fr-regex');
		const matchCase = byId<HTMLInputElement>('fr-case');
		const word = byId<HTMLInputElement>('fr-word');
		const output = byId('fr-out');
		const error = byId('fr-error');

		const render = () => {
			const result = findReplace(input.value, {
				pattern: find.value,
				regex: regex.checked,
				caseSensitive: matchCase.checked,
				wholeWord: word.checked,
				replacement: replace.value,
			});
			output.textContent = result.output;
			error.textContent = result.error;
			error.hidden = result.error === '';
			byId('fr-count').textContent = String(result.count);
		};

		[input, find, replace, regex, matchCase, word].forEach((el) => el.addEventListener('input', render));
		copyButton(byId('fr-copy'), () => output.textContent ?? '');
		render();
	});
</script>

<style>
	.fr-field {
		width: 220px;
		max-width: 100%;
		font-family: var(--mono);
	}
</style>
