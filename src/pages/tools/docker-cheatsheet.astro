---
import Cheatsheet from '../../components/Cheatsheet.astro';
import ToolShell from '../../components/ToolShell.astro';

const sections: [string, [string, string][]][] = [
	['Install & service', [['sudo apt install docker.io', 'Install on Debian, Ubuntu, Pop!_OS'], ['sudo dnf install docker', 'Install on Fedora, RHEL'], ['sudo pacman -S docker', 'Install on Arch Linux'], ['sudo usermod -aG docker $USER', 'Run docker without sudo (log out and back in)'], ['docker version', 'Client and server versions'], ['docker info', 'Daemon details: storage driver, cgroups, resources'], ['systemctl status docker', 'Service status'], ['sudo systemctl enable --now docker', 'Start now and on boot']]],
	['Run containers', [['docker run <image>', 'Run a container in the foreground'], ['docker run -d --name web -p 8080:80 nginx', 'Background, named, port Host:Container'], ['docker run -it --name <name> <image> sh', 'Interactive with a terminal'], ['docker run --rm -it alpine sh', 'Throwaway shell, removed on exit'], ['docker run --restart unless-stopped <image>', 'Restart automatically unless stopped by hand'], ['docker run -e KEY=value --env-file .env <image>', 'Environment variables'], ['docker run --memory 512m --cpus 1.5 <image>', 'Limit memory and CPU']]],
	['Manage containers', [['docker ps', 'Running containers'], ['docker ps -a', 'All containers, stopped ones included'], ['docker start <name>', 'Start a stopped container'], ['docker stop <name>', 'Graceful stop (SIGTERM, then SIGKILL)'], ['docker restart <name>', 'Restart'], ['docker rm -f <name>', 'Force remove'], ['docker rename <old> <new>', 'Rename a container'], ['docker update --restart always <name>', 'Change the restart policy of an existing container']]],
	['Debug & monitoring', [['docker logs -f --tail 100 <name>', 'Follow the last 100 log lines'], ['docker exec -it <name> sh', 'Shell into a running container (bash if available)'], ['docker stats', 'Live CPU and memory usage'], ['docker top <name>', 'Processes inside a container'], ['docker inspect <name>', 'Full JSON details: IP, mounts, config'], ["docker inspect -f '{{.State.ExitCode}}' <name>", 'Exit code of a stopped container'], ['docker port <name>', 'Published ports'], ['docker events', 'Stream daemon events']]],
	['Copy files', [['docker cp ./local <name>:/path', 'Host → container'], ['docker cp <name>:/path ./local', 'Container → host']]],
	['Images', [['docker images', 'List local images'], ['docker pull <image>', 'Download an image'], ['docker build -t app:1.0 .', 'Build from the Dockerfile here'], ['docker build --no-cache -t app .', 'Build without the layer cache'], ['docker buildx build --platform linux/amd64,linux/arm64 -t app --push .', 'Multi-arch build and push'], ['docker image inspect <image>', 'Image details'], ['docker history <image>', 'Layers and their sizes'], ['docker rmi <image>', 'Remove an image']]],
	['Volumes & storage', [['docker volume create <name>', 'Create a named volume'], ['docker volume ls', 'List volumes'], ['docker volume inspect <name>', 'Where a volume lives on disk'], ['docker volume rm <name>', 'Delete a volume'], ['docker run -v data:/data <image>', 'Mount a named volume'], ['docker run -v "$(pwd)":/app <image>', 'Bind mount the current directory'], ['docker run -v "$(pwd)":/app:ro <image>', 'Read-only bind mount']]],
	['Networks', [['docker network ls', 'List networks'], ['docker network create backend', 'Create a network'], ['docker network connect backend <name>', 'Attach a container'], ['docker network disconnect backend <name>', 'Detach a container'], ['docker network inspect backend', 'Containers and IPs on a network']]],
	['Compose', [['docker compose up -d', 'Start the stack in the background'], ['docker compose down', 'Stop and remove containers and networks'], ['docker compose down -v', 'Also remove named volumes'], ['docker compose ps', 'Services and their state'], ['docker compose logs -f <service>', 'Follow a service'], ['docker compose exec <service> sh', 'Shell into a service'], ['docker compose build --no-cache', 'Rebuild images from scratch'], ['docker compose pull && docker compose up -d', 'Update images and restart'], ['docker compose config', 'Show the resolved configuration']]],
	['Registries', [['docker login', 'Log in to Docker Hub'], ['docker login ghcr.io', 'Log in to another registry'], ['docker tag app:1.0 <user>/<repo>:1.0', 'Tag an image for upload'], ['docker push <user>/<repo>:1.0', 'Push to the registry']]],
	['Swarm & stacks', [['docker swarm init', 'Start a swarm cluster'], ['docker node ls', 'Nodes in the cluster'], ['docker service create --name <name> --replicas 3 <image>', 'Create a replicated service'], ['docker service scale <name>=5', 'Scale to 5 replicas'], ['docker service ls', 'List services'], ['docker stack deploy -c compose.yaml <stack>', 'Deploy a stack']]],
	['Cleanup', [['docker system df', 'Disk space used by Docker'], ['docker system prune', 'Stopped containers, unused networks, dangling images'], ['docker system prune -a', 'Deep clean: every unused image too'], ['docker image prune', 'Dangling (untagged) images only'], ['docker volume prune', 'Unused volumes'], ['docker builder prune', 'Build cache']]],
];
---

<ToolShell slug="docker-cheatsheet" title="Docker Cheatsheet" description="Docker, Compose and Swarm commands grouped by task, from install to cleanup. Filter them, click one to copy it.">
	<Cheatsheet id="dk-tool" placeholder="logs, prune, compose, volume…" sections={sections} />
</ToolShell>
