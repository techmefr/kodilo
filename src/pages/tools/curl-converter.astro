---
import ToolShell from '../../components/ToolShell.astro';

const sample = [
	"curl -X POST 'https://api.example.com/v1/users?notify=true' \\",
	"  -H 'Content-Type: application/json' \\",
	"  -H 'Authorization: Bearer eyJhbGciOi...' \\",
	`  -d '{"name":"Ada","role":"admin"}'`,
].join('\n');
---

<ToolShell
	slug="curl-converter"
	title="curl Converter"
	description="Turn a curl command into fetch, axios, Python requests, HTTPie or PHP. Headers, body, auth and method included."
>
	<section class="panel" id="curl-tool">
		<div class="panel-head">curl</div>
		<textarea id="curl-in" class="curl-in" spellcheck="false" aria-label="curl command">{sample}</textarea>
	</section>
	<p class="error" id="curl-error" hidden></p>
	<section class="panel">
		<div class="panel-head">
			<div class="seg" id="curl-lang">
				<button data-value="fetch" aria-pressed="true">fetch</button>
				<button data-value="axios">axios</button>
				<button data-value="python">Python</button>
				<button data-value="httpie">HTTPie</button>
				<button data-value="php">PHP</button>
			</div>
			<button class="btn" id="curl-copy">Copy</button>
		</div>
		<pre class="out" id="curl-out"></pre>
	</section>
</ToolShell>

<script>
	import { shellSplit } from '../../scripts/shell';
	import { byId, copyButton, onPage, segmented } from '../../scripts/ui';

	type Req = { method: string; url: string; headers: [string, string][]; body: string | null; form: [string, string][]; user: string | null; insecure: boolean };

	function parse(cmd: string): Req {
		const args = shellSplit(cmd);
		if (args[0] !== 'curl') throw new Error('The command must start with curl.');
		const req: Req = { method: '', url: '', headers: [], body: null, form: [], user: null, insecure: false };
		const data: string[] = [];
		let get = false;
		for (let i = 1; i < args.length; i++) {
			const a = args[i];
			const next = () => {
				if (i + 1 >= args.length) throw new Error(`${a} needs a value.`);
				return args[++i];
			};
			if (a === '-X' || a === '--request') req.method = next().toUpperCase();
			else if (a === '-H' || a === '--header') {
				const h = next();
				const idx = h.indexOf(':');
				if (idx > 0) req.headers.push([h.slice(0, idx).trim(), h.slice(idx + 1).trim()]);
			} else if (['-d', '--data', '--data-raw', '--data-binary', '--data-ascii'].includes(a)) data.push(next());
			else if (a === '--data-urlencode') {
				const v = next();
				const idx = v.indexOf('=');
				data.push(idx >= 0 ? `${v.slice(0, idx)}=${encodeURIComponent(v.slice(idx + 1))}` : encodeURIComponent(v));
			} else if (a === '--json') {
				data.push(next());
				req.headers.push(['Content-Type', 'application/json'], ['Accept', 'application/json']);
			} else if (a === '-F' || a === '--form') {
				const v = next();
				const idx = v.indexOf('=');
				req.form.push([v.slice(0, idx), v.slice(idx + 1)]);
			} else if (a === '-u' || a === '--user') req.user = next();
			else if (a === '-A' || a === '--user-agent') req.headers.push(['User-Agent', next()]);
			else if (a === '-b' || a === '--cookie') req.headers.push(['Cookie', next()]);
			else if (a === '-e' || a === '--referer') req.headers.push(['Referer', next()]);
			else if (a === '-G' || a === '--get') get = true;
			else if (a === '-k' || a === '--insecure') req.insecure = true;
			else if (a === '--url') req.url = next();
			else if (a === '-I' || a === '--head') req.method = 'HEAD';
			else if (['-o', '--output', '-w', '--write-out', '-m', '--max-time', '--connect-timeout', '-x', '--proxy'].includes(a)) next();
			else if (!a.startsWith('-')) req.url = a;
		}
		if (!req.url) throw new Error('No URL found.');
		if (!/^https?:\/\//.test(req.url)) req.url = `http://${req.url}`;
		if (data.length) {
			if (get) req.url += (req.url.includes('?') ? '&' : '?') + data.join('&');
			else req.body = data.join('&');
		}
		if (!req.method) req.method = req.body !== null || req.form.length ? 'POST' : 'GET';
		if (req.body !== null && !req.headers.some(([k]) => k.toLowerCase() === 'content-type')) req.headers.push(['Content-Type', 'application/x-www-form-urlencoded']);
		return req;
	}

	const isJson = (r: Req) => {
		if (r.body === null) return false;
		try {
			JSON.parse(r.body);
			return r.headers.some(([k, v]) => k.toLowerCase() === 'content-type' && v.includes('json'));
		} catch {
			return false;
		}
	};
	const indent = (s: string, n: number) => s.replace(/\n/g, `\n${' '.repeat(n)}`);
	const pyStr = (s: string) => JSON.stringify(s);
	const phpStr = (s: string) => `'${s.replace(/\\/g, '\\\\').replace(/'/g, "\\'")}'`;

	const GEN: Record<string, (r: Req) => string> = {
		fetch: (r) => {
			const headers = [...r.headers];
			if (r.user) headers.push(['Authorization', `Basic ${btoa(r.user)}`]);
			const opts = [`method: ${JSON.stringify(r.method)}`];
			if (headers.length) opts.push(`headers: {\n${headers.map(([k, v]) => `    ${JSON.stringify(k)}: ${JSON.stringify(v)}`).join(',\n')}\n  }`);
			if (r.form.length) opts.push('body: form');
			else if (r.body !== null) opts.push(`body: ${isJson(r) ? `JSON.stringify(${indent(JSON.stringify(JSON.parse(r.body), null, 2), 2)})` : JSON.stringify(r.body)}`);
			const form = r.form.length ? `const form = new FormData();\n${r.form.map(([k, v]) => `form.append(${JSON.stringify(k)}, ${JSON.stringify(v)});`).join('\n')}\n\n` : '';
			return `${form}const response = await fetch(${JSON.stringify(r.url)}, {\n  ${opts.join(',\n  ')}\n});\nconst data = await response.${r.method === 'HEAD' ? 'status' : 'json()'};`;
		},
		axios: (r) => {
			const opts = [`method: ${JSON.stringify(r.method.toLowerCase())}`, `url: ${JSON.stringify(r.url)}`];
			if (r.headers.length) opts.push(`headers: {\n${r.headers.map(([k, v]) => `    ${JSON.stringify(k)}: ${JSON.stringify(v)}`).join(',\n')}\n  }`);
			if (r.user) {
				const [u, p = ''] = r.user.split(/:(.*)/);
				opts.push(`auth: { username: ${JSON.stringify(u)}, password: ${JSON.stringify(p)} }`);
			}
			if (r.form.length) opts.push('data: form');
			else if (r.body !== null) opts.push(`data: ${isJson(r) ? indent(JSON.stringify(JSON.parse(r.body), null, 2), 2) : JSON.stringify(r.body)}`);
			const form = r.form.length ? `const form = new FormData();\n${r.form.map(([k, v]) => `form.append(${JSON.stringify(k)}, ${JSON.stringify(v)});`).join('\n')}\n\n` : '';
			return `import axios from 'axios';\n\n${form}const { data } = await axios({\n  ${opts.join(',\n  ')}\n});`;
		},
		python: (r) => {
			const lines = ['import requests', ''];
			const args = [pyStr(r.url)];
			const headers = r.headers.filter(([k]) => !(isJson(r) && k.toLowerCase() === 'content-type'));
			if (headers.length) {
				lines.push(`headers = {\n${headers.map(([k, v]) => `    ${pyStr(k)}: ${pyStr(v)},`).join('\n')}\n}`);
				args.push('headers=headers');
			}
			if (r.form.length) {
				lines.push(`files = {\n${r.form.map(([k, v]) => `    ${pyStr(k)}: ${v.startsWith('@') ? `open(${pyStr(v.slice(1))}, "rb")` : `(None, ${pyStr(v)})`},`).join('\n')}\n}`);
				args.push('files=files');
			} else if (r.body !== null) {
				if (isJson(r)) {
					lines.push(`payload = ${JSON.stringify(JSON.parse(r.body), null, 4).replace(/\btrue\b/g, 'True').replace(/\bfalse\b/g, 'False').replace(/\bnull\b/g, 'None')}`);
					args.push('json=payload');
				} else args.push(`data=${pyStr(r.body)}`);
			}
			if (r.user) {
				const [u, p = ''] = r.user.split(/:(.*)/);
				args.push(`auth=(${pyStr(u)}, ${pyStr(p)})`);
			}
			if (r.insecure) args.push('verify=False');
			if (lines.length > 2) lines.push('');
			lines.push(`response = requests.${r.method.toLowerCase()}(${args.join(', ')})`, 'print(response.status_code, response.text)');
			return lines.join('\n');
		},
		httpie: (r) => {
			const parts = ['http'];
			if (r.insecure) parts.push('--verify=no');
			if (r.form.length) parts.push('--form');
			else if (r.body !== null && !isJson(r)) parts.push('--form');
			if (r.user) parts.push('-a', `'${r.user}'`);
			parts.push(r.method, `'${r.url}'`);
			r.headers.filter(([k]) => !(k.toLowerCase() === 'content-type' && (isJson(r) || r.body !== null))).forEach(([k, v]) => parts.push(`'${k}:${v}'`));
			if (r.form.length) r.form.forEach(([k, v]) => parts.push(v.startsWith('@') ? `'${k}@${v.slice(1)}'` : `'${k}=${v}'`));
			else if (r.body !== null && isJson(r)) Object.entries(JSON.parse(r.body)).forEach(([k, v]) => parts.push(typeof v === 'string' ? `'${k}=${v}'` : `'${k}:=${JSON.stringify(v)}'`));
			else if (r.body !== null) new URLSearchParams(r.body).forEach((v, k) => parts.push(`'${k}=${v}'`));
			return parts.join(' ');
		},
		php: (r) => {
			const opts = [`CURLOPT_URL => ${phpStr(r.url)}`, 'CURLOPT_RETURNTRANSFER => true', `CURLOPT_CUSTOMREQUEST => ${phpStr(r.method)}`];
			if (r.headers.length) opts.push(`CURLOPT_HTTPHEADER => [\n${r.headers.map(([k, v]) => `        ${phpStr(`${k}: ${v}`)},`).join('\n')}\n    ]`);
			if (r.body !== null) opts.push(`CURLOPT_POSTFIELDS => ${phpStr(r.body)}`);
			if (r.form.length) opts.push(`CURLOPT_POSTFIELDS => [\n${r.form.map(([k, v]) => `        ${phpStr(k)} => ${v.startsWith('@') ? `new CURLFile(${phpStr(v.slice(1))})` : phpStr(v)},`).join('\n')}\n    ]`);
			if (r.user) opts.push(`CURLOPT_USERPWD => ${phpStr(r.user)}`);
			if (r.insecure) opts.push('CURLOPT_SSL_VERIFYPEER => false');
			return `<?php\n\n$ch = curl_init();\ncurl_setopt_array($ch, [\n    ${opts.join(',\n    ')},\n]);\n$response = curl_exec($ch);\ncurl_close($ch);`;
		},
	};

	onPage('curl-tool', () => {
		const input = byId<HTMLTextAreaElement>('curl-in');
		let lang = 'fetch';

		const render = () => {
			const error = byId('curl-error');
			try {
				byId('curl-out').textContent = GEN[lang](parse(input.value.trim()));
				error.hidden = true;
			} catch (e) {
				error.textContent = (e as Error).message;
				error.hidden = false;
			}
		};

		segmented(byId('curl-lang'), (v) => ((lang = v), render()));
		input.addEventListener('input', render);
		copyButton(byId('curl-copy'), () => byId('curl-out').textContent ?? '');
		render();
	});
</script>

<style>
	.curl-in {
		min-height: 130px !important;
	}
</style>
