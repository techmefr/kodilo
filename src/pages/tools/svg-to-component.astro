---
import ToolShell from '../../components/ToolShell.astro';

const sample = `<?xml version="1.0" encoding="UTF-8"?>
<!-- Generator: Adobe Illustrator 28.0 -->
<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#111827" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon">
  <title>Rocket</title>
  <metadata>created with a design tool</metadata>
  <path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/>
  <path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/>
  <circle cx="15.5" cy="8.5" r="1.5" fill="#111827" style="opacity: 0.8; stroke-width: 0"/>
</svg>`;
---

<ToolShell slug="svg-to-component" title="SVG to JSX, TSX & Vue" description="Paste an SVG and get a clean React (JSX or TSX) or Vue component, with size and color props. Attributes are renamed for you.">
	<div class="toolbar" id="sc-tool">
		<div class="seg" id="sc-target" aria-label="Output">
			<button data-value="jsx" aria-pressed="false">JSX</button>
			<button data-value="tsx" aria-pressed="true">TSX</button>
			<button data-value="vue" aria-pressed="false">Vue</button>
		</div>
		<label class="check">Name <input class="sc-name" id="sc-name" value="RocketIcon" spellcheck="false" /></label>
		<label class="check"><input type="checkbox" id="sc-props" checked /> size and color props</label>
		<label class="check"><input type="checkbox" id="sc-clean" checked /> Remove title and class</label>
	</div>
	<div class="grid-2">
		<section class="panel">
			<div class="panel-head">
				<span>SVG</span>
				<span class="sc-preview" id="sc-preview" aria-hidden="true"></span>
			</div>
			<textarea id="sc-in" spellcheck="false" aria-label="SVG input">{sample}</textarea>
		</section>
		<section class="panel">
			<div class="panel-head">
				<span id="sc-out-title">Component</span>
				<button class="btn" id="sc-copy">Copy</button>
			</div>
			<pre class="out" id="sc-out"></pre>
		</section>
	</div>
	<p class="error" id="sc-error" hidden></p>
	<p class="field-note" id="sc-note"></p>
</ToolShell>

<script>
	import { byId, copyButton, onPage, segmented } from '../../scripts/ui';

	type Target = 'jsx' | 'tsx' | 'vue';
	type Opts = { target: Target; props: boolean; clean: boolean };

	const DROP_TAGS = new Set(['metadata', 'desc', 'sodipodi:namedview', 'defs:empty']);
	const KEEP_KEBAB = /^(data-|aria-)/;
	const JSX_NAMES: Record<string, string> = { class: 'className', for: 'htmlFor', 'xlink:href': 'xlinkHref', 'xml:space': 'xmlSpace', 'xmlns:xlink': 'xmlnsXlink' };
	const SCRIPT = ['scr', 'ipt'].join('');
	const PAINT =new Set(['fill', 'stroke', 'stop-color', 'color']);

	const camel = (s: string) => s.replace(/[-:]([a-z])/g, (_, c) => c.toUpperCase());
	const pascal = (s: string) => {
		const p = s.replace(/[^A-Za-z0-9]+(.)?/g, (_, c) => (c ? c.toUpperCase() : '')).replace(/^./, (c) => c.toUpperCase());
		return /^[A-Z]/.test(p) ? p : `Svg${p}`;
	};
	const quote = (s: string) => `'${s.replace(/\\/g, '\\\\').replace(/'/g, "\\'")}'`;

	function styleObject(css: string): string {
		const parts = css
			.split(';')
			.map((d) => d.trim())
			.filter(Boolean)
			.map((d) => {
				const i = d.indexOf(':');
				const k = d.slice(0, i).trim();
				const v = d.slice(i + 1).trim();
				const key = k.startsWith('--') ? quote(k) : camel(k);
				return `${key}: ${/^-?\d+(\.\d+)?$/.test(v) ? v : quote(v)}`;
			});
		return `{{ ${parts.join(', ')} }}`;
	}

	function isColor(v: string) {
		return !/^(none|transparent|inherit|currentColor)$/i.test(v) && !v.startsWith('url(');
	}

	function attrs(el: Element, o: Opts, root: boolean, stats: { colors: Set<string> }): string[] {
		const out: string[] = [];
		const react = o.target !== 'vue';
		for (const a of [...el.attributes]) {
			let name = a.name;
			const value = a.value.trim();
			if (/^(sodipodi|inkscape|xmlns:(sodipodi|inkscape|serif|dc|cc|rdf)|data-name$)/.test(name)) continue;
			if (root && name === 'xmlns:xlink' && !el.ownerDocument.querySelector('[*|href]')) continue;
			if (o.clean && name === 'class') continue;
			if (root && o.props && (name === 'width' || name === 'height')) continue;
			if (o.props && PAINT.has(name) && isColor(value)) {
				stats.colors.add(value.toLowerCase());
				out.push(react ? `${camel(name)}={color}` : `:${name}="color"`);
				continue;
			}
			if (!react) {
				out.push(`${name}="${value.replace(/"/g, '&quot;')}"`);
				continue;
			}
			if (name === 'style') {
				out.push(`style=${styleObject(value)}`);
				continue;
			}
			name = JSX_NAMES[name] ?? (KEEP_KEBAB.test(name) ? name : camel(name));
			out.push(`${name}="${value.replace(/"/g, '&quot;')}"`);
		}
		if (root && react && !o.props) out.push('{...props}');
		if (root && o.props) out.push(...(react ? ['width={size}', 'height={size}', '{...props}'] : [':width="size"', ':height="size"']));
		return out;
	}

	function serialize(el: Element, o: Opts, depth: number, root: boolean, stats: { colors: Set<string> }): string {
		const pad = '  '.repeat(depth);
		const list = attrs(el, o, root, stats);
		const children: string[] = [];
		for (const node of [...el.childNodes]) {
			if (node.nodeType === Node.ELEMENT_NODE) {
				const child = node as Element;
				const tag = child.tagName;
				if (DROP_TAGS.has(tag) || tag.includes(':')) continue;
				if (o.clean && tag === 'title') continue;
				if (tag === 'defs' && !child.children.length) continue;
				children.push(serialize(child, o, depth + 1, false, stats));
			} else if (node.nodeType === Node.TEXT_NODE && node.textContent!.trim()) {
				const text = node.textContent!.trim();
				const safe = o.target === 'vue' ? text.replace(/</g, '&lt;') : /[{}<>]/.test(text) ? `{${JSON.stringify(text)}}` : text;
				children.push(`${pad}  ${safe}`);
			}
		}
		const oneLine = `<${el.tagName}${list.length ? ' ' + list.join(' ') : ''}`;
		const open = oneLine.length + pad.length > 100 ? `<${el.tagName}\n${list.map((a) => `${pad}  ${a}`).join('\n')}\n${pad}` : oneLine;
		if (!children.length) return `${pad}${open}${open.endsWith('\n' + pad) ? '' : ' '}/>`;
		return `${pad}${open}>\n${children.join('\n')}\n${pad}</${el.tagName}>`;
	}

	function convert(src: string, name: string, o: Opts) {
		const doc = new DOMParser().parseFromString(src.trim(), 'image/svg+xml');
		const err = doc.querySelector('parsererror');
		if (err) throw new Error(`Invalid SVG: ${(err.textContent ?? '').split('\n').find((l) => l.trim()) ?? 'check the markup'}`);
		const svg = doc.documentElement;
		if (svg.tagName !== 'svg') throw new Error('The root element must be <svg>.');
		if (o.props && !svg.getAttribute('viewBox')) {
			const w = parseFloat(svg.getAttribute('width') ?? '');
			const h = parseFloat(svg.getAttribute('height') ?? '');
			if (w && h) svg.setAttribute('viewBox', `0 0 ${w} ${h}`);
		}
		const size = svg.getAttribute('width')?.replace(/px$/, '') || '24';
		const sizeValue = /^\d+(\.\d+)?$/.test(size) ? size : quote(size);
		const stats = { colors: new Set<string>() };
		const comp = pascal(name || 'SvgIcon');

		if (o.target === 'vue') {
			const body = serialize(svg, o, 1, true, stats);
			const script = o.props
				? `<${SCRIPT} setup lang="ts">\nwithDefaults(defineProps<{ size?: number | string; color?: string }>(), {\n  size: ${sizeValue},\n  color: 'currentColor',\n});\n</${SCRIPT}>\n\n`
				: '';
			return { code: `${script}<template>\n${body}\n</template>\n`, stats, file: `${comp}.vue` };
		}
		const body = serialize(svg, o, 2, true, stats);
		const tsx = o.target === 'tsx';
		const args = o.props ? `{ size = ${sizeValue}, color = 'currentColor', ...props }${tsx ? `: ${comp}Props` : ''}` : tsx ? `props: SVGProps<SVGSVGElement>` : 'props';
		const head = tsx
			? `import type { SVGProps } from 'react';\n\n${o.props ? `type ${comp}Props = SVGProps<SVGSVGElement> & {\n  size?: number | string;\n  color?: string;\n};\n\n` : ''}`
			: '';
		return { code: `${head}export default function ${comp}(${args}) {\n  return (\n${body}\n  );\n}\n`, stats, file: `${comp}.${o.target}` };
	}

	onPage('sc-tool', () => {
		const input = byId<HTMLTextAreaElement>('sc-in');
		const name = byId<HTMLInputElement>('sc-name');
		const props = byId<HTMLInputElement>('sc-props');
		const clean = byId<HTMLInputElement>('sc-clean');
		const out = byId('sc-out');
		const error = byId('sc-error');
		let target: Target = 'tsx';

		const render = () => {
			try {
				const r = convert(input.value, name.value, { target, props: props.checked, clean: clean.checked });
				out.textContent = r.code;
				error.hidden = true;
				byId('sc-out-title').textContent = r.file;
				byId('sc-note').textContent = r.stats.colors.size > 1 ? `${r.stats.colors.size} different colors were replaced by the color prop. Untick "size and color props" to keep a multicolor SVG as it is.` : '';
				const doc = new DOMParser().parseFromString(input.value.trim(), 'image/svg+xml');
				const preview = byId('sc-preview');
				preview.replaceChildren();
				if (doc.documentElement.tagName === 'svg') {
					doc.querySelectorAll('script, foreignObject').forEach((n) => n.remove());
					[...doc.querySelectorAll('*')].forEach((n) => [...n.attributes].forEach((a) => /^on/i.test(a.name) && n.removeAttribute(a.name)));
					preview.append(document.importNode(doc.documentElement, true));
				}
			} catch (e) {
				error.hidden = false;
				error.textContent = (e as Error).message;
				out.textContent = '';
			}
		};

		segmented(byId('sc-target'), (v) => {
			target = v as Target;
			render();
		});
		[input, name].forEach((el) => el.addEventListener('input', render));
		[props, clean].forEach((el) => el.addEventListener('change', render));
		copyButton(byId('sc-copy'), () => out.textContent ?? '');
		render();
	});
</script>

<style>
	#sc-in {
		min-height: 360px;
	}
	.sc-name {
		border: 1px solid var(--border);
		background: var(--surface);
		color: var(--ink);
		border-radius: 8px;
		padding: 5px 8px;
		font-family: var(--mono);
		font-size: 13px;
		width: 140px;
	}
	.sc-preview {
		display: grid;
		place-items: center;
		width: 28px;
		height: 28px;
		color: var(--ink);
	}
	.sc-preview :global(svg) {
		max-width: 24px;
		max-height: 24px;
	}
</style>
