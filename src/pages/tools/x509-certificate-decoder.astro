MIIB/jCCAaSgAwIBAgIUNTWlRR8lYCQLTXpfqS6H9U/bMSswCgYIKoZIzj0EAwIw
PDELMAkGA1UEBhMCRlIxFzAVBgNVBAoMDktvZGlsbyBFeGFtcGxlMRQwEgYDVQQD
DAtleGFtcGxlLmNvbTAeFw0yNjA5MjQwOTI2MjFaFw0yNzEwMjYwOTI2MjFaMDwx
CzAJBgNVBAYTAkZSMRcwFQYDVQQKDA5Lb2RpbG8gRXhhbXBsZTEUMBIGA1UEAwwL
ZXhhbXBsZS5jb20wWTATBgcqhkjOPQIBBggqhkjOPQMBBwNCAAThf0V7GfklACx8
1VqkObbuKLYHWKMXf/v7uEsF75fv+Hy+IEVvwIhHBbWcXwxDUa6f3TnQxagmhkc5
vgdzcjKEo4GDMIGAMB0GA1UdDgQWBBT9hXDgDTkndIZPURdbEGZA6QEmiDAfBgNV
HSMEGDAWgBT9hXDgDTkndIZPURdbEGZA6QEmiDAPBgNVHRMBAf8EBTADAQH/MC0G
A1UdEQQmMCSCC2V4YW1wbGUuY29tgg93d3cuZXhhbXBsZS5jb22HBMAAAgowCgYI
KoZIzj0EAwIDSAAwRQIgFhThZEHw29YSa3XZMESIP8B0qiiJMM1D4FQqpJ8i1O8C
IQCPbJbzlwEbCXc0zw69xIwVsGLRf8uNk8y9rK710jMBvw==
-----END CERTIFICATE-----`;
---

<ToolShell
	slug="x509-certificate-decoder"
	title="X.509 Certificate Decoder"
	description="Paste a PEM certificate to read its subject, issuer, SANs, validity, key and fingerprints. Nothing leaves your browser."
>
	<section class="panel" id="xc-tool">
		<div class="panel-head">PEM certificate</div>
		<textarea id="xc-in" spellcheck="false" aria-label="PEM certificate">{sample}</textarea>
	</section>
	<p class="error" id="xc-error" hidden></p>
	<div class="stats" id="xc-stats">
		<div class="stat">
			<b id="xc-status">—</b>
			<span>Status</span>
		</div>
		<div class="stat">
			<b id="xc-days">—</b>
			<span>Days left</span>
		</div>
		<div class="stat">
			<b id="xc-key">—</b>
			<span>Public key</span>
		</div>
	</div>
	<section class="panel">
		<div class="panel-head">Details</div>
		<dl class="xc-list" id="xc-list"></dl>
	</section>
</ToolShell>

<script>
	import 'reflect-metadata';
	import {
		BasicConstraintsExtension,
		ExtendedKeyUsageExtension,
		KeyUsageFlags,
		KeyUsagesExtension,
		SubjectAlternativeNameExtension,
		X509Certificate,
	} from '@peculiar/x509';
	import { byId, onPage } from '../../scripts/ui';

	const EKU: Record<string, string> = {
		'1.3.6.1.5.5.7.3.1': 'TLS server',
		'1.3.6.1.5.5.7.3.2': 'TLS client',
		'1.3.6.1.5.5.7.3.3': 'Code signing',
		'1.3.6.1.5.5.7.3.4': 'Email protection',
		'1.3.6.1.5.5.7.3.8': 'Time stamping',
		'1.3.6.1.5.5.7.3.9': 'OCSP signing',
	};
	const hex = (b: ArrayBuffer) => [...new Uint8Array(b)].map((x) => x.toString(16).padStart(2, '0').toUpperCase()).join(':');
	const date = (d: Date) =>
		d
			.toISOString()
			.replace('T', ' ')
			.replace(/\.\d+Z$/, ' UTC');

	onPage('xc-tool', () => {
		const input = byId<HTMLTextAreaElement>('xc-in');
		let run = 0;

		const render = async () => {
			const current = ++run;
			const error = byId('xc-error');
			const pem = input.value.match(/-----BEGIN CERTIFICATE-----[\s\S]+?-----END CERTIFICATE-----/)?.[0];
			let cert: X509Certificate;
			try {
				if (!pem) throw new Error('No "BEGIN CERTIFICATE" block found. Paste a PEM certificate.');
				cert = new X509Certificate(pem);
			} catch (e) {
				error.hidden = false;
				error.textContent = (e as Error).message.startsWith('No')
					? (e as Error).message
					: 'This certificate could not be decoded. Check that the PEM block is complete.';
				byId('xc-list').replaceChildren();
				return;
			}
			error.hidden = true;
			const now = Date.now();
			const left = Math.floor((cert.notAfter.getTime() - now) / 86400000);
			const status = byId('xc-status');
			const state = now < cert.notBefore.getTime() ? 'Not yet valid' : left < 0 ? 'Expired' : left < 30 ? 'Expires soon' : 'Valid';
			status.textContent = state;
			status.dataset.kind = state === 'Valid' ? 'ok' : state === 'Expires soon' ? 'warn' : 'bad';
			byId('xc-days').textContent = String(left);
			const alg = cert.publicKey.algorithm as { name: string; namedCurve?: string; modulusLength?: number };
			byId('xc-key').textContent = alg.namedCurve ? `${alg.name} ${alg.namedCurve}` : alg.modulusLength ? `RSA ${alg.modulusLength}` : alg.name;

			const san = cert.getExtension(SubjectAlternativeNameExtension);
			const ku = cert.getExtension(KeyUsagesExtension);
			const eku = cert.getExtension(ExtendedKeyUsageExtension);
			const bc = cert.getExtension(BasicConstraintsExtension);
			const usages = ku
				? Object.entries(KeyUsageFlags)
						.filter(([k, v]) => isNaN(Number(k)) && typeof v === 'number' && ku.usages & v)
						.map(([k]) => k)
						.join(', ')
				: '';
			const [sha1, sha256] = await Promise.all([cert.getThumbprint('SHA-1'), cert.getThumbprint('SHA-256')]);
			if (current !== run) return;
			const rows: [string, string][] = [
				['Subject', cert.subject],
				['Issuer', cert.issuer + (cert.subject === cert.issuer ? '  (self-signed)' : '')],
				['Alternative names', san ? san.names.items.map((n) => `${n.type.toUpperCase()}: ${n.value}`).join('\n') : 'None'],
				['Valid from', date(cert.notBefore)],
				['Valid until', date(cert.notAfter)],
				['Serial number', cert.serialNumber.toUpperCase()],
				[
					'Signature',
					(cert.signatureAlgorithm as { name: string; hash?: { name: string } }).name +
						((cert.signatureAlgorithm as { hash?: { name: string } }).hash ? ` with ${(cert.signatureAlgorithm as { hash: { name: string } }).hash.name}` : ''),
				],
				['Certificate authority', bc ? (bc.ca ? `Yes${bc.pathLength !== undefined ? `, path length ${bc.pathLength}` : ''}` : 'No') : 'Not stated'],
				['Key usage', usages || 'Not stated'],
				['Extended key usage', eku ? eku.usages.map((u) => EKU[String(u)] ?? String(u)).join(', ') : 'Not stated'],
				['SHA-256 fingerprint', hex(sha256)],
				['SHA-1 fingerprint', hex(sha1)],
			];
			byId('xc-list').replaceChildren(
				...rows.flatMap(([k, v]) => {
					const dt = document.createElement('dt');
					dt.textContent = k;
					const dd = document.createElement('dd');
					dd.textContent = v;
					return [dt, dd];
				}),
			);
		};

		input.addEventListener('input', render);
		render();
	});
</script>

<style>
	#xc-in {
		min-height: 200px;
	}
	.xc-list {
		margin: 0;
		padding: 6px 14px 12px;
		display: grid;
		grid-template-columns: 190px 1fr;
		gap: 0 16px;
	}
	.xc-list :global(dt),
	.xc-list :global(dd) {
		margin: 0;
		padding: 8px 0;
		border-bottom: 1px solid var(--border);
	}
	.xc-list :global(dt) {
		font-size: 13px;
		color: var(--ink-soft);
	}
	.xc-list :global(dd) {
		font-family: var(--mono);
		font-size: 13.5px;
		white-space: pre-wrap;
		overflow-wrap: anywhere;
	}
	#xc-status[data-kind='ok'] {
		color: var(--ok);
	}
	#xc-status[data-kind='warn'] {
		color: var(--warn);
	}
	#xc-status[data-kind='bad'] {
		color: var(--bad);
	}
	@media (max-width: 560px) {
		.xc-list {
			grid-template-columns: 1fr;
		}
		.xc-list :global(dt) {
			border-bottom: 0;
			padding-bottom: 0;
		}
	}
</style>
