---
import ToolShell from '../../components/ToolShell.astro';

const sample = `10.0.0.0/25
10.0.0.128/25
10.0.1.0/24
192.168.1.10
192.168.1.11-192.168.1.20
172.16.0.0/16`;
const excludeSample = `172.16.5.0/24`;
---

<ToolShell
	slug="cidr-aggregator"
	title="CIDR Aggregator & Splitter"
	description="Merge IPv4 addresses, ranges and CIDRs into the smallest CIDR list, subtract exclusions, or split a network into equal subnets."
>
	<div class="toolbar" id="ca-tool">
		<div class="seg" id="ca-mode" aria-label="Mode">
			<button data-value="merge" aria-pressed="true">
				Aggregate
			</button>
			<button data-value="split" aria-pressed="false">
				Split
			</button>
		</div>
	</div>
	<div id="ca-merge" class="ca-stack">
		<div class="grid-2">
			<section class="panel">
				<div class="panel-head">
					<span>Include · one per line</span>
				</div>
				<textarea id="ca-in" spellcheck="false" aria-label="Addresses, ranges or CIDRs to include">{sample}</textarea>
			</section>
			<section class="panel">
				<div class="panel-head">
					<span>Exclude</span>
				</div>
				<textarea id="ca-ex" spellcheck="false" aria-label="CIDRs to exclude">{excludeSample}</textarea>
			</section>
		</div>
		<div class="stats">
			<div class="stat">
				<b id="ca-count">0</b>
				<span>CIDR blocks</span>
			</div>
			<div class="stat">
				<b id="ca-total">0</b>
				<span>Addresses</span>
			</div>
			<div class="stat">
				<b id="ca-inputs">0</b>
				<span>Input entries</span>
			</div>
		</div>
		<p class="error" id="ca-error" hidden></p>
		<section class="panel">
			<div class="panel-head">
				<span>Merged CIDRs</span>
				<button class="btn" id="ca-copy">
					Copy
				</button>
			</div>
			<pre class="out" id="ca-out" tabindex="0" aria-label="Merged CIDR list"></pre>
		</section>
	</div>
	<div id="ca-split" class="ca-stack" hidden>
		<div class="fields">
			<div class="field">
				<label for="ca-net">Network</label>
				<input id="ca-net" spellcheck="false" value="10.0.0.0/24" />
			</div>
			<div class="field">
				<label for="ca-by">Split into</label>
				<select id="ca-by">
					<option value="count">N subnets</option>
					<option value="prefix">subnets of prefix</option>
				</select>
			</div>
			<div class="field">
				<label for="ca-n">Value</label>
				<input id="ca-n" spellcheck="false" inputmode="numeric" value="4" />
			</div>
		</div>
		<p class="error" id="ca-split-error" hidden></p>
		<section class="panel">
			<div class="panel-head">
				<span id="ca-split-head">Subnets</span>
				<button class="btn" id="ca-split-copy">
					Copy
				</button>
			</div>
			<pre class="out" id="ca-split-out" tabindex="0" aria-label="Subnets"></pre>
		</section>
	</div>
</ToolShell>

<script>
	import { byId, copyButton, onPage, segmented } from '../../scripts/ui';

	type Range = [number, number];
	const TWO32 = 2 ** 32;

	const ip = (s: string) => {
		const p = s.trim().split('.');
		if (p.length !== 4 || p.some((x) => !/^\d{1,3}$/.test(x) || Number(x) > 255)) throw new Error(`Invalid address "${s.trim()}"`);
		return p.reduce((a, x) => a * 256 + Number(x), 0);
	};
	const str = (n: number) => [n >>> 24, (n >>> 16) & 255, (n >>> 8) & 255, n & 255].join('.');
	const cidr = (s: string): Range => {
		const [a, b] = s.split('/');
		const pre = Number(b);
		if (!/^\d{1,2}$/.test(b) || pre > 32) throw new Error(`Invalid prefix in "${s}"`);
		const size = 2 ** (32 - pre);
		const start = Math.floor(ip(a) / size) * size;
		return [start, start + size - 1];
	};
	const parse = (line: string): Range => {
		const t = line.trim();
		if (t.includes('/')) return cidr(t);
		if (t.includes('-')) {
			const [a, b] = t.split('-');
			const r: Range = [ip(a), ip(b)];
			if (r[0] > r[1]) throw new Error(`Range "${t}" ends before it starts`);
			return r;
		}
		const n = ip(t);
		return [n, n];
	};
	const merge = (ranges: Range[]) => {
		const sorted = [...ranges].sort((a, b) => a[0] - b[0]);
		const out: Range[] = [];
		for (const r of sorted) {
			const last = out[out.length - 1];
			if (last && r[0] <= last[1] + 1) last[1] = Math.max(last[1], r[1]);
			else out.push([r[0], r[1]]);
		}
		return out;
	};
	const subtract = (ranges: Range[], ex: Range[]) => {
		let cur = ranges;
		for (const [es, ee] of merge(ex)) {
			const next: Range[] = [];
			for (const [s, e] of cur) {
				if (ee < s || es > e) next.push([s, e]);
				else {
					if (s < es) next.push([s, es - 1]);
					if (e > ee) next.push([ee + 1, e]);
				}
			}
			cur = next;
		}
		return cur;
	};
	const toCidrs = ([s, e]: Range) => {
		const out: string[] = [];
		let start = s;
		while (start <= e) {
			let size = 1;
			while (size < TWO32 && start % (size * 2) === 0 && start + size * 2 - 1 <= e) size *= 2;
			out.push(`${str(start)}/${32 - Math.log2(size)}`);
			start += size;
		}
		return out;
	};
	const lines = (id: string) =>
		byId<HTMLTextAreaElement>(id)
			.value.split(/[\n,;]+/)
			.map((l) => l.replace(/#.*/, '').trim())
			.filter(Boolean);

	onPage('ca-tool', () => {
		const render = () => {
			const error = byId('ca-error');
			const problems: string[] = [];
			const collect = (id: string) =>
				lines(id).flatMap((l) => {
					try {
						return [parse(l)];
					} catch (e) {
						problems.push((e as Error).message);
						return [];
					}
				});
			const inc = lines('ca-in');
			const ranges = subtract(merge(collect('ca-in')), collect('ca-ex'));
			const blocks = ranges.flatMap(toCidrs);
			const total = ranges.reduce((a, [s, e]) => a + e - s + 1, 0);
			byId('ca-out').textContent = blocks.join('\n');
			byId('ca-count').textContent = String(blocks.length);
			byId('ca-total').textContent = total.toLocaleString('en-US');
			byId('ca-inputs').textContent = String(inc.length);
			error.hidden = !problems.length;
			error.textContent = problems.join('\n');
		};

		const split = () => {
			const error = byId('ca-split-error');
			const out = byId('ca-split-out');
			try {
				const net = byId<HTMLInputElement>('ca-net').value.trim();
				const [s, e] = cidr(net.includes('/') ? net : `${net}/32`);
				const base = 32 - Math.log2(e - s + 1);
				const v = Number(byId<HTMLInputElement>('ca-n').value.trim());
				if (!Number.isInteger(v) || v < 1) throw new Error('Enter a positive whole number');
				let pre: number;
				if (byId<HTMLSelectElement>('ca-by').value === 'count') pre = base + Math.ceil(Math.log2(v));
				else {
					if (v > 32 || v < base) throw new Error(`Prefix must be between /${base} and /32`);
					pre = v;
				}
				if (pre > 32) throw new Error(`A /${base} cannot be split into ${v} subnets`);
				const size = 2 ** (32 - pre);
				const count = (e - s + 1) / size;
				if (count > 4096) throw new Error(`That gives ${count.toLocaleString('en-US')} subnets, pick a shorter prefix`);
				const rows: string[] = [];
				for (let i = 0; i < count; i++) {
					const a = s + i * size;
					rows.push(`${`${str(a)}/${pre}`.padEnd(19)}${str(a)} – ${str(a + size - 1)}  (${size.toLocaleString('en-US')})`);
				}
				byId('ca-split-head').textContent = `${count} subnets of /${pre}`;
				out.textContent = rows.join('\n');
				error.hidden = true;
			} catch (err) {
				error.hidden = false;
				error.textContent = (err as Error).message;
				out.textContent = '';
			}
		};

		segmented(byId('ca-mode'), (m) => {
			byId('ca-merge').hidden = m !== 'merge';
			byId('ca-split').hidden = m !== 'split';
		});
		byId('ca-in').addEventListener('input', render);
		byId('ca-ex').addEventListener('input', render);
		['ca-net', 'ca-by', 'ca-n'].forEach((id) => byId(id).addEventListener('input', split));
		copyButton(byId('ca-copy'), () => byId('ca-out').textContent ?? '');
		copyButton(byId('ca-split-copy'), () =>
			(byId('ca-split-out').textContent ?? '')
				.split('\n')
				.map((l) => l.split(' ')[0])
				.join('\n'),
		);
		render();
		split();
	});
</script>

<style>
	.ca-stack {
		display: flex;
		flex-direction: column;
		gap: 16px;
	}
	.ca-stack[hidden] {
		display: none;
	}
	#ca-in,
	#ca-ex {
		min-height: 200px;
	}
	#ca-out,
	#ca-split-out {
		overflow: auto;
		white-space: pre;
		word-break: normal;
	}
	#ca-error,
	#ca-split-error {
		white-space: pre-line;
		margin: 0;
	}
</style>
