---
import ToolShell from '../../components/ToolShell.astro';

const sample = [
	'{"level":30,"time":1790000000000,"msg":"server listening","port":3000}',
	'{"level":"info","timestamp":"2026-09-24T08:01:12.120Z","message":"GET /api/users 200","duration_ms":42,"user":"ada"}',
	'{"level":"warn","timestamp":"2026-09-24T08:01:13.500Z","message":"slow query","duration_ms":1840,"table":"orders"}',
	'{"level":50,"time":1790000075000,"msg":"payment failed","err":{"type":"TimeoutError","message":"upstream timed out"},"order":"A-1042"}',
	'{"level_name":"DEBUG","datetime":"2026-09-24T08:01:20+00:00","message":"cache miss","context":{"key":"user:42"}}',
	'not a json line',
	'{"severity":"ERROR","ts":"2026-09-24T08:02:00Z","msg":"disk almost full","used":"93%"}',
].join('\n');
---

<ToolShell
	slug="json-log-viewer"
	title="JSON Log Viewer"
	description="Paste JSON lines from pino, winston, Monolog, Docker or any structured logger. Filter by level and text, read them as a table."
>
	<section class="panel" id="log-tool">
		<div class="panel-head">Logs · one JSON object per line</div>
		<textarea id="log-in" class="log-in" spellcheck="false" aria-label="Log lines">{sample}</textarea>
	</section>
	<div class="toolbar">
		<div class="chips" id="log-levels">
			<button data-value="debug" aria-pressed="true">debug</button>
			<button data-value="info" aria-pressed="true">info</button>
			<button data-value="warn" aria-pressed="true">warn</button>
			<button data-value="error" aria-pressed="true">error</button>
		</div>
		<input class="log-search" id="log-q" type="search" placeholder="Filter: text or field=value" aria-label="Filter logs" />
	</div>
	<p class="log-count" id="log-count"></p>
	<div class="log-wrap">
		<table class="log-table">
			<thead><tr><th>Time</th><th>Level</th><th>Message</th><th>Fields</th></tr></thead>
			<tbody id="log-body"></tbody>
		</table>
	</div>
</ToolShell>

<script>
	import { byId, onPage } from '../../scripts/ui';

	type Entry = { time: string; level: string; msg: string; fields: Record<string, unknown>; raw: string; bad?: boolean };

	const TIME_KEYS = ['time', 'timestamp', 'ts', '@timestamp', 'datetime', 'date'];
	const LEVEL_KEYS = ['level', 'severity', 'level_name', 'lvl', 'loglevel'];
	const MSG_KEYS = ['msg', 'message', 'text', 'event'];

	const levelName = (v: unknown): string => {
		if (typeof v === 'number') return v >= 50 ? 'error' : v >= 40 ? 'warn' : v >= 30 ? 'info' : 'debug';
		const s = String(v ?? '').toLowerCase();
		if (/err|crit|fatal|alert|emerg/.test(s)) return 'error';
		if (/warn/.test(s)) return 'warn';
		if (/debug|trace|verbose/.test(s)) return 'debug';
		return 'info';
	};

	const formatTime = (v: unknown) => {
		if (v === undefined) return '';
		const d = typeof v === 'number' ? new Date(v < 1e12 ? v * 1000 : v) : new Date(String(v));
		return Number.isNaN(d.getTime()) ? String(v) : d.toISOString().replace('T', ' ').replace('Z', '');
	};

	const take = (obj: Record<string, unknown>, keys: string[]) => {
		const k = keys.find((key) => key in obj);
		if (!k) return undefined;
		const v = obj[k];
		delete obj[k];
		return v;
	};

	onPage('log-tool', () => {
		const input = byId<HTMLTextAreaElement>('log-in');
		const q = byId<HTMLInputElement>('log-q');
		const levels = new Set(['debug', 'info', 'warn', 'error']);

		const render = () => {
			const entries: Entry[] = input.value
				.split('\n')
				.filter((l) => l.trim())
				.map((raw) => {
					try {
						const obj = JSON.parse(raw);
						if (typeof obj !== 'object' || obj === null) throw 0;
						const time = formatTime(take(obj, TIME_KEYS));
						const level = levelName(take(obj, LEVEL_KEYS));
						const msg = String(take(obj, MSG_KEYS) ?? '');
						return { time, level, msg, fields: obj, raw };
					} catch {
						return { time: '', level: 'info', msg: raw, fields: {}, raw, bad: true };
					}
				});
			const term = q.value.trim();
			const kv = term.match(/^([\w.]+)\s*=\s*(.+)$/);
			const shown = entries.filter((e) => {
				if (!levels.has(e.level)) return false;
				if (!term) return true;
				if (kv) {
					const v = kv[1].split('.').reduce<unknown>((o, k) => (o && typeof o === 'object' ? (o as Record<string, unknown>)[k] : undefined), e.fields);
					return v !== undefined && String(v).toLowerCase() === kv[2].toLowerCase();
				}
				return e.raw.toLowerCase().includes(term.toLowerCase());
			});
			const counts = { debug: 0, info: 0, warn: 0, error: 0 } as Record<string, number>;
			entries.forEach((e) => counts[e.level]++);
			document.querySelectorAll<HTMLButtonElement>('#log-levels button').forEach((b) => (b.textContent = `${b.dataset.value} · ${counts[b.dataset.value!]}`));
			byId('log-count').textContent = `${shown.length} of ${entries.length} lines${entries.some((e) => e.bad) ? ` · ${entries.filter((e) => e.bad).length} not JSON` : ''}`;
			byId('log-body').replaceChildren(
				...shown.map((e) => {
					const tr = document.createElement('tr');
					tr.className = `log-${e.level}${e.bad ? ' log-bad' : ''}`;
					const cells = [e.time, e.bad ? '—' : e.level, e.msg, Object.entries(e.fields).map(([k, v]) => `${k}=${typeof v === 'object' ? JSON.stringify(v) : v}`).join('  ')];
					cells.forEach((c, i) => {
						const td = document.createElement('td');
						td.textContent = c;
						if (i === 1) td.className = 'log-level';
						tr.append(td);
					});
					return tr;
				})
			);
		};

		document.querySelectorAll<HTMLButtonElement>('#log-levels button').forEach((b) =>
			b.addEventListener('click', () => {
				const on = b.getAttribute('aria-pressed') !== 'true';
				b.setAttribute('aria-pressed', String(on));
				if (on) levels.add(b.dataset.value!);
				else levels.delete(b.dataset.value!);
				render();
			})
		);
		[input, q].forEach((el) => el.addEventListener('input', render));
		render();
	});
</script>

<style>
	.log-in {
		min-height: 160px !important;
	}
	.log-search {
		flex: 1 1 220px;
		border: 1px solid var(--border);
		border-radius: 10px;
		padding: 8px 12px;
		background: var(--surface);
		color: var(--ink);
		font: inherit;
	}
	.log-count {
		margin: 0;
		font-size: 13px;
		color: var(--ink-soft);
	}
	.log-wrap {
		overflow-x: auto;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: 14px;
	}
	.log-table {
		width: 100%;
		border-collapse: collapse;
		font-family: var(--mono);
		font-size: 12px;
	}
	.log-table th {
		text-align: left;
		font-family: var(--sans);
		font-size: 12px;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: var(--ink-soft);
		padding: 9px 12px;
		border-bottom: 1px solid var(--border);
	}
	.log-table :global(td) {
		padding: 7px 12px;
		border-bottom: 1px solid var(--border);
		vertical-align: top;
	}
	.log-table :global(td:first-child) {
		white-space: nowrap;
		color: var(--ink-soft);
	}
	.log-table :global(td:last-child) {
		color: var(--ink-soft);
		overflow-wrap: anywhere;
	}
	.log-table :global(.log-level) {
		font-weight: 700;
		text-transform: uppercase;
	}
	.log-table :global(.log-error .log-level) {
		color: #e5484d;
	}
	.log-table :global(.log-warn .log-level) {
		color: var(--warn);
	}
	.log-table :global(.log-info .log-level) {
		color: var(--accent-strong);
	}
	.log-table :global(.log-debug .log-level) {
		color: var(--ink-soft);
	}
	.log-table :global(.log-bad) {
		opacity: 0.6;
	}
</style>
