---
import ToolShell from '../../components/ToolShell.astro';
---

<ToolShell slug="slugify" title="Slugify" description="Turn any title into a clean URL slug. Accents are transliterated, one slug per line.">
	<div class="toolbar" id="slug-tool">
		<div class="seg" id="slug-sep" aria-label="Separator">
			<button data-value="-" aria-pressed="true">
				kebab-case
			</button>
			<button data-value="_" aria-pressed="false">
				snake_case
			</button>
			<button data-value="." aria-pressed="false">
				dot.case
			</button>
		</div>
		<label class="check">
			<input type="checkbox" id="slug-lower" checked /> Lowercase
		</label>
		<label class="check">
			Max length <input class="num" type="number" id="slug-max" min="0" value="0" />
		</label>
	</div>
	<div class="grid-2">
		<section class="panel">
			<div class="panel-head">Titles</div>
			<textarea id="slug-in" spellcheck="false" aria-label="Titles">Crème brûlée à l'été — 10 recettes faciles !
Straße & Größe: Ærøskøbing Ångström
Ship It Before Friday, Part 2</textarea>
		</section>
		<section class="panel">
			<div class="panel-head">
				<span>Slugs</span>
				<button class="btn" id="slug-copy">
					Copy
				</button>
			</div>
			<pre class="out" id="slug-out"></pre>
		</section>
	</div>
</ToolShell>

<script>
	import { byId, copyButton, onPage, segmented } from '../../scripts/ui';

	const SPECIAL: Record<string, string> = {
		ß: 'ss',
		æ: 'ae',
		Æ: 'AE',
		ø: 'o',
		Ø: 'O',
		œ: 'oe',
		Œ: 'OE',
		ł: 'l',
		Ł: 'L',
		đ: 'd',
		Đ: 'D',
		þ: 'th',
		Þ: 'TH',
		'&': ' and ',
	};

	function slugify(text: string, sep: string, lower: boolean, max: number): string {
		let slug = text
			.replace(/[ßæÆøØœŒłŁđĐþÞ&]/g, (c) => SPECIAL[c])
			.normalize('NFKD')
			.replace(/\p{M}/gu, '')
			.replace(/[^\p{L}\p{N}]+/gu, sep)
			.replace(new RegExp(`^\\${sep}+|\\${sep}+$`, 'g'), '');
		if (lower) slug = slug.toLowerCase();
		if (max > 0 && slug.length > max) slug = slug.slice(0, max).replace(new RegExp(`\\${sep}+$`), '');
		return slug;
	}

	onPage('slug-tool', () => {
		const input = byId<HTMLTextAreaElement>('slug-in');
		const output = byId('slug-out');
		const lower = byId<HTMLInputElement>('slug-lower');
		const max = byId<HTMLInputElement>('slug-max');
		let sep = '-';

		const render = () => {
			output.textContent = input.value
				.split('\n')
				.map((line) => slugify(line, sep, lower.checked, Number(max.value) || 0))
				.join('\n');
		};

		segmented(byId('slug-sep'), (value) => {
			sep = value;
			render();
		});
		[input, lower, max].forEach((el) => el.addEventListener('input', render));
		copyButton(byId('slug-copy'), () => output.textContent ?? '');
		render();
	});
</script>
