---
import ToolShell from '../../components/ToolShell.astro';

const sample = `import { readFile } from 'node:fs/promises';

// Count the words in a file
export async function countWords(path: string): Promise<number> {
  const text = await readFile(path, 'utf8');
  const words = text.split(/\\s+/).filter(Boolean);
  return words.length * 1;
}

console.log(await countWords('README.md'));`;
---

<ToolShell
	slug="code-screenshot"
	title="Code Screenshot"
	description="Turn a code snippet into a clean image with syntax highlighting, window chrome and a gradient background. Export a 2x PNG or copy it to the clipboard."
>
	<section class="panel" id="cs-tool">
		<div class="panel-head">Code</div>
		<textarea id="cs-in" spellcheck="false" aria-label="Code">{sample}</textarea>
	</section>
	<div class="fields">
		<div class="field">
			<label for="cs-lang">Language</label>
			<select id="cs-lang">
				<option value="js">JavaScript / TypeScript</option>
				<option value="py">Python</option>
				<option value="json">JSON</option>
				<option value="css">CSS</option>
				<option value="html">HTML</option>
				<option value="sql">SQL</option>
				<option value="bash">Bash</option>
			</select>
		</div>
		<div class="field">
			<label for="cs-title">Window title</label>
			<input id="cs-title" value="count-words.ts" />
		</div>
		<div class="field">
			<label for="cs-pad">
				Padding <b id="cs-pad-v">48</b> px
			</label>
			<input id="cs-pad" type="range" min="16" max="128" step="8" value="48" />
		</div>
		<div class="field">
			<label for="cs-size">
				Font size <b id="cs-size-v">14</b> px
			</label>
			<input id="cs-size" type="range" min="10" max="24" value="14" />
		</div>
	</div>
	<div class="toolbar">
		<div class="seg" id="cs-theme" role="group" aria-label="Theme">
			<button data-value="dark" aria-pressed="true">
				Dark
			</button>
			<button data-value="light" aria-pressed="false">
				Light
			</button>
		</div>
		<div class="chips" id="cs-bg" role="group" aria-label="Background">
			<button data-value="linear-gradient(135deg, #6366f1, #ec4899)" aria-pressed="true">
				Candy
			</button>
			<button data-value="linear-gradient(135deg, #0ea5e9, #22c55e)" aria-pressed="false">
				Lagoon
			</button>
			<button data-value="linear-gradient(135deg, #f97316, #facc15)" aria-pressed="false">
				Sunset
			</button>
			<button data-value="linear-gradient(135deg, #1e293b, #475569)" aria-pressed="false">
				Slate
			</button>
			<button data-value="#e5e7eb" aria-pressed="false">
				Paper
			</button>
			<button data-value="transparent" aria-pressed="false">
				None
			</button>
		</div>
	</div>
	<div class="cs-stage" tabindex="0" role="region" aria-label="Preview">
		<div class="cs-frame user-colors" id="cs-frame">
			<div class="cs-window" id="cs-window" data-theme="dark">
				<div class="cs-chrome">
					<span class="cs-dot" style="background:#ff5f57"></span>
					<span class="cs-dot" style="background:#febc2e"></span>
					<span class="cs-dot" style="background:#28c840"></span>
					<span class="cs-name" id="cs-name"></span>
				</div>
				<pre class="cs-code" id="cs-code"></pre>
			</div>
		</div>
	</div>
	<div class="toolbar">
		<button class="btn primary" id="cs-png">
			Download PNG
		</button>
		<button class="btn" id="cs-copy">
			Copy image
		</button>
		<span class="cs-status" id="cs-status" role="status"></span>
	</div>
</ToolShell>

<script>
	import { toBlob as nodeToBlob, toPng } from 'html-to-image';
	import { saveBlob } from '../../scripts/files';
	import { byId, onPage, segmented } from '../../scripts/ui';

	const words = (s: string) => new Set(s.split(' '));
	const KEYWORDS: Record<string, Set<string>> = {
		js: words(
			'const let var function return if else for while do break continue switch case default new class extends import export from as async await try catch finally throw typeof instanceof in of this super null undefined true false void yield interface type enum implements public private protected readonly static get set declare keyof',
		),
		py: words(
			'def return if elif else for while break continue class import from as try except finally raise with lambda yield pass in is not and or None True False global nonlocal assert del async await self print',
		),
		json: words('true false null'),
		css: words('important media import supports keyframes font-face root hover focus active before after not is where'),
		sql: words(
			'SELECT FROM WHERE AND OR NOT INSERT INTO VALUES UPDATE SET DELETE CREATE TABLE ALTER DROP INDEX JOIN LEFT RIGHT INNER OUTER FULL ON GROUP BY ORDER HAVING LIMIT OFFSET AS DISTINCT UNION ALL NULL IS IN LIKE BETWEEN CASE WHEN THEN ELSE END PRIMARY KEY FOREIGN REFERENCES DEFAULT COUNT SUM AVG MIN MAX EXISTS WITH RETURNING ASC DESC',
		),
		bash: words('if then else elif fi for while until do done case esac in function return export local readonly echo exit set unset source cd sudo'),
	};

	const RULES: Record<string, [string, RegExp][]> = {
		js: [
			['c', /\/\/[^\n]*|\/\*[\s\S]*?\*\//y],
			['s', /`(?:\\[\s\S]|[^`\\])*`|'(?:\\.|[^'\\\n])*'|"(?:\\.|[^"\\\n])*"/y],
			['n', /\b(?:0x[\da-f]+|\d+(?:\.\d+)?(?:e[+-]?\d+)?)\b/iy],
			['w', /[A-Za-z_$][\w$]*/y],
		],
		py: [
			['c', /#[^\n]*/y],
			['s', /"""[\s\S]*?"""|'''[\s\S]*?'''|[rbfu]?'(?:\\.|[^'\\\n])*'|[rbfu]?"(?:\\.|[^"\\\n])*"/iy],
			['n', /\b\d+(?:\.\d+)?(?:e[+-]?\d+)?\b/iy],
			['w', /[A-Za-z_]\w*/y],
		],
		json: [
			['p', /"(?:\\.|[^"\\\n])*"(?=\s*:)/y],
			['s', /"(?:\\.|[^"\\\n])*"/y],
			['n', /-?\b\d+(?:\.\d+)?(?:e[+-]?\d+)?\b/iy],
			['w', /[a-z]+/y],
		],
		css: [
			['c', /\/\*[\s\S]*?\*\//y],
			['s', /'(?:\\.|[^'\\\n])*'|"(?:\\.|[^"\\\n])*"/y],
			['p', /[\w-]+(?=\s*:[^:])/y],
			['n', /#[\da-f]{3,8}\b|-?\b\d+(?:\.\d+)?(?:px|rem|em|%|vh|vw|s|ms|deg|fr)?\b/iy],
			['w', /[@!]?[A-Za-z-]+/y],
		],
		html: [
			['c', /<!--[\s\S]*?-->/y],
			['k', /<\/?[A-Za-z][\w-]*|\/?>/y],
			['p', /\b[A-Za-z-:]+(?==)/y],
			['s', /"[^"]*"|'[^']*'/y],
		],
		sql: [
			['c', /--[^\n]*|\/\*[\s\S]*?\*\//y],
			['s', /'(?:''|[^'])*'/y],
			['n', /\b\d+(?:\.\d+)?\b/y],
			['w', /[A-Za-z_]\w*/y],
		],
		bash: [
			['c', /#[^\n]*/y],
			['s', /'[^']*'|"(?:\\.|[^"\\])*"/y],
			['p', /\$\{[^}]*\}|\$\w+/y],
			['n', /\b\d+\b/y],
			['w', /[A-Za-z_][\w-]*/y],
		],
	};

	const highlight = (code: string, lang: string) => {
		const rules = RULES[lang];
		const kw = KEYWORDS[lang];
		const out: Node[] = [];
		let plain = '';
		let i = 0;
		const flush = () => {
			if (plain) out.push(document.createTextNode(plain));
			plain = '';
		};
		while (i < code.length) {
			let matched = false;
			for (const [kind, re] of rules) {
				re.lastIndex = i;
				const m = re.exec(code);
				if (!m || !m[0]) continue;
				let cls = kind;
				if (kind === 'w') {
					const key = lang === 'sql' ? m[0].toUpperCase() : m[0].replace(/^[@!]/, '');
					if (kw?.has(key)) cls = 'k';
					else if (code[i + m[0].length] === '(') cls = 'f';
					else cls = '';
				}
				if (cls) {
					flush();
					const span = document.createElement('span');
					span.className = `tk-${cls}`;
					span.textContent = m[0];
					out.push(span);
				} else plain += m[0];
				i += m[0].length;
				matched = true;
				break;
			}
			if (!matched) plain += code[i++];
		}
		flush();
		return out;
	};

	onPage('cs-tool', () => {
		const input = byId<HTMLTextAreaElement>('cs-in');
		const lang = byId<HTMLSelectElement>('cs-lang');
		const title = byId<HTMLInputElement>('cs-title');
		const pad = byId<HTMLInputElement>('cs-pad');
		const size = byId<HTMLInputElement>('cs-size');
		const frame = byId('cs-frame');
		const status = byId('cs-status');
		let background = 'linear-gradient(135deg, #6366f1, #ec4899)';

		const render = () => {
			byId('cs-pad-v').textContent = pad.value;
			byId('cs-size-v').textContent = size.value;
			frame.style.padding = `${pad.value}px`;
			frame.style.background = background;
			byId('cs-code').style.fontSize = `${size.value}px`;
			byId('cs-name').textContent = title.value;
			byId('cs-code').replaceChildren(...highlight(input.value.replace(/\t/g, '  '), lang.value));
		};

		const options = () => ({ pixelRatio: 2, cacheBust: true });
		const say = (t: string) => {
			status.textContent = t;
			setTimeout(() => (status.textContent = ''), 2000);
		};

		const chips = [...byId('cs-bg').querySelectorAll<HTMLButtonElement>('button')];
		chips.forEach((b) => {
			b.addEventListener('click', () => {
				chips.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
				background = b.dataset.value!;
				render();
			});
		});
		segmented(byId('cs-theme'), (v) => (byId('cs-window').dataset.theme = v));
		[input, title, pad, size].forEach((el) => el.addEventListener('input', render));
		lang.addEventListener('change', render);
		byId('cs-png').addEventListener('click', async () => {
			const url = await toPng(frame, options());
			const blob = await (await fetch(url)).blob();
			saveBlob(blob, `${(title.value || 'code').replace(/[^\w.-]+/g, '_')}.png`);
		});
		const copy = byId('cs-copy');
		if (typeof ClipboardItem === 'undefined' || !navigator.clipboard?.write) copy.hidden = true;
		copy.addEventListener('click', async () => {
			try {
				await navigator.clipboard.write([new ClipboardItem({ 'image/png': nodeToBlob(frame, options()).then((b) => b!) })]);
				say('Image copied');
			} catch {
				say('Copy failed. Use Download PNG instead.');
			}
		});
		render();
	});
</script>

<style>
	.field input[type='range'] {
		accent-color: var(--accent-strong);
	}
	.cs-stage {
		overflow: auto;
		border-radius: 14px;
		border: 1px solid var(--border);
		background: var(--surface-2);
		padding: 16px;
		display: flex;
	}
	.cs-frame {
		margin: 0 auto;
		display: inline-block;
		min-width: min(100%, 480px);
		box-sizing: border-box;
	}
	.cs-window {
		border-radius: 12px;
		overflow: hidden;
		box-shadow: 0 20px 50px rgb(0 0 0 / 0.35);
		background: #0f172a;
		color: #e2e8f0;
	}
	.cs-window[data-theme='light'] {
		background: #ffffff;
		color: #1e293b;
	}
	.cs-chrome {
		position: relative;
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 12px 14px;
	}
	.cs-dot {
		width: 12px;
		height: 12px;
		border-radius: 50%;
	}
	.cs-name {
		position: absolute;
		left: 50%;
		transform: translateX(-50%);
		font-family: var(--sans);
		font-size: 12.5px;
		opacity: 0.75;
		white-space: nowrap;
	}
	.cs-code {
		margin: 0;
		padding: 4px 20px 20px;
		font-family: var(--mono);
		line-height: 1.6;
		white-space: pre;
	}
	.cs-code :global(.tk-k) {
		color: #c792ea;
	}
	.cs-code :global(.tk-s) {
		color: #c3e88d;
	}
	.cs-code :global(.tk-n) {
		color: #f78c6c;
	}
	.cs-code :global(.tk-c) {
		color: #8b98b0;
		font-style: italic;
	}
	.cs-code :global(.tk-f) {
		color: #82aaff;
	}
	.cs-code :global(.tk-p) {
		color: #ffcb6b;
	}
	.cs-window[data-theme='light'] :global(.tk-k) {
		color: #7c3aed;
	}
	.cs-window[data-theme='light'] :global(.tk-s) {
		color: #15803d;
	}
	.cs-window[data-theme='light'] :global(.tk-n) {
		color: #c2410c;
	}
	.cs-window[data-theme='light'] :global(.tk-c) {
		color: #64748b;
	}
	.cs-window[data-theme='light'] :global(.tk-f) {
		color: #1d4ed8;
	}
	.cs-window[data-theme='light'] :global(.tk-p) {
		color: #a16207;
	}
	.cs-status {
		font-size: 13px;
		color: var(--ink-soft);
	}
</style>
