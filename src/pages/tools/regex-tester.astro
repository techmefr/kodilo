---
import ToolShell from '../../components/ToolShell.astro';

const flags = [
	['g', 'global'],
	['i', 'ignore case'],
	['m', 'multiline'],
	['s', 'dot all'],
	['u', 'unicode'],
];
---

<ToolShell slug="regex-tester" title="Regex Tester" description="JavaScript regular expressions with live highlighting, capture groups and replace preview.">
	<div class="fields" id="re-tool">
		<div class="field wide" id="re-field">
			<label for="re-pattern">Pattern</label>
			<input id="re-pattern" spellcheck="false" value="(?<user>[\w.+-]+)@(?<domain>[\w-]+(?:\.[\w-]+)+)" />
			<span class="field-note" id="re-note"></span>
		</div>
	</div>
	<div class="toolbar">
		{flags.map(([flag, label]) => (
			<label class="check">
				<input type="checkbox" class="re-flag" value={flag} checked={flag === 'g'} /> <code>{flag}</code> {label}
			</label>
		))}
	</div>
	<div class="grid-2">
		<section class="panel">
			<div class="panel-head">Test text</div>
			<textarea id="re-text" spellcheck="false" aria-label="Test text">Contact jane.doe@example.com or ops+alerts@kodilo.dev.
Not an email: hello@localhost</textarea>
		</section>
		<section class="panel">
			<div class="panel-head">
				<span id="re-count">Matches</span>
			</div>
			<div class="out re-highlight" id="re-highlight"></div>
		</section>
	</div>
	<div class="fields">
		<div class="field wide">
			<label for="re-replace">Replace with ($1, $&lt;name&gt;)</label>
			<input id="re-replace" spellcheck="false" value="$<user> at $<domain>" />
		</div>
	</div>
	<section class="panel">
		<div class="panel-head">
			<span>Replaced</span>
			<button class="btn" id="re-copy">
				Copy
			</button>
		</div>
		<pre class="out re-small" id="re-replaced"></pre>
	</section>
	<section class="panel">
		<div class="panel-head">Match details</div>
		<ol class="re-groups" id="re-groups"></ol>
	</section>
</ToolShell>

<script>
	import { byId, copyButton, onPage } from '../../scripts/ui';

	const LIMIT = 500;

	onPage('re-tool', () => {
		const pattern = byId<HTMLInputElement>('re-pattern');
		const text = byId<HTMLTextAreaElement>('re-text');
		const replace = byId<HTMLInputElement>('re-replace');
		const flagBoxes = Array.from(document.querySelectorAll<HTMLInputElement>('.re-flag'));

		const render = () => {
			const flags = flagBoxes
				.filter((b) => b.checked)
				.map((b) => b.value)
				.join('');
			let re: RegExp;
			try {
				re = new RegExp(pattern.value, flags.includes('g') ? flags : flags + 'g');
				byId('re-field').classList.remove('invalid');
				byId('re-note').textContent = `/${pattern.value}/${flags}`;
			} catch (e) {
				byId('re-field').classList.add('invalid');
				byId('re-note').textContent = (e as Error).message;
				return;
			}
			const matches: RegExpExecArray[] = [];
			if (pattern.value) {
				for (const m of text.value.matchAll(re)) {
					matches.push(m);
					if (!flags.includes('g') || matches.length >= LIMIT) break;
				}
			}
			const highlight = byId('re-highlight');
			const nodes: Node[] = [];
			let last = 0;
			matches.forEach((m, i) => {
				nodes.push(document.createTextNode(text.value.slice(last, m.index)));
				const mark = document.createElement('mark');
				mark.textContent = m[0] || '∅';
				mark.title = `Match ${i + 1}`;
				nodes.push(mark);
				last = m.index + m[0].length;
			});
			nodes.push(document.createTextNode(text.value.slice(last)));
			highlight.replaceChildren(...nodes);
			byId('re-count').textContent = `${matches.length}${matches.length >= LIMIT ? '+' : ''} match${matches.length === 1 ? '' : 'es'}`;

			const replaceRe = new RegExp(pattern.value, flags);
			byId('re-replaced').textContent = pattern.value ? text.value.replace(replaceRe, replace.value) : text.value;

			byId('re-groups').replaceChildren(
				...matches.slice(0, 50).map((m) => {
					const li = document.createElement('li');
					const groups = [
						`“${m[0]}” at ${m.index}`,
						...m.slice(1).map((g, i) => `$${i + 1} = ${g === undefined ? 'undefined' : `“${g}”`}`),
						...Object.entries(m.groups ?? {}).map(([name, g]) => `${name} = “${g}”`),
					];
					li.textContent = groups.join('   ·   ');
					return li;
				}),
			);
		};

		[pattern, text, replace].forEach((el) => el.addEventListener('input', render));
		flagBoxes.forEach((b) => b.addEventListener('change', render));
		copyButton(byId('re-copy'), () => byId('re-replaced').textContent ?? '');
		render();
	});
</script>

<style>
	.check code {
		font-family: var(--mono);
		color: var(--accent-strong);
		font-weight: 700;
	}
	.re-highlight :global(mark) {
		background: var(--accent);
		color: var(--accent-strong);
		border-radius: 4px;
		padding: 0 2px;
		outline: 1px solid var(--accent-strong);
	}
	.re-small {
		min-height: 80px !important;
	}
	.re-groups {
		margin: 0;
		padding: 10px 14px 12px 38px;
		font-family: var(--mono);
		font-size: 12.5px;
		line-height: 1.8;
		overflow-wrap: anywhere;
	}
</style>
