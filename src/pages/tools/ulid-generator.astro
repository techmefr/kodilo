---
import ToolShell from '../../components/ToolShell.astro';
---

<ToolShell slug="ulid-generator" title="ULID Generator" description="Sortable, URL-safe 26-character IDs. Generate them, or paste one to read its timestamp.">
	<div class="toolbar" id="ulid-tool">
		<label class="check">
			Count <input class="num" type="number" id="ulid-count" min="1" max="1000" value="5" />
		</label>
		<label class="check">
			<input type="checkbox" id="ulid-mono" checked /> Monotonic
		</label>
		<label class="check">
			<input type="checkbox" id="ulid-lower" /> Lowercase
		</label>
		<button class="btn primary" id="ulid-regen">
			Regenerate
		</button>
	</div>
	<section class="panel">
		<div class="panel-head">
			<span>ULIDs</span>
			<button class="btn" id="ulid-copy">
				Copy all
			</button>
		</div>
		<pre class="out" id="ulid-out"></pre>
	</section>
	<div class="fields">
		<div class="field wide" id="ulid-decode-field">
			<label for="ulid-decode">Decode a ULID</label>
			<input id="ulid-decode" spellcheck="false" placeholder="01ARZ3NDEKTSV4RRFFQ69G5FAV" />
			<span class="field-note" id="ulid-decode-note"></span>
		</div>
	</div>
</ToolShell>

<script>
	import { byId, copyButton, onPage } from '../../scripts/ui';

	const CROCKFORD = '0123456789ABCDEFGHJKMNPQRSTVWXYZ';

	function encodeTime(ms: number): string {
		let out = '';
		for (let i = 0; i < 10; i++) {
			out = CROCKFORD[ms % 32] + out;
			ms = Math.floor(ms / 32);
		}
		return out;
	}

	function randomPart(): number[] {
		return Array.from(crypto.getRandomValues(new Uint8Array(16)), (b) => b % 32);
	}

	function increment(digits: number[]): number[] {
		const next = [...digits];
		for (let i = next.length - 1; i >= 0; i--) {
			if (next[i] < 31) {
				next[i]++;
				return next;
			}
			next[i] = 0;
		}
		return next;
	}

	onPage('ulid-tool', () => {
		const out = byId('ulid-out');
		const count = byId<HTMLInputElement>('ulid-count');
		const mono = byId<HTMLInputElement>('ulid-mono');
		const lower = byId<HTMLInputElement>('ulid-lower');
		const decode = byId<HTMLInputElement>('ulid-decode');

		const render = () => {
			const n = Math.min(1000, Math.max(1, Number(count.value) || 1));
			const now = Date.now();
			let random = randomPart();
			const ids = Array.from({ length: n }, (_, i) => {
				random = i && mono.checked ? increment(random) : randomPart();
				const id = encodeTime(now) + random.map((d) => CROCKFORD[d]).join('');
				return lower.checked ? id.toLowerCase() : id;
			});
			out.textContent = ids.join('\n');
			if (!decode.value) decode.placeholder = ids[0];
		};

		const readTime = () => {
			const value = decode.value.trim().toUpperCase();
			const field = byId('ulid-decode-field');
			const note = byId('ulid-decode-note');
			if (!value) {
				field.classList.remove('invalid');
				note.textContent = '';
				return;
			}
			if (!/^[0-7][0-9A-HJKMNP-TV-Z]{25}$/.test(value)) {
				field.classList.add('invalid');
				note.textContent = 'A ULID is 26 Crockford base32 characters (no I, L, O or U).';
				return;
			}
			const ms = [...value.slice(0, 10)].reduce((acc, c) => acc * 32 + CROCKFORD.indexOf(c), 0);
			const date = new Date(ms);
			field.classList.remove('invalid');
			note.textContent = `${date.toISOString()} · ${date.toLocaleString()} · ${ms} ms`;
		};

		[count, mono, lower].forEach((el) => el.addEventListener('input', render));
		decode.addEventListener('input', readTime);
		byId('ulid-regen').addEventListener('click', render);
		copyButton(byId('ulid-copy'), () => out.textContent ?? '');
		render();
	});
</script>
