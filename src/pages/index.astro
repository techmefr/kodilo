---
import Base from '../layouts/Base.astro';
import Sidebar from '../components/Sidebar.astro';
---

<Base title="kodilo">
	<div class="shell">
		<Sidebar />
		<main class="main">
			<h1>kodilo</h1>
			<p class="tagline">
				A collection of open-source tools for developers without sign, account.
			</p>
			<p class="hint">Pick a tool in the sidebar to get started.</p>
		</main>
	</div>
</Base>

<style>
	.shell {
		display: flex;
		min-height: 100vh;
	}
	.main {
		flex: 1;
		padding: 40px 32px;
		max-width: 720px;
	}
	h1 {
		margin: 0 0 8px;
		font-size: 28px;
		letter-spacing: -0.01em;
	}
	.tagline {
		color: var(--ink-soft);
		font-size: 15px;
		margin: 0 0 24px;
	}
	.hint {
		color: var(--ink-soft);
		font-size: 13.5px;
	}
</style>
