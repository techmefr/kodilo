---
import Header from '../components/Header.astro';
import ToolGrid from '../components/ToolGrid.astro';
import { builtCategories as categories, categorySlug } from '../data/tools';
import Base from '../layouts/Base.astro';
import { categoryId } from '../scripts/experience';
import { icon, iconUse } from '../scripts/icons';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const total = categories.reduce((a, c) => a + c.tools.length, 0);
---

<Base title="kodilo — Developer tools, no sign-up">
	<div class="shell">
		<Header />
		<main class="home" id="main" tabindex="-1">
			<section class="hero">
				<h1>kodilo</h1>
				<p>{total} open-source tools for developers. No sign-up, no account, nothing leaves your browser.</p>
				<button type="button" class="hero-search" id="hero-search">
					<span set:html={icon('search')} />
					Search a tool
					<kbd>⌘K</kbd>
				</button>
			</section>
			<section class="home-cat home-mine" id="favorites" tabindex="-1" aria-labelledby="favorites-title" hidden>
				<h2 id="favorites-title">
					<span class="home-icon" set:html={icon('star')} />
					Pinned
					<small>Press f on a tool to pin it</small>
				</h2>
				<ul id="favorites-list"></ul>
			</section>
			<section class="home-cat home-mine" id="recents" aria-labelledby="recents-title" hidden>
				<h2 id="recents-title">
					<span class="home-icon" set:html={icon('history')} />
					Recent
				</h2>
				<ul id="recents-list"></ul>
			</section>
			{categories.map((c) => (
				<section class="home-cat" id={categoryId(c.name)}>
					<h2>
						<span class="home-icon" set:html={iconUse(c.icon)} />
						<a class="cat-link" href={`${base}categories/${categorySlug(c.name)}/`}>
							{c.name}
						</a>
						<small>{c.blurb}</small>
					</h2>
					<ToolGrid tools={c.tools} />
				</section>
			))}
		</main>
	</div>
</Base>

<script>
	import { favorites, loadCatalogue, recents, STORE_EVENT, toolCard } from '../scripts/experience';
	import { byId, onPage } from '../scripts/ui';

	onPage('favorites', () => {
		byId('hero-search').addEventListener('click', () => document.getElementById('search-open')?.click());
		const render = async () => {
			const pinned = favorites();
			const recent = recents();
			if (!pinned.length && !recent.length) {
				byId('favorites').hidden = location.hash !== '#favorites';
				byId('recents').hidden = true;
				return;
			}
			let catalogue;
			try {
				catalogue = await loadCatalogue();
			} catch {
				return;
			}
			const bySlug = new Map(catalogue.tools.map((t) => [t.s, t]));
			const fill = (id: string, slugs: string[]) => {
				const entries = slugs.flatMap((s) => bySlug.get(s) ?? []);
				byId(`${id}-list`).replaceChildren(...entries.map((t) => toolCard(t, catalogue.icons)));
				byId(id).hidden = !entries.length;
			};
			fill('favorites', pinned);
			fill('recents', recent);
			if (location.hash === '#favorites') byId('favorites').hidden = false;
			if (location.hash === '#favorites' && document.activeElement === document.body) byId('favorites').focus();
		};
		render();
		window.addEventListener(STORE_EVENT, render);
		document.addEventListener('astro:before-swap', () => window.removeEventListener(STORE_EVENT, render), { once: true });
	});
</script>

<style is:global>
	.shell {
		display: flex;
		min-height: 100vh;
	}
	@media (max-width: 760px) {
		.shell {
			display: block;
		}
	}
	.home {
		flex: 1;
		min-width: 0;
		max-width: 1200px;
		margin: 0 auto;
		padding: 40px 16px 64px;
		display: flex;
		flex-direction: column;
		gap: 36px;
	}
	.hero h1 {
		margin: 0;
		font-size: 40px;
		font-weight: 800;
		letter-spacing: -0.03em;
	}
	.hero p {
		margin: 8px 0 18px;
		font-size: 16px;
		color: var(--ink-soft);
		max-width: 60ch;
	}
	.hero-search {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		width: min(420px, 100%);
		border: 1px solid var(--border);
		background: var(--surface);
		color: var(--ink-soft);
		font: inherit;
		font-size: 15px;
		padding: 11px 14px;
		border-radius: 12px;
		cursor: pointer;
	}
	.hero-search:hover {
		border-color: var(--accent-strong);
	}
	.hero-search kbd {
		margin-left: auto;
		font-family: var(--mono);
		font-size: 11px;
		padding: 1px 6px;
		border: 1px solid var(--border);
		border-radius: 5px;
		background: var(--surface-2);
	}
	.hero-search svg {
		width: 16px;
		height: 16px;
		display: block;
	}
</style>
